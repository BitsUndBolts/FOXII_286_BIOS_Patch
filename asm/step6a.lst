  1756                              <1> post_end:
    18                                  %include "setup.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  Round 6a: the setup of BUBios/286, the boot order and the
     3                              <1> ;  auto-detect switch
     4                              <1> ;
     5                              <1> ;  AMI's setup code still prepares and saves (docs/DEVELOPMENT_LOG.md,
     6                              <1> ;  round 6a): BCA6 builds the stack frame and reads CMOS 10h-3Fh into
     7                              <1> ;  [BP+10h..3Fh]; AMI's page code (BD61-C006) normalises that buffer; at
     8                              <1> ;  C009, where AMI's editing loop began, bu_setup takes over. Every option
     9                              <1> ;  edits AMI's buffer with AMI's encodings. Save: JMP C0A0 (AMI writes
    10                              <1> ;  CMOS 10h-3Fh, the checksum, clears 0Eh/0Fh and restarts). Exit without
    11                              <1> ;  saving: JMP BD4D (AMI's menu exit back to POST).
    12                              <1> ;
    13                              <1> ;  py/build.py patches:
    14                              <1> ;    BCFC  MOV AL,CS:[E058] (the menu)        -> JMP BD61 (the page)
    15                              <1> ;    C009  MOV BX,CA53 / JMP C011             -> JMP bu_setup
    16                              <1> ;    9447  CALL autodet (Step 3)              -> CALL autodet_sw
    17                              <1> ;    8F9B  XOR DX,DX / XOR AX,AX / INT 13h / CALL 9005 (A:) -> CALL boot_seq
    18                              <1> ;
    19                              <1> ;  New settings: CMOS 3Eh, check byte 3Fh = 3Eh XOR A5h (else defaults):
    20                              <1> ;    bits 1-0 boot order (0 A: C:, 1 C: A:, 2 C: only), bit 2 auto-detect
    21                              <1> ;    off, bits 6-4 colour scheme.
    22                              <1> ; =====================================================================
    23                              <1> 
    24                              <1> A_CMOSWR   equ 0xEEAE     ; AL = index, AH = value
    25                              <1> A_SAVE     equ 0xC0A0     ; AMI's save: CMOS from [BP+10h..], checksum, restart
    26                              <1> A_EXIT     equ 0xBD4D     ; AMI's menu exit: cursor, stack frame, RET to POST
    27                              <1> A_UNHOOK   equ 0xD0CF     ; AMI's setup hooks of INT 10h/1Ah/1Ch off (its calendar clock)
    28                              <1> A_READ1    equ 0x9005     ; INT 19h: read sector 1 of DL, head DH, 4 tries (CX = 0: failed)
    29                              <1> A_BOOTGO   equ 0x8FEE     ; INT 19h: jump to 0:7C00
    30                              <1> A_INT19    equ 0x8F80     ; INT 19h from the start
    31                              <1> A_CRLF     equ 0x8D83
    32                              <1> A_PUTS     equ 0x8D75     ; CS:SI teletype
    33                              <1> CM_BUB     equ 0x3E
    34                              <1> CM_CHK     equ 0x3F
    35                              <1> BUB_KEY    equ 0xA5
    36                              <1> 
    37                              <1> ; setup state in AMI's frame (BP; [BP+10h..3Fh] is the CMOS buffer)
    38                              <1> F_TAB      equ 0
    39                              <1> F_FLD      equ 1          ; selected field (index into the table, 0FFh: none)
    40                              <1> F_EDIT     equ 2          ; digits typed so far (0: not typing)
    41                              <1> F_SEC      equ 3          ; RTC second last shown
    42                              <1> F_DIG      equ 4          ; 4..0Dh: the typed digits
    43                              <1> F_MSG      equ 0x0E       ; word: message for the help rows (0: the field's help)
    44                              <1> 
    45                              <1> NTABS      equ 6
    46                              <1> T_CHOICE   equ 1
    47                              <1> T_NUM      equ 2
    48                              <1> T_DATE     equ 3
    49                              <1> T_TIME     equ 4
    50                              <1> T_ACT      equ 5
    51                              <1> T_HDT      equ 6
    52                              <1> T_EMS      equ 7
    53                              <1> F_PARAMC   equ 0x80       ; type flag: a C: type-47 parameter (editable only with type 47)
    54                              <1> F_PARAMD   equ 0x40       ; type flag: a D: type-47 parameter
    55                              <1> 
    56                              <1> R_TABS     equ 1
    57                              <1> R_TOP      equ 3
    58                              <1> R_LINE2    equ 21
    59                              <1> R_HELP     equ 22
    60                              <1> R_KEYS     equ 24
    61                              <1> C_SLBL     equ 3
    62                              <1> C_SVAL     equ 28
    63                              <1> 
    64                              <1> ; ---------------------------------------------------------------------
    65                              <1> ; bub_cfg -> AL = the BUBios settings byte (CMOS 3Eh), 0 if its check
    66                              <1> ; byte (3Fh) does not match. Other registers kept.
    67                              <1> ; ---------------------------------------------------------------------
    68                              <1> bub_cfg:
    69 00000E4A 53                  <1>     push bx
    70 00000E4B B03F                <1>     mov  al, CM_CHK
    71 00000E4D E8(9FEE)            <1>     call A_CMOSRD
    72 00000E50 88C3                <1>     mov  bl, al
    73 00000E52 B03E                <1>     mov  al, CM_BUB
    74 00000E54 E8(9FEE)            <1>     call A_CMOSRD
    75 00000E57 80F3A5              <1>     xor  bl, BUB_KEY
    76 00000E5A 38D8                <1>     cmp  al, bl
    77 00000E5C 7402                <1>     je   .ok
    78 00000E5E 30C0                <1>     xor  al, al
    79 00000E60 5B                  <1> .ok:pop  bx
    80 00000E61 C3                  <1>     ret
    81                              <1> 
    82                              <1> ; ---------------------------------------------------------------------
    83                              <1> ; autodet_sw -- 9447 (checkpoint 75h), in place of Step 3's CALL autodet:
    84                              <1> ; "Auto-Detect Disks at Boot" On -> autodet, Off -> drives12 (no IDENTIFY,
    85                              <1> ; but a configured drive that does not answer is still left out).
    86                              <1> ; Keeps every register except AL, as both of Step 3's entries do.
    87                              <1> ; ---------------------------------------------------------------------
    88                              <1> autodet_sw:
    89 00000E62 50                  <1>     push ax
    90 00000E63 E8E4FF              <1>     call bub_cfg
    91 00000E66 A804                <1>     test al, 4
    92 00000E68 58                  <1>     pop  ax
    93 00000E69 7503                <1>     jnz  .off
    94 00000E6B E9(0000)            <1>     jmp  autodet
    95                              <1> .off:
    96 00000E6E E9(2800)            <1>     jmp  drives12
    97                              <1> 
    98                              <1> ; ---------------------------------------------------------------------
    99                              <1> ; boot_seq -- 8F9B (INT 19h, ES = 0, BX = 7C00h), in place of the A:
   100                              <1> ; attempt (XOR DX,DX / XOR AX,AX / INT 13h / CALL 9005). Returns to
   101                              <1> ; 8F9E (NOPs, then 8FA4: AMI's A: result) like the CALL 9005 it ends with.
   102                              <1> ; ---------------------------------------------------------------------
   103                              <1> boot_seq:
   104 00000E71 E8D6FF              <1>     call bub_cfg
   105 00000E74 2403                <1>     and  al, 3
   106 00000E76 7429                <1>     jz   .a                        ; A: then C: (AMI's own order)
   107 00000E78 50                  <1>     push ax
   108 00000E79 B00E                <1>     mov  al, 0x0E                  ; as AMI's C: path (8FB1): no C: when the
   109 00000E7B E8(9FEE)            <1>     call A_CMOSRD                  ; fixed-disk setup failed in POST
   110 00000E7E A808                <1>     test al, 8
   111 00000E80 751A                <1>     jnz  .cno
   112 00000E82 BA8000              <1>     mov  dx, 0x0080                ; C:, head 0
   113 00000E85 E8(0590)            <1>     call A_READ1
   114 00000E88 E312                <1>     jcxz .cno
   115 00000E8A 7210                <1>     jc   .cno
   116 00000E8C 2681BFFE0155AA      <1>     cmp  word [es:bx + 0x1FE], 0xAA55
   117 00000E93 7507                <1>     jne  .cno
   118 00000E95 58                  <1>     pop  ax
   119 00000E96 83C402              <1>     add  sp, 2                     ; (our return address)
   120 00000E99 E9(EE8F)            <1>     jmp  A_BOOTGO                  ; DL = 80h
   121                              <1> .cno:
   122 00000E9C 58                  <1>     pop  ax
   123 00000E9D 3C02                <1>     cmp  al, 2
   124 00000E9F 7409                <1>     je   .conly
   125 00000EA1 31D2                <1> .a: xor  dx, dx                    ; A:, as the original
   126 00000EA3 31C0                <1>     xor  ax, ax
   127 00000EA5 CD13                <1>     int  0x13
   128 00000EA7 E9(0590)            <1>     jmp  A_READ1
   129                              <1> .conly:                            ; C: only and C: did not boot: say so,
   130 00000EAA 83C402              <1>     add  sp, 2                     ; wait for a key, INT 19h again
   131 00000EAD FB                  <1>     sti
   132 00000EAE E8(838D)            <1>     call A_CRLF
   133 00000EB1 BE[CA0E]            <1>     mov  si, s_conly
   134 00000EB4 E8(758D)            <1>     call A_PUTS
