  1292                              <1> ; measurements and probes
  1293                              <1> ; =====================================================================
  1294                              <1> ; measure_clock -> [ST_MHZ]: 250 passes of 32 x DIV BX + LOOP, built at
  1295                              <1> ; 0:7C00 (RAM: the ROM has wait states) and timed by PIT channel 2.
  1296                              <1> ; 80286: DIV r16 22 clocks, LOOP 8 + the queue refill (2 bytes): 714 per
  1297                              <1> ; pass. Shown only within 1/16 of a standard clock.
  1298                              <1> measure_clock:
  1299 00000899 06                  <1>     push es
  1300 0000089A 6A00                <1>     push 0
  1301 0000089C 07                  <1>     pop  es
  1302 0000089D BF007C              <1>     mov  di, TLOOP
  1303 000008A0 BE[3509]            <1>     mov  si, tl_head
  1304 000008A3 B90B00              <1>     mov  cx, tl_head_end - tl_head
  1305 000008A6 F32EA4              <1>     rep  cs movsb
  1306 000008A9 B8F7F3              <1>     mov  ax, 0xF3F7                ; 32 x DIV BX
  1307 000008AC B92000              <1>     mov  cx, 32
  1308 000008AF F3AB                <1>     rep  stosw
  1309 000008B1 B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV (-66)
  1310 000008B4 AB                  <1>     stosw
  1311 000008B5 B0CB                <1>     mov  al, 0xCB                  ; RETF
  1312 000008B7 AA                  <1>     stosb
  1313 000008B8 07                  <1>     pop  es
