  2014                              <1> post_end:
    18                                  %include "setup.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  Round 6a: the setup of BUBios/286, the boot order and the
     3                              <1> ;  auto-detect switch
     4                              <1> ;
     5                              <1> ;  AMI's setup code still prepares and saves (docs/DEVELOPMENT_LOG.md,
     6                              <1> ;  round 6a): BCA6 builds the stack frame and reads CMOS 10h-3Fh into
     7                              <1> ;  [BP+10h..3Fh]; AMI's page code (BD61-C006) normalises that buffer; at
     8                              <1> ;  C009, where AMI's editing loop began, bu_setup takes over. Every option
     9                              <1> ;  edits AMI's buffer with AMI's encodings. Save: JMP C0A0 (AMI writes
    10                              <1> ;  CMOS 10h-3Fh, the checksum, clears 0Eh/0Fh and restarts). Exit without
    11                              <1> ;  saving: JMP BD4D (AMI's menu exit back to POST).
    12                              <1> ;
    13                              <1> ;  py/build.py patches:
    14                              <1> ;    BCFC  MOV AL,CS:[E058] (the menu)        -> JMP BD61 (the page)
    15                              <1> ;    C009  MOV BX,CA53 / JMP C011             -> JMP bu_setup
    16                              <1> ;    9447  CALL autodet (Step 3)              -> CALL autodet_sw
    17                              <1> ;    8F9B  XOR DX,DX / XOR AX,AX / INT 13h / CALL 9005 (A:) -> CALL boot_seq
    18                              <1> ;
    19                              <1> ;  New settings: CMOS 3Eh, check byte 3Fh = 3Eh XOR A5h (else defaults):
    20                              <1> ;    bits 1-0 boot order (0 A: C:, 1 C: A:, 2 C: only), bit 2 auto-detect
    21                              <1> ;    off, bits 6-4 colour scheme.
    22                              <1> ; =====================================================================
    23                              <1> 
    24                              <1> A_CMOSWR   equ 0xEEAE     ; AL = index, AH = value
    25                              <1> A_SAVE     equ 0xC0A0     ; AMI's save: CMOS from [BP+10h..], checksum, restart
    26                              <1> A_EXIT     equ 0xBD4D     ; AMI's menu exit: cursor, stack frame, RET to POST
    27                              <1> A_UNHOOK   equ 0xD0CF     ; AMI's setup hooks of INT 10h/1Ah/1Ch off (its calendar clock)
    28                              <1> A_READ1    equ 0x9005     ; INT 19h: read sector 1 of DL, head DH, 4 tries (CX = 0: failed)
    29                              <1> A_BOOTGO   equ 0x8FEE     ; INT 19h: jump to 0:7C00
    30                              <1> A_INT19    equ 0x8F80     ; INT 19h from the start
    31                              <1> A_CRLF     equ 0x8D83
    32                              <1> A_PUTS     equ 0x8D75     ; CS:SI teletype
    33                              <1> CM_BUB     equ 0x3E
    34                              <1> CM_CHK     equ 0x3F
    35                              <1> BUB_KEY    equ 0xA5
    36                              <1> 
    37                              <1> ; setup state in AMI's frame (BP; [BP+10h..3Fh] is the CMOS buffer)
    38                              <1> F_TAB      equ 0
    39                              <1> F_FLD      equ 1          ; selected field (index into the table, 0FFh: none)
    40                              <1> F_EDIT     equ 2          ; digits typed so far (0: not typing)
    41                              <1> F_SEC      equ 3          ; RTC second last shown
    42                              <1> F_DIG      equ 4          ; 4..0Dh: the typed digits
    43                              <1> F_MSG      equ 0x0E       ; word: message for the help rows (0: the field's help)
    44                              <1> 
    45                              <1> NTABS      equ 6
    46                              <1> T_CHOICE   equ 1
    47                              <1> T_NUM      equ 2
    48                              <1> T_DATE     equ 3
    49                              <1> T_TIME     equ 4
    50                              <1> T_ACT      equ 5
    51                              <1> T_HDT      equ 6
    52                              <1> T_EMS      equ 7
    53                              <1> F_PARAMC   equ 0x80       ; type flag: a C: type-47 parameter (editable only with type 47)
    54                              <1> F_PARAMD   equ 0x40       ; type flag: a D: type-47 parameter
    55                              <1> F_MIN1     equ 0x20       ; type flag: the number is at least 1
    56                              <1> 
    57                              <1> R_TABS     equ 1
    58                              <1> R_TOP      equ 3
    59                              <1> R_LINE2    equ 21
    60                              <1> R_HELP     equ 22
    61                              <1> R_KEYS     equ 24
    62                              <1> C_SLBL     equ 3
    63                              <1> C_SVAL     equ 28
    64                              <1> 
    65                              <1> ; ---------------------------------------------------------------------
    66                              <1> ; bub_cfg -> AL = the BUBios settings byte (CMOS 3Eh), 0 if its check
    67                              <1> ; byte (3Fh) does not match. Other registers kept.
    68                              <1> ; ---------------------------------------------------------------------
    69                              <1> bub_cfg:
    70 00001066 53                  <1>     push bx
    71 00001067 B03F                <1>     mov  al, CM_CHK
    72 00001069 E8(9FEE)            <1>     call A_CMOSRD
    73 0000106C 88C3                <1>     mov  bl, al
    74 0000106E B03E                <1>     mov  al, CM_BUB
    75 00001070 E8(9FEE)            <1>     call A_CMOSRD
    76 00001073 80F3A5              <1>     xor  bl, BUB_KEY
    77 00001076 38D8                <1>     cmp  al, bl
    78 00001078 7402                <1>     je   .ok
    79 0000107A 30C0                <1>     xor  al, al
    80 0000107C 5B                  <1> .ok:pop  bx
    81 0000107D C3                  <1>     ret
    82                              <1> 
    83                              <1> ; ---------------------------------------------------------------------
    84                              <1> ; autodet_sw -- 9447 (checkpoint 75h), in place of Step 3's CALL autodet:
    85                              <1> ; "Auto-Detect Disks at Boot" On -> autodet, Off -> drives12 (no IDENTIFY,
    86                              <1> ; but a configured drive that does not answer is still left out).
    87                              <1> ; Keeps every register except AL, as both of Step 3's entries do.
    88                              <1> ; ---------------------------------------------------------------------
    89                              <1> autodet_sw:
    90 0000107E 50                  <1>     push ax
    91 0000107F E8E4FF              <1>     call bub_cfg
    92 00001082 A804                <1>     test al, 4
    93 00001084 58                  <1>     pop  ax
    94 00001085 7506                <1>     jnz  .off
    95 00001087 E8(0000)            <1>     call autodet                   ; AL = CMOS 12h, the only result 944C uses
    96 0000108A E9B2F1              <1>     jmp  adet_drawn                ; the POST screen's disk rows at once
    97                              <1> .off:
    98 0000108D E9(2800)            <1>     jmp  drives12
    99                              <1> 
   100                              <1> ; ---------------------------------------------------------------------
   101                              <1> ; boot_seq -- 8F9B (INT 19h, ES = 0, BX = 7C00h), in place of the A:
   102                              <1> ; attempt (XOR DX,DX / XOR AX,AX / INT 13h / CALL 9005). Returns to
   103                              <1> ; 8F9E (NOPs, then 8FA4: AMI's A: result) like the CALL 9005 it ends with.
   104                              <1> ; ---------------------------------------------------------------------
   105                              <1> boot_seq:
   106 00001090 E8D3FF              <1>     call bub_cfg
   107 00001093 2403                <1>     and  al, 3
   108 00001095 7429                <1>     jz   .a                        ; A: then C: (AMI's own order)
   109 00001097 50                  <1>     push ax
   110 00001098 B00E                <1>     mov  al, 0x0E                  ; as AMI's C: path (8FB1): no C: when the
   111 0000109A E8(9FEE)            <1>     call A_CMOSRD                  ; fixed-disk setup failed in POST
   112 0000109D A808                <1>     test al, 8
   113 0000109F 751A                <1>     jnz  .cno
   114 000010A1 BA8000              <1>     mov  dx, 0x0080                ; C:, head 0
   115 000010A4 E8(0590)            <1>     call A_READ1
   116 000010A7 E312                <1>     jcxz .cno
   117 000010A9 7210                <1>     jc   .cno
   118 000010AB 2681BFFE0155AA      <1>     cmp  word [es:bx + 0x1FE], 0xAA55
   119 000010B2 7507                <1>     jne  .cno
   120 000010B4 58                  <1>     pop  ax
   121 000010B5 83C402              <1>     add  sp, 2                     ; (our return address)
   122 000010B8 E9(EE8F)            <1>     jmp  A_BOOTGO                  ; DL = 80h
   123                              <1> .cno:
   124 000010BB 58                  <1>     pop  ax
   125 000010BC 3C02                <1>     cmp  al, 2
   126 000010BE 7409                <1>     je   .conly
   127 000010C0 31D2                <1> .a: xor  dx, dx                    ; A:, as the original
   128 000010C2 31C0                <1>     xor  ax, ax
   129 000010C4 CD13                <1>     int  0x13
   130 000010C6 E9(0590)            <1>     jmp  A_READ1
   131                              <1> .conly:                            ; C: only and C: did not boot: say so,
   132 000010C9 83C402              <1>     add  sp, 2                     ; wait for a key, INT 19h again
   133 000010CC FB                  <1>     sti
   134 000010CD E8(838D)            <1>     call A_CRLF
   135 000010D0 BE[E910]            <1>     mov  si, s_conly
   136 000010D3 E8(758D)            <1>     call A_PUTS
   137 000010D6 E8(838D)            <1>     call A_CRLF
   138 000010D9 BE[2111]            <1>     mov  si, s_anykey
   139 000010DC E8(758D)            <1>     call A_PUTS
   140 000010DF 30E4                <1>     xor  ah, ah
   141 000010E1 CD16                <1>     int  0x16
   142 000010E3 E8(838D)            <1>     call A_CRLF
   143 000010E6 E9(808F)            <1>     jmp  A_INT19
   144                              <1> 
   145 000010E9 20204E6F20626F6F74- <1> s_conly:    db "  No boot sector on C: (boot order: C: only, see Setup)", 0
   145 000010F2 20736563746F72206F- <1>
   145 000010FB 6E20433A2028626F6F- <1>
   145 00001104 74206F726465723A20- <1>
   145 0000110D 433A206F6E6C792C20- <1>
   145 00001116 736565205365747570- <1>
   145 0000111F 2900                <1>
   146 00001121 202050726573732061- <1> s_anykey:   db "  Press any key to try again ", 0
   146 0000112A 6E79206B657920746F- <1>
   146 00001133 207472792061676169- <1>
   146 0000113C 6E2000              <1>
   147                              <1> 
   148                              <1> ; =====================================================================
   149                              <1> ; bu_setup -- C009: AMI's page has filled and normalised its buffer
   150                              <1> ; =====================================================================
   151                              <1> bu_setup:
   152 0000113F FC                  <1>     cld
   153 00001140 E8(CFD0)            <1>     call A_UNHOOK                  ; AMI's calendar clock and video hooks off
   154 00001143 B00B                <1>     mov  al, 0x0B                  ; and the RTC running again (AMI's page
   155 00001145 E8(9FEE)            <1>     call A_CMOSRD                  ; set the SET bit, 0Bh = 82h)
   156 00001148 247F                <1>     and  al, 0x7F
   157 0000114A 88C4                <1>     mov  ah, al
   158 0000114C B00B                <1>     mov  al, 0x0B
   159 0000114E E8(AEEE)            <1>     call A_CMOSWR
   160 00001151 FB                  <1>     sti
   161 00001152 6A40                <1>     push 0x40
   162 00001154 1F                  <1>     pop  ds
   163 00001155 31C0                <1>     xor  ax, ax
   164 00001157 884600              <1>     mov  [bp + F_TAB], al          ; Summary first
   165 0000115A 884602              <1>     mov  [bp + F_EDIT], al
   166 0000115D 89460E              <1>     mov  [bp + F_MSG], ax
   167 00001160 C64601FF            <1>     mov  byte [bp + F_FLD], 0xFF
   168 00001164 C64603FF            <1>     mov  byte [bp + F_SEC], 0xFF
   169 00001168 E86408              <1>     call s_redraw
   170 0000116B B001                <1>     mov  al, 1                     ; the display on again (setup_dark), with
   171 0000116D E81D00              <1>     call v_screen                  ; the Summary page already drawn
   172                              <1> .loop:
   173 00001170 E88A04              <1>     call s_tick
   174 00001173 B401                <1>     mov  ah, 1
   175 00001175 CD16                <1>     int  0x16
   176 00001177 74F7                <1>     jz   .loop
   177 00001179 30E4                <1>     xor  ah, ah
   178 0000117B CD16                <1>     int  0x16
   179 0000117D E84F00              <1>     call s_key
   180 00001180 EBEE                <1>     jmp  short .loop
   181                              <1> 
   182                              <1> ; ---------------------------------------------------------------------
   183                              <1> ; setup_dark -- BD69, right after the mode set of AMI's page code (BD61).
   184                              <1> ; AMI's page code draws its whole page before C009 (bu_setup); on the
   185                              <1> ; board it showed for a moment. The display is switched off here and on
   186                              <1> ; again in bu_setup once the Summary page is drawn. Replaces CLI / CLD /
   187                              <1> ; MOV AX,268Ah (AX is AMI's next CMOS write); other registers kept.
   188                              <1> ; ---------------------------------------------------------------------
   189                              <1> setup_dark:
   190 00001182 30C0                <1>     xor  al, al
   191 00001184 E80600              <1>     call v_screen
   192 00001187 FA                  <1>     cli
   193 00001188 FC                  <1>     cld
   194 00001189 B88A26              <1>     mov  ax, 0x268A
   195 0000118C C3                  <1>     ret
   196                              <1> 
   197                              <1> ; ---------------------------------------------------------------------
   198                              <1> ; v_screen -- the display off (AL = 0) or on (AL <> 0); all registers
   199                              <1> ; kept. VGA (INT 10h AX=1A00h answers 1Ah): sequencer register 1 bit 5
   200                              <1> ; (Screen Off; a mode set clears it). MDA / CGA: the mode control
   201                              <1> ; register (3B8h / 3D8h) bit 3 (video enable), from the BIOS's copy of
   202                              <1> ; it at 40:65. An EGA ignores 3D8h, so there the page still shows.
   203                              <1> ; ---------------------------------------------------------------------
   204                              <1> v_screen:
   205 0000118D 50                  <1>     push ax
   206 0000118E 53                  <1>     push bx
   207 0000118F 52                  <1>     push dx
   208 00001190 1E                  <1>     push ds
   209 00001191 50                  <1>     push ax
   210 00001192 B8001A              <1>     mov  ax, 0x1A00
   211 00001195 CD10                <1>     int  0x10
   212 00001197 5B                  <1>     pop  bx                        ; BL = AL on entry
   213 00001198 3C1A                <1>     cmp  al, 0x1A
   214 0000119A 7513                <1>     jne  .mc
   215 0000119C BAC403              <1>     mov  dx, 0x3C4
   216 0000119F B001                <1>     mov  al, 1
   217 000011A1 EE                  <1>     out  dx, al
   218 000011A2 42                  <1>     inc  dx
   219 000011A3 EC                  <1>     in   al, dx
   220 000011A4 0C20                <1>     or   al, 0x20                  ; Screen Off
   221 000011A6 84DB                <1>     test bl, bl
   222 000011A8 7402                <1>     jz   .vga
   223 000011AA 24DF                <1>     and  al, 0xDF                  ; Screen On
   224                              <1> .vga:
   225 000011AC EE                  <1>     out  dx, al
