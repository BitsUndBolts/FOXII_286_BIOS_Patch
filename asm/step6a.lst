   262 000000F4 7514                <1>     jne  .out
   263                              <1> %ifdef ROUND6A
   264 000000F6 F606FB0008          <1>     test byte [ST_MISC], M_DEL     ; once DEL is seen the status stays
   265 000000FB 7403                <1>     jz   .s
   266 000000FD BE[1C0F]            <1>     mov  si, s_st_setup
