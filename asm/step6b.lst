  2163                              <1> setup_end:
    21                                  %include "tools.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  Round 6b: the tools of BUBios/286 (setup's Tools page)
     3                              <1> ;
     4                              <1> ;  Each tool is an action on the Tools page (setup.asm, fields): it draws
     5                              <1> ;  its own page over rows 3-23, runs, waits for ESC (or Enter where the
     6                              <1> ;  key row offers it) and returns; s_key then redraws the Tools page.
     7                              <1> ;
     8                              <1> ;    t_info    Hard disk C:/D: info and auto-detect (IDENTIFY DEVICE)
     9                              <1> ;    t_part    Partition check (MBR, extended chain, each FAT BPB) against
    10                              <1> ;              the geometry the BIOS gives DOS (INT 13h AH=08h)
    11                              <1> ;    t_speed   Disk speed through INT 13h (read at start / middle / end,
    12                              <1> ;              access time)
    13                              <1> ;    t_mem     Memory test: base 64-640 KB, extended (INT 15h AH=87h),
    14                              <1> ;              the EMS pages through the HT12's window 0
    15                              <1> ;    t_umb     HT12UMB.SYS in this ROM (F000:6000) and the DEBUG recipe
    16                              <1> ;  and, for the POST screen (post.asm, bu_final):
    17                              <1> ;    part_post one warning line when C:'s partitions do not fit the BIOS
    18                              <1> ;
    19                              <1> ;  Runs in setup (DS = 40h, ES = the text buffer, BP = AMI's setup frame
    20                              <1> ;  with the CMOS buffer at [BP+10h..3Fh]) or at the end of POST (DS = 40h).
    21                              <1> ;  Memory the tools use, all free while setup runs (POST has cleared
    22                              <1> ;  0:0500-7BFF; DOS is not loaded):
    23                              <1> ;    0:1000-8FFF   disk and test buffers (TBUF, 32 KB)
    24                              <1> ;    0:9000-902F   the GDT for INT 15h AH=87h (TGDT)
    25                              <1> ;    0:9040-90FF   variables (40:8C40-, so they are reached with DS = 40h)
    26                              <1> ;  Not 0:F000-102FF: setup's stack is 0030:0100, and AMI's setup frame
    27                              <1> ;  takes it below 0030:0000, so SP wraps to 0030:FCxx (0:FFxx-102FF).
    28                              <1> ;  The base memory test starts at 68 KB, above all of them.
    29                              <1> ; =====================================================================
    30                              <1> 
    31                              <1> TGDT       equ 0x0900     ; segment of the INT 15h AH=87h GDT (0:9000)
    32                              <1> TBUF       equ 0x0100     ; segment of the buffers (0:1000-8FFF)
    33                              <1> TV         equ 0x8C40     ; variables, DS = 40h (0:9040)
    34                              <1> M_BASE0    equ 68         ; KB: where the base memory test starts
    35                              <1> V_C        equ TV + 0     ; word: cylinders the BIOS gives DOS (INT 13h AH=08h)
    36                              <1> V_H        equ TV + 2     ; word: heads
    37                              <1> V_S        equ TV + 4     ; word: sectors per track
    38                              <1> V_DRV      equ TV + 6     ; byte: 80h / 81h
    39                              <1> V_ROW      equ TV + 7     ; byte: next row of a list
    40                              <1> V_BAD      equ TV + 8     ; byte: mismatches found (partition check)
    41                              <1> V_MH       equ TV + 9     ; byte: heads the partitions were made with
    42                              <1> V_MS       equ TV + 10    ; byte: sectors per track they were made with
    43                              <1> V_NUM      equ TV + 11    ; byte: partition number shown
    44                              <1> V_EXT      equ TV + 12    ; dword: LBA of the extended partition
    45                              <1> V_EBR      equ TV + 16    ; dword: LBA of the current EBR
    46                              <1> V_P        equ TV + 20    ; dword: partition start (absolute LBA)
    47                              <1> V_N        equ TV + 24    ; dword: partition size
    48                              <1> V_T0       equ TV + 28    ; word: timer tick at the start
    49                              <1> V_CNT      equ TV + 30    ; word: sectors / operations counted
    50                              <1> V_CYL      equ TV + 32    ; word
    51                              <1> V_HD       equ TV + 34    ; word
    52                              <1> V_RND      equ TV + 36    ; word: random number
    53                              <1> V_ERR      equ TV + 38    ; dword: errors (memory test)
    54                              <1> V_PAT      equ TV + 42    ; byte: pattern number
    55                              <1> V_FR       equ TV + 43    ; byte: EMS frame position 0-7 (0FFh: none)
    56                              <1> V_E19      equ TV + 44    ; byte: HT12 reg 19h before the test
    57                              <1> V_E20      equ TV + 45    ; byte: HT12 reg 20h before the test
    58                              <1> V_PG       equ TV + 46    ; word: first EMS page
    59                              <1> V_NPG      equ TV + 48    ; word: EMS pages
    60                              <1> V_FAIL     equ TV + 50    ; 3 words: first error: segment, offset, XOR (bits)
    61                              <1> V_FAILW    equ TV + 56    ; word: what was written there
    62                              <1> V_LIN      equ TV + 58    ; dword: linear address of the first error
    63                              <1> V_STOP     equ TV + 62    ; byte: ESC pressed
    64                              <1> V_KB       equ TV + 64    ; word: KB of the area being tested
    65                              <1> V_END      equ TV + 66    ; word: end segment / KB
    66                              <1> 
    67                              <1> C_TV       equ 20         ; value column of a tool page
    68                              <1> R_T1       equ 5          ; first row of a tool's content
    69                              <1> T_SECS     equ 36         ; 2 s of timer ticks for each speed measurement
    70                              <1> 
    71                              <1> ; ---------------------------------------------------------------------
    72                              <1> ; the Tools page's actions (setup.asm, fields, ROUND6B)
    73                              <1> ; ---------------------------------------------------------------------
    74 00002F80 B300                <1> tl_infoc:  mov  bl, 0
    75 00002F82 E9FC01              <1>            jmp  t_info
    76 00002F85 B301                <1> tl_infod:  mov  bl, 1
    77 00002F87 E9F701              <1>            jmp  t_info
    78 00002F8A B300                <1> tl_partc:  mov  bl, 0
    79 00002F8C E92F05              <1>            jmp  t_part
    80 00002F8F B301                <1> tl_partd:  mov  bl, 1
    81 00002F91 E92A05              <1>            jmp  t_part
    82 00002F94 B300                <1> tl_speedc: mov  bl, 0
    83 00002F96 E9DD0A              <1>            jmp  t_speed
    84 00002F99 B301                <1> tl_speedd: mov  bl, 1
    85 00002F9B E9D80A              <1>            jmp  t_speed
    86 00002F9E E9210D              <1> tl_mem:    jmp  t_mem
    87 00002FA1 E9E111              <1> tl_umb:    jmp  t_umb
    88                              <1> 
    89                              <1> ; =====================================================================
    90                              <1> ; page helpers
    91                              <1> ; =====================================================================
    92                              <1> ; t_open: SI = title, BX = key row text. Clears rows 3-23, draws the
    93                              <1> ; title in the accent colour and the key row.
    94                              <1> t_open:
    95 00002FA4 53                  <1>     push bx
    96 00002FA5 56                  <1>     push si
    97 00002FA6 E8FFEB              <1>     call vid_es_s
    98 00002FA9 BA0003              <1>     mov  dx, POS(R_TOP, 0)
    99 00002FAC B9A005              <1>     mov  cx, 80 * (R_LINE2 - R_TOP)
