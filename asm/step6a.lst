   203                              <1> ; =====================================================================
   204                              <1> ; bu_mem -- ACDB, after each 64 KB block (AX = blocks counted, 1 first).
   205                              <1> ; Replaces AMI's "nnnnn KB OK" print. Keeps every register.
   206                              <1> ; =====================================================================
   207                              <1> bu_mem:
   208 000000A4 60                  <1>     pusha
   209 000000A5 1E                  <1>     push ds
   210 000000A6 06                  <1>     push es
   211 000000A7 6A40                <1>     push 0x40
   212 000000A9 1F                  <1>     pop  ds
   213 000000AA FC                  <1>     cld
   214 000000AB 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   215 000000B0 751C                <1>     jne  .out
   216 000000B2 A3F200              <1>     mov  [ST_UNITS], ax
   217 000000B5 3B06F400            <1>     cmp  ax, [ST_TOTAL]
   218 000000B9 7603                <1>     jbe  .d
   219 000000BB A3F400              <1>     mov  [ST_TOTAL], ax
   220 000000BE E8BC0A              <1> .d: call vid_es
