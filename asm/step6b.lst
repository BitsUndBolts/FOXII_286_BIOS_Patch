    75 00003074 E9FC01              <1>            jmp  t_info
    76 00003077 B301                <1> tl_infod:  mov  bl, 1
    77 00003079 E9F701              <1>            jmp  t_info
    78 0000307C B300                <1> tl_partc:  mov  bl, 0
    79 0000307E E92F05              <1>            jmp  t_part
    80 00003081 B301                <1> tl_partd:  mov  bl, 1
    81 00003083 E92A05              <1>            jmp  t_part
    82 00003086 B300                <1> tl_speedc: mov  bl, 0
    83 00003088 E9DD0A              <1>            jmp  t_speed
    84 0000308B B301                <1> tl_speedd: mov  bl, 1
    85 0000308D E9D80A              <1>            jmp  t_speed
    86 00003090 E9210D              <1> tl_mem:    jmp  t_mem
    87 00003093 E9E111              <1> tl_umb:    jmp  t_umb
