  1303                              <1> ; measurements and probes
  1304                              <1> ; =====================================================================
  1305                              <1> ; measure_clock -> [ST_MHZ]: 250 passes of 32 x DIV BX + LOOP, built at
  1306                              <1> ; 0:7C00 (RAM: the ROM has wait states) and timed by PIT channel 2.
  1307                              <1> ; 80286: DIV r16 22 clocks, LOOP 8 + the queue refill (2 bytes): 714 per
  1308                              <1> ; pass. Shown only within 1/16 of a standard clock.
  1309                              <1> measure_clock:
  1310 000008AA 06                  <1>     push es
  1311 000008AB 6A00                <1>     push 0
  1312 000008AD 07                  <1>     pop  es
  1313 000008AE BF007C              <1>     mov  di, TLOOP
  1314 000008B1 BE[4609]            <1>     mov  si, tl_head
