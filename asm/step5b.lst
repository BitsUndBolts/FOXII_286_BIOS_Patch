  1158 0000079E B2F7                <1>     mov  dl, 0xF7
  1159 000007A0 EC                  <1>     in   al, dx
  1160 000007A1 BD0000              <1>     mov  bp, D_NONE
  1161 000007A4 3CFF                <1>     cmp  al, 0xFF                  ; nothing on the bus
  1162 000007A6 7503E9B500          <1>     je   .end
  1163 000007AB 3C7F                <1>     cmp  al, 0x7F
  1164 000007AD 7503E9AE00          <1>     je   .end
  1165 000007B2 08C0                <1>     or   al, al                    ; a master answering for a missing slave
  1166 000007B4 7503E9A700          <1>     jz   .end
  1167                              <1>     ; wait up to CX ms (0: no wait) for BSY = 0 and DRDY = 1
  1168 000007B9 BD0200              <1>     mov  bp, D_BUSY
