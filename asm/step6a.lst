  1855 00000A6F E661                <1>     out  0x61, al
  1856 00000A71 9A007C0000          <1>     call 0:TLOOP
  1857 00000A76 B080                <1>     mov  al, 0x80                  ; latch channel 2
  1858 00000A78 E643                <1>     out  0x43, al
  1859 00000A7A E442                <1>     in   al, 0x42
  1860 00000A7C 88C4                <1>     mov  ah, al
  1861 00000A7E E442                <1>     in   al, 0x42
  1862 00000A80 86C4                <1>     xchg al, ah
  1863 00000A82 F7D0                <1>     not  ax                        ; elapsed ticks
  1864 00000A84 91                  <1>     xchg ax, cx
  1865 00000A85 58                  <1>     pop  ax
  1866 00000A86 E661                <1>     out  0x61, al
  1867 00000A88 9D                  <1>     popf
  1868 00000A89 C606FA0000          <1>     mov  byte [ST_MHZ], 0
  1869 00000A8E E336                <1>     jcxz .r
  1870 00000A90 B8A67F              <1>     mov  ax, CLOCK_K & 0xFFFF
  1871 00000A93 BA2000              <1>     mov  dx, CLOCK_K >> 16
