  1760                              <1> ; measurements and probes
  1761                              <1> ; =====================================================================
  1762                              <1> ; measure_clock -> [ST_MHZ]: 250 passes of 32 x DIV BX + LOOP, built at
  1763                              <1> ; 0:7C00 (RAM: the ROM has wait states) and timed by PIT channel 2.
  1764                              <1> ; 80286: DIV r16 22 clocks, LOOP 8 + the queue refill (2 bytes): 714 per
  1765                              <1> ; pass. Shown only within 1/16 of a standard clock.
  1766                              <1> measure_clock:
  1767 00000887 06                  <1>     push es
  1768 00000888 6A00                <1>     push 0
  1769 0000088A 07                  <1>     pop  es
  1770 0000088B BF007C              <1>     mov  di, TLOOP
  1771 0000088E BE[2309]            <1>     mov  si, tl_head
  1772 00000891 B90B00              <1>     mov  cx, tl_head_end - tl_head
  1773 00000894 F32EA4              <1>     rep  cs movsb
  1774 00000897 B8F7F3              <1>     mov  ax, 0xF3F7                ; 32 x DIV BX
  1775 0000089A B92000              <1>     mov  cx, 32
  1776 0000089D F3AB                <1>     rep  stosw
  1777 0000089F B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV (-66)
  1778 000008A2 AB                  <1>     stosw
  1779 000008A3 B0CB                <1>     mov  al, 0xCB                  ; RETF
  1780 000008A5 AA                  <1>     stosb
  1781 000008A6 07                  <1>     pop  es
  1782 000008A7 9C                  <1>     pushf
  1783 000008A8 FA                  <1>     cli
  1784 000008A9 E461                <1>     in   al, 0x61
  1785 000008AB 50                  <1>     push ax
  1786 000008AC 24FC                <1>     and  al, 0xFC
  1787 000008AE E661                <1>     out  0x61, al
  1788 000008B0 B0B0                <1>     mov  al, 0xB0                  ; channel 2, mode 0, 16 bits
  1789 000008B2 E643                <1>     out  0x43, al
  1790 000008B4 B0FF                <1>     mov  al, 0xFF
  1791 000008B6 E642                <1>     out  0x42, al
  1792 000008B8 E642                <1>     out  0x42, al
  1793 000008BA E461                <1>     in   al, 0x61
  1794 000008BC 0C01                <1>     or   al, 1                     ; gate on, speaker off
  1795 000008BE E661                <1>     out  0x61, al
  1796 000008C0 9A007C0000          <1>     call 0:TLOOP
  1797 000008C5 B080                <1>     mov  al, 0x80                  ; latch channel 2
  1798 000008C7 E643                <1>     out  0x43, al
  1799 000008C9 E442                <1>     in   al, 0x42
  1800 000008CB 88C4                <1>     mov  ah, al
  1801 000008CD E442                <1>     in   al, 0x42
  1802 000008CF 86C4                <1>     xchg al, ah
  1803 000008D1 F7D0                <1>     not  ax                        ; elapsed ticks
  1804 000008D3 91                  <1>     xchg ax, cx
  1805 000008D4 58                  <1>     pop  ax
  1806 000008D5 E661                <1>     out  0x61, al
  1807 000008D7 9D                  <1>     popf
  1808 000008D8 C606FA0000          <1>     mov  byte [ST_MHZ], 0
  1809 000008DD E336                <1>     jcxz .r
  1810 000008DF B8A67F              <1>     mov  ax, CLOCK_K & 0xFFFF
  1811 000008E2 BA2000              <1>     mov  dx, CLOCK_K >> 16
  1812 000008E5 E8(1B00)            <1>     call div32                     ; DX:AX = MHz x 10
  1813 000008E8 09D2                <1>     or   dx, dx
  1814 000008EA 7529                <1>     jnz  .r
  1815 000008EC 3DE803              <1>     cmp  ax, 1000                  ; (more than 100 MHz: not a reading)
  1816 000008EF 7324                <1>     jae  .r
  1817 000008F1 BE[2E09]            <1>     mov  si, clock_std             ; snap to a standard clock within 1/16
  1818 000008F4 2E8B0C              <1> .sn:mov  cx, [cs:si]
  1819 000008F7 E31D                <1>     jcxz .raw
  1820 000008F9 46                  <1>     inc  si
  1821 000008FA 46                  <1>     inc  si
  1822 000008FB 89C2                <1>     mov  dx, ax
