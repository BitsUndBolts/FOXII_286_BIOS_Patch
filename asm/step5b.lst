    19                                  text_end:
    20                                  
    21                                  %include "autodet.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  Step 3: IDE auto-detection during POST
     3                              <1> ;
     4                              <1> ;  POST checkpoint 75h (943E) reads CMOS 12h at 9447 and runs the
     5                              <1> ;  fixed-disk setup A857 (checkpoint 76h) only if it is non-zero. A857
     6                              <1> ;  reads CMOS 12h again at A894. py/build.py turns both reads
     7                              <1> ;  (MOV AL,92h / CALL EE9F, 5 bytes) into a CALL and two NOPs:
     8                              <1> ;
     9                              <1> ;    9447: CALL autodet     auto-detect, then AL = CMOS 12h as drives12
    10                              <1> ;    A894: CALL drives12    AL = CMOS 12h without the drives that are gone
    11                              <1> ;
    12                              <1> ;  autodet: for each drive whose type in CMOS 12h is 0 ("Not installed")
    13                              <1> ;  and that answers IDENTIFY DEVICE, write type 47 with the geometry the
    14                              <1> ;  drive reports (IDENTIFY words 1, 3, 6) and fix the CMOS checksum
    15                              <1> ;  (10h-2Dh -> 2Eh/2Fh). Drives the user set up are never touched: no
    16                              <1> ;  command is sent to them.
    17                              <1> ;
    18                              <1> ;  drives12: CMOS 12h with the type nibble of every configured drive for
    19                              <1> ;  which nothing answers on the bus (status FFh, 7Fh or 00h) cleared.
    20                              <1> ;  CMOS itself is not changed: the drop lasts for this boot only, so a
    21                              <1> ;  type the user entered survives a boot with the drive unplugged, and
    22                              <1> ;  AMI does not wait about a minute for the drive and then stop with
    23                              <1> ;  "HDD controller failure". A drive that answers but is busy is left
    24                              <1> ;  to AMI, which waits for it as before.
    25                              <1> ;
    26                              <1> ;  Both entries keep every register except AL, as the CMOS read they
    27                              <1> ;  replace does (A857 needs AH = 0 after A894). The CMOS is only read
    28                              <1> ;  here when AMI found it valid: checkpoint 75h skips the disk setup,
    29                              <1> ;  and with it both hooks, when CMOS 0Eh bits 7:6 are set.
    30                              <1> ;
    31                              <1> ;  Timing: at 9447 interrupts are on and the BIOS tick counter 40:6Ch
    32                              <1> ;  runs (A857 relies on it too); waits are counted in ticks (55 ms).
    33                              <1> ;  IRQ 14 is still masked (AMI's INT 13h reset unmasks it later), so
    34                              <1> ;  the drive is polled; reading the status register at the end clears
    35                              <1> ;  the drive's interrupt request.
    36                              <1> ; =====================================================================
    37                              <1> 
    38                              <1> CMOS_RD   equ 0xEE9F             ; AL = index -> AL (AMI, keeps the NMI bit)
    39                              <1> CMOS_WR   equ 0xEEAE             ; AL = index, AH = value (AMI)
    40                              <1> T_READY   equ 182                ; 10 s: a drive spinning up becomes ready
    41                              <1> T_ID      equ 36                 ; 2 s: a ready drive answers IDENTIFY
    42                              <1> MAX_CYL   equ 16383              ; the largest ATA CHS cylinder count
    43                              <1> 
    44                              <1> section auto1 start=0x7F0F vstart=0x7F0F   ; 7F0F-7FFF (no checksum covers it; 7F0E ends the ID string)
    45                              <1> 
    46                              <1> ; ---------------------------------------------------------------------
    47                              <1> ; autodet -- hook at 9447 (checkpoint 75h)
    48                              <1> ; ---------------------------------------------------------------------
    49                              <1> autodet:
    50 00000000 FB                  <1>     sti                          ; (already on: the tick counter must run)
    51 00000001 60                  <1>     pusha
    52 00000002 1E                  <1>     push ds
    53 00000003 6A40                <1>     push 0x40
    54 00000005 1F                  <1>     pop  ds
    55 00000006 31DB                <1>     xor  bx, bx                  ; BL = 0: C:, then 1: D:
    56                              <1> .drive:
    57 00000008 B012                <1>     mov  al, 0x12
    58 0000000A E8(9FEE)            <1>     call CMOS_RD
    59 0000000D 08DB                <1>     or   bl, bl
    60 0000000F 7503                <1>     jnz  .lo
    61 00000011 C0E804              <1>     shr  al, 4
    62 00000014 240F                <1> .lo:and  al, 0x0F
    63 00000016 7508                <1>     jnz  .next                   ; set up by the user: never touched
    64 00000018 E8(0000)            <1>     call identify
    65 0000001B 7203                <1>     jc   .next
    66 0000001D E8(7300)            <1>     call set47
    67                              <1> .next:
    68 00000020 43                  <1>     inc  bx
    69 00000021 80FB02              <1>     cmp  bl, 2
    70 00000024 72E2                <1>     jb   .drive
    71 00000026 1F                  <1>     pop  ds
    72 00000027 61                  <1>     popa
    73                              <1>     ; fall through: AL = CMOS 12h for AMI's test at 944C
    74                              <1> 
    75                              <1> ; ---------------------------------------------------------------------
    76                              <1> ; drives12 -- hook at A894: AL = CMOS 12h without the drives that do not
    77                              <1> ; answer at all. Keeps every other register.
    78                              <1> ; ---------------------------------------------------------------------
    79                              <1> drives12:
    80 00000028 51                  <1>     push cx
    81 00000029 52                  <1>     push dx
    82 0000002A 53                  <1>     push bx
    83 0000002B B012                <1>     mov  al, 0x12
    84 0000002D E8(9FEE)            <1>     call CMOS_RD
    85 00000030 88C1                <1>     mov  cl, al
    86 00000032 31DB                <1>     xor  bx, bx
    87 00000034 B5F0                <1> .d: mov  ch, 0xF0                ; C: is the high nibble
    88 00000036 08DB                <1>     or   bl, bl
    89 00000038 7402                <1>     jz   .m
    90 0000003A B50F                <1>     mov  ch, 0x0F
    91 0000003C 84E9                <1> .m: test cl, ch
    92 0000003E 7409                <1>     jz   .n                      ; not set up: nothing to drop
    93 00000040 E81700              <1>     call select
    94 00000043 7304                <1>     jnc  .n                      ; something answers (ready or busy)
    95 00000045 F6D5                <1>     not  ch
    96 00000047 20E9                <1>     and  cl, ch                  ; gone: "Not installed" for this boot
    97 00000049 43                  <1> .n: inc  bx
    98 0000004A 80FB02              <1>     cmp  bl, 2
    99 0000004D 72E5                <1>     jb   .d
   100 0000004F 30DB                <1>     xor  bl, bl                  ; leave the master selected: a missing
   101 00000051 E80600              <1>     call select                  ; slave must not stay selected
   102 00000054 88C8                <1>     mov  al, cl
   103 00000056 5B                  <1>     pop  bx
   104 00000057 5A                  <1>     pop  dx
   105 00000058 59                  <1>     pop  cx
   106 00000059 C3                  <1>     ret
   107                              <1> 
   108                              <1> ; ---------------------------------------------------------------------
   109                              <1> ; select -- BL = drive: select it, wait 400 ns, read the status.
   110                              <1> ; Out: DX = 1F7h, AL = status; CF=1 if nothing answers (FFh: floating
   111                              <1> ; bus, 7Fh: floating with DD7 pulled down, 00h: the master answering for
   112                              <1> ; a slave that is not there).
   113                              <1> ; ---------------------------------------------------------------------
   114                              <1> select:
   115 0000005A BAF601              <1>     mov  dx, 0x1F6
   116 0000005D 88D8                <1>     mov  al, bl
   117 0000005F C0E004              <1>     shl  al, 4
   118 00000062 0CA0                <1>     or   al, 0xA0
   119 00000064 EE                  <1>     out  dx, al
   120 00000065 42                  <1>     inc  dx
   121 00000066 EC                  <1>     in   al, dx                  ; four reads: the 400 ns the drive may
   122 00000067 EC                  <1>     in   al, dx                  ; take before its status is valid
   123 00000068 EC                  <1>     in   al, dx
   124 00000069 EC                  <1>     in   al, dx
   125 0000006A 3CFF                <1>     cmp  al, 0xFF
   126 0000006C 7407                <1>     je   .none
   127 0000006E 3C7F                <1>     cmp  al, 0x7F
   128 00000070 7403                <1>     je   .none
   129 00000072 3C01                <1>     cmp  al, 1                   ; CF=1 if 00h
   130 00000074 C3                  <1>     ret
   131                              <1> .none:
   132 00000075 F9                  <1>     stc
   133 00000076 C3                  <1>     ret
   134                              <1> 
   135                              <1> ; ---------------------------------------------------------------------
   136                              <1> ; ide_wait -- poll 1F7h until (status AND AH) = AL, at most CX ticks.
   137                              <1> ; If AH has bit 0, ERR with BSY clear ends the wait as a failure.
   138                              <1> ; In: DX = 1F7h, DS = 40h. Out: CF=1 on timeout or error.
   139                              <1> ; ---------------------------------------------------------------------
   140                              <1> ide_wait:
   141 00000077 53                  <1>     push bx
   142 00000078 56                  <1>     push si
   143 00000079 89C3                <1>     mov  bx, ax
   144 0000007B 8B366C00            <1>     mov  si, [0x6C]
   145 0000007F EC                  <1> .l: in   al, dx
   146 00000080 F6C701              <1>     test bh, 1
   147 00000083 740A                <1>     jz   .t
   148 00000085 88C4                <1>     mov  ah, al
   149 00000087 80E481              <1>     and  ah, 0x81
   150 0000008A 80FC01              <1>     cmp  ah, 0x01
   151 0000008D 740F                <1>     je   .e
   152 0000008F 20F8                <1> .t: and  al, bh
   153 00000091 38D8                <1>     cmp  al, bl
   154 00000093 740A                <1>     je   .ok                     ; (CF=0)
   155 00000095 A16C00              <1>     mov  ax, [0x6C]
   156 00000098 29F0                <1>     sub  ax, si
   157 0000009A 39C8                <1>     cmp  ax, cx
   158 0000009C 72E1                <1>     jb   .l
   159 0000009E F9                  <1> .e: stc
   160 0000009F 5E                  <1> .ok:pop  si
   161 000000A0 5B                  <1>     pop  bx
   162 000000A1 C3                  <1>     ret
   163                              <1> ; ---------------------------------------------------------------------
   164                              <1> ; cmos_sum -- the CMOS checksum AMI checks at POST (82B2) and setup
   165                              <1> ; writes (C0B9): byte sum of 10h-2Dh, high byte to 2Eh, low byte to 2Fh
   166                              <1> ; ---------------------------------------------------------------------
   167                              <1> cmos_sum:
   168 000000A2 31D2                <1>     xor  dx, dx
   169 000000A4 B010                <1>     mov  al, 0x10
   170                              <1> .sum:
   171 000000A6 50                  <1>     push ax
   172 000000A7 E8(9FEE)            <1>     call CMOS_RD
   173 000000AA 30E4                <1>     xor  ah, ah
   174 000000AC 01C2                <1>     add  dx, ax
   175 000000AE 58                  <1>     pop  ax
   176 000000AF 40                  <1>     inc  ax
   177 000000B0 3C2E                <1>     cmp  al, 0x2E
   178 000000B2 72F2                <1>     jb   .sum
   179 000000B4 88F4                <1>     mov  ah, dh                  ; 2Eh = high byte
   180 000000B6 E8(AEEE)            <1>     call CMOS_WR
   181 000000B9 B02F                <1>     mov  al, 0x2F
   182 000000BB 88D4                <1>     mov  ah, dl
   183 000000BD E9(AEEE)            <1>     jmp  CMOS_WR
   184                              <1> 
   185                              <1> ; cmos_wr_next -- write AH to CMOS index AL, then AL = AL + 1
   186                              <1> cmos_wr_next:
   187 000000C0 E8(AEEE)            <1>     call CMOS_WR
   188 000000C3 40                  <1>     inc  ax
   189 000000C4 C3                  <1>     ret
   190                              <1> auto1_end:
   191                              <1> 
   192                              <1> section auto2 start=0xE32D vstart=0xE32D   ; E32D-E3FD (E32C ends the copyright line at E300)
   193                              <1> 
   194                              <1> ; ---------------------------------------------------------------------
   195                              <1> ; identify -- BL = drive: IDENTIFY DEVICE by polling.
   196                              <1> ; Out: CF=0: CX = cylinders, DL = heads, DH = sectors (words 1, 3, 6;
   197                              <1> ; 1-16383 / 1-16 / 1-63). CF=1: no drive, no answer, or an ATAPI
   198                              <1> ; device (it aborts IDENTIFY DEVICE). BL is kept.
   199                              <1> ; ---------------------------------------------------------------------
   200                              <1> identify:
   201 00000000 E8(5A00)            <1>     call select
   202 00000003 726B                <1>     jc   .r
   203 00000005 B80080              <1>     mov  ax, 0x8000              ; not busy: a drive may still spin up.
   204 00000008 B9B600              <1>     mov  cx, T_READY             ; The master ignores a new drive select
   205 0000000B E8(7700)            <1>     call ide_wait                    ; while it is busy, so select again
   206 0000000E 7260                <1>     jc   .r                      ; once it is not.
   207 00000010 E8(5A00)            <1>     call select
   208 00000013 725B                <1>     jc   .r
   209 00000015 B840C0              <1>     mov  ax, 0xC040              ; BSY=0, DRDY=1
   210 00000018 B92400              <1>     mov  cx, T_ID
   211 0000001B E8(7700)            <1>     call ide_wait
   212 0000001E 7250                <1>     jc   .r
   213 00000020 B0EC                <1>     mov  al, 0xEC                ; IDENTIFY DEVICE
   214 00000022 EE                  <1>     out  dx, al
   215 00000023 B80889              <1>     mov  ax, 0x8908              ; BSY=0, DRQ=1; ERR ends the wait
   216 00000026 E8(7700)            <1>     call ide_wait                    ; (CX = T_ID still)
   217 00000029 7245                <1>     jc   .r
   218 0000002B B2F0                <1>     mov  dl, 0xF0
   219 0000002D 31C9                <1>     xor  cx, cx
   220 0000002F ED                  <1> .w: in   ax, dx                  ; all 256 words, keep three
   221 00000030 80F901              <1>     cmp  cl, 1
   222 00000033 7502                <1>     jne  .h
   223 00000035 89C6                <1>     mov  si, ax                  ; word 1: cylinders
   224 00000037 80F903              <1> .h: cmp  cl, 3
   225 0000003A 7502                <1>     jne  .s
   226 0000003C 89C7                <1>     mov  di, ax                  ; word 3: heads
   227 0000003E 80F906              <1> .s: cmp  cl, 6
   228 00000041 7502                <1>     jne  .n
   229 00000043 88C7                <1>     mov  bh, al                  ; word 6: sectors per track
   230 00000045 41                  <1> .n: inc  cx
   231 00000046 81F90001            <1>     cmp  cx, 256
   232 0000004A 72E3                <1>     jb   .w
   233 0000004C B2F7                <1>     mov  dl, 0xF7
   234 0000004E EC                  <1>     in   al, dx                  ; status read: clears the drive's IRQ
   235 0000004F 89F1                <1>     mov  cx, si
   236 00000051 E31E                <1>     jcxz .bad                    ; cylinders 1-16383
   237 00000053 81F9FF3F            <1>     cmp  cx, MAX_CYL
   238 00000057 7718                <1>     ja   .bad
   239 00000059 89FA                <1>     mov  dx, di
   240 0000005B 83FA10              <1>     cmp  dx, 16                  ; heads 1-16
   241 0000005E 7711                <1>     ja   .bad
   242 00000060 08D2                <1>     or   dl, dl
   243 00000062 740D                <1>     jz   .bad
   244 00000064 88FE                <1>     mov  dh, bh
   245 00000066 08F6                <1>     or   dh, dh                  ; sectors 1-63
   246 00000068 7407                <1>     jz   .bad
   247 0000006A 80FE3F              <1>     cmp  dh, 63
   248 0000006D 7702                <1>     ja   .bad
   249 0000006F F8                  <1>     clc
   250 00000070 C3                  <1> .r: ret
   251                              <1> .bad:
   252 00000071 F9                  <1>     stc
   253 00000072 C3                  <1>     ret
   254                              <1> 
   255                              <1> ; ---------------------------------------------------------------------
   256                              <1> ; set47 -- BL = drive, CX/DL/DH = cylinders/heads/sectors: CMOS type 47
   257                              <1> ; (nibble 0Fh in 12h, 47 in 19h/1Ah, parameters at 1Bh/24h in AMI's
   258                              <1> ; order: cylinders, heads, write precompensation (none), control byte,
   259                              <1> ; landing zone (= cylinders), sectors), then the CMOS checksum.
   260                              <1> ; ---------------------------------------------------------------------
   261                              <1> set47:
   262 00000073 B012                <1>     mov  al, 0x12
   263 00000075 E8(9FEE)            <1>     call CMOS_RD
   264 00000078 B4F0                <1>     mov  ah, 0xF0
   265 0000007A 08DB                <1>     or   bl, bl
   266 0000007C 7402                <1>     jz   .c
   267 0000007E B40F                <1>     mov  ah, 0x0F
   268 00000080 08C4                <1> .c: or   ah, al                  ; the other drive's nibble stays
   269 00000082 B012                <1>     mov  al, 0x12
   270 00000084 E8(AEEE)            <1>     call CMOS_WR
   271 00000087 B019                <1>     mov  al, 0x19
   272 00000089 00D8                <1>     add  al, bl
   273 0000008B B42F                <1>     mov  ah, 47
   274 0000008D E8(AEEE)            <1>     call CMOS_WR
   275 00000090 B01B                <1>     mov  al, 0x1B                ; C: 1Bh-23h, D: 24h-2Ch
   276 00000092 08DB                <1>     or   bl, bl
   277 00000094 7402                <1>     jz   .p
   278 00000096 B024                <1>     mov  al, 0x24
   279 00000098 88CC                <1> .p: mov  ah, cl
   280 0000009A E8(C000)            <1>     call cmos_wr_next                     ; cylinders
   281 0000009D 88EC                <1>     mov  ah, ch
   282 0000009F E8(C000)            <1>     call cmos_wr_next
   283 000000A2 88D4                <1>     mov  ah, dl
   284 000000A4 E8(C000)            <1>     call cmos_wr_next                     ; heads
   285 000000A7 B4FF                <1>     mov  ah, 0xFF
   286 000000A9 E8(C000)            <1>     call cmos_wr_next                     ; write precompensation: none
   287 000000AC E8(C000)            <1>     call cmos_wr_next
   288 000000AF B400                <1>     mov  ah, 0
   289 000000B1 80FA08              <1>     cmp  dl, 8
   290 000000B4 7602                <1>     jbe  .cb
   291 000000B6 B408                <1>     mov  ah, 8                   ; control byte: more than 8 heads
   292 000000B8 E8(C000)            <1> .cb:call cmos_wr_next
   293 000000BB 88CC                <1>     mov  ah, cl
   294 000000BD E8(C000)            <1>     call cmos_wr_next                     ; landing zone = cylinders
   295 000000C0 88EC                <1>     mov  ah, ch
   296 000000C2 E8(C000)            <1>     call cmos_wr_next
   297 000000C5 88F4                <1>     mov  ah, dh
   298 000000C7 E8(C000)            <1>     call cmos_wr_next                     ; sectors
   299 000000CA E9(A200)            <1>     jmp  cmos_sum
   300                              <1> auto2_end:
    22                                  %include "bootskip.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  Step 4: 386 code while booting from A: -> message, then boot from C:
     3                              <1> ;
     4                              <1> ;  Step 2 shows a message and halts on any invalid opcode. That is
     5                              <1> ;  right for a program, but annoying when a boot floppy for a 386 (an
     6                              <1> ;  MS-DOS 7.1 or Windows 9x disk) is left in A:: the PC never gets to C:.
     7                              <1> ;
     8                              <1> ;  Now, when the fault happens while the BIOS is booting from A: and DOS
     9                              <1> ;  is not loaded yet, the message ends with "Drive A: skipped. Booting
    10                              <1> ;  from drive C: ..." and AMI's boot code continues with C:, as if A:
    11                              <1> ;  had held no disk. Every other invalid opcode still halts in Step 2's
    12                              <1> ;  handler, unchanged.
    13                              <1> ;
    14                              <1> ;  "Booting from A:": AMI's INT 19h (8F80, the only entry: INT 19h ->
    15                              <1> ;  E6F2 -> 8F80, and the end of POST calls INT 19h) clears a marker word,
    16                              <1> ;  and the A: path sets it just before it checks and starts the boot
    17                              <1> ;  sector (8FDF). "DOS not loaded yet": INT 21h still holds the default
    18                              <1> ;  vector POST gave INT 00h-77h (F000:EA85, set at 90BC); DOS replaces
    19                              <1> ;  it. That also covers a loader (IO.SYS) the boot sector started.
    20                              <1> ;  A: is skipped once per INT 19h: the marker then says "skipped", so a
    21                              <1> ;  386 boot sector on C: halts instead of going round in circles.
    22                              <1> ;
    23                              <1> ;  py/build.py patches:
    24                              <1> ;    8F80  XOR AX,AX / MOV ES,AX          -> CALL int19_entry, NOP
    25                              <1> ;    8FDF  MOV DI,BX / MOV AX,ES:[DI]     -> CALL int19_a, NOP, NOP
    26                              <1> ;    EB2E  JMP int6_halt (Step 2)         -> JMP int6_boot
    27                              <1> ;
    28                              <1> ;  Before going on to C:, what a boot sector typically changes is put
    29                              <1> ;  back: INT 1Eh (DOS boot sectors point it at their own copy of the
    30                              <1> ;  diskette parameters; 8F80 sets the same value), the stack (0030:0100,
    31                              <1> ;  as POST boots with), interrupts on, and an end-of-interrupt to both
    32                              <1> ;  PICs. If C: does not boot either, AMI's own path follows: "INVALID
    33                              <1> ;  BOOT DISKETTE", "Insert BOOT diskette in A:", a key, and INT 19h again
    34                              <1> ;  from the start (which tries A: again: the disk may have been changed).
    35                              <1> ; =====================================================================
    36                              <1> 
    37                              <1> BOOT_FLAG  equ 0x04F0            ; 0000:04F0 = BDA 40:F0 (intra-application area, unused by the BIOS)
    38                              <1> FLAG_A     equ 0x3A41            ; "A:" the A: boot sector is being started
    39                              <1> FLAG_SKIP  equ 0x2D41            ; "A-" A: was skipped (never twice per INT 19h)
    40                              <1> INT_DEF    equ 0xEA85            ; POST's default vector F000:EA85 (90BC)
    41                              <1> BOOT_C     equ 0x8FB1            ; INT 19h: CMOS 0Eh bit 3 test, then try C:
    42                              <1> S_BADDISK  equ 0x7DB3            ; "  INVALID BOOT DISKETTE" (AMI's message if C: fails too)
    43                              <1> DPT_ROM    equ 0xEFC7            ; diskette parameter table, INT 1Eh (8F84)
    44                              <1> TAIL_LINE1 equ 63                ; CR LF + " The 80286 cannot run this code. It needs a 386 or newer CPU."
    45                              <1>                                  ; (the first line of Step 2's msg_tail; build.py checks it)
    46                              <1> 
    47                              <1> section boot1 start=0xF474 vstart=0xF474   ; F474-F4F9 (code before and after)
    48                              <1> 
    49                              <1> ; ---------------------------------------------------------------------
    50                              <1> ; int19_entry -- hook at 8F80 (INT 19h): no drive started yet.
    51                              <1> ; Does what it replaces: AX = 0, ES = 0.
    52                              <1> ; ---------------------------------------------------------------------
    53                              <1> int19_entry:
    54 00000000 31C0                <1>     xor  ax, ax
    55 00000002 8EC0                <1>     mov  es, ax
    56 00000004 26A3F004            <1>     mov  [es:BOOT_FLAG], ax
    57 00000008 C3                  <1>     ret
    58                              <1> 
    59                              <1> ; ---------------------------------------------------------------------
    60                              <1> ; int19_a -- hook at 8FDF: A:'s boot sector was read (ES = 0, BX = 7C00)
    61                              <1> ; and is about to be checked and started. Does what it replaces:
    62                              <1> ; DI = BX, AX = the first word of the sector.
    63                              <1> ; ---------------------------------------------------------------------
    64                              <1> int19_a:
    65 00000009 26C706F004413A      <1>     mov  word [es:BOOT_FLAG], FLAG_A
    66 00000010 89DF                <1>     mov  di, bx
    67 00000012 268B05              <1>     mov  ax, [es:di]
    68 00000015 C3                  <1>     ret
    69                              <1> 
    70                              <1> ; ---------------------------------------------------------------------
    71                              <1> ; int6_boot -- at EB2E, for every invalid opcode AMI does not handle
    72                              <1> ; itself (LOADALL, LOCK). [SP] = IP, [SP+2] = CS, [SP+4] = FLAGS, all
    73                              <1> ; registers as the program left them.
    74                              <1> ; ---------------------------------------------------------------------
    75                              <1> int6_boot:
    76 00000016 1E                  <1>     push ds
    77 00000017 50                  <1>     push ax
    78 00000018 31C0                <1>     xor  ax, ax
    79 0000001A 8ED8                <1>     mov  ds, ax
    80 0000001C 813EF004413A        <1>     cmp  word [BOOT_FLAG], FLAG_A          ; booting from A:?
    81 00000022 7510                <1>     jne  .halt
    82 00000024 813E840085EA        <1>     cmp  word [0x21 * 4], INT_DEF          ; and DOS not loaded yet?
    83 0000002A 7508                <1>     jne  .halt
    84 0000002C 8CC8                <1>     mov  ax, cs
    85 0000002E 39068600            <1>     cmp  [0x21 * 4 + 2], ax
    86 00000032 7405                <1>     je   .skip
    87                              <1> .halt:
    88 00000034 58                  <1>     pop  ax
    89 00000035 1F                  <1>     pop  ds
    90 00000036 E9(6701)            <1>     jmp  int6_halt                         ; Step 2: message and halt
    91                              <1> 
    92                              <1> ; --- A: is skipped: the message, then on to C:. DS = 0. Nothing of the
    93                              <1> ; boot sector is needed any more (its AX and DS stay on the stack).
    94                              <1> .skip:
    95 00000039 C706F004412D        <1>     mov  word [BOOT_FLAG], FLAG_SKIP       ; once per INT 19h
    96 0000003F 58                  <1>     pop  ax                                ; (the stack is reset before C:)
    97 00000040 58                  <1>     pop  ax
    98 00000041 5F                  <1>     pop  di                                ; faulting IP
    99 00000042 5A                  <1>     pop  dx                                ; faulting CS
   100 00000043 B020                <1>     mov  al, 0x20                          ; end of interrupt, in case
   101 00000045 E6A0                <1>     out  0xA0, al
   102 00000047 E620                <1>     out  0x20, al
   103 00000049 E8(2500)            <1>     call skip_mode
   104 0000004C BE[4502]            <1>     mov  si, msg_head                      ; Step 2's text and helpers
   105 0000004F E8(1802)            <1>     call int6_halt.puts
   106 00000052 89D0                <1>     mov  ax, dx
   107 00000054 E8(2502)            <1>     call int6_halt.hex16
   108 00000057 B03A                <1>     mov  al, ':'
   109 00000059 E8(3E02)            <1>     call int6_halt.putc
   110 0000005C 89F8                <1>     mov  ax, di
   111 0000005E E8(2502)            <1>     call int6_halt.hex16
   112 00000061 E8(0000)            <1>     call skip_where
   113 00000064 BE[7602]            <1>     mov  si, msg_tail                      ; Step 2's text, first line only
   114 00000067 B93F00              <1>     mov  cx, TAIL_LINE1
   115                              <1> .l1:
   116 0000006A 2E8A04              <1>     mov  al, [cs:si]
   117 0000006D 46                  <1>     inc  si
   118 0000006E E8(3E02)            <1>     call int6_halt.putc
   119 00000071 E2F7                <1>     loop .l1
   120 00000073 BE[0000]            <1>     mov  si, msg_skip
   121 00000076 E8(1802)            <1>     call int6_halt.puts
   122 00000079 E9(0000)            <1>     jmp  skip_go
   123                              <1> 
   124                              <1> section boot2 start=0x7EBA vstart=0x7EBA   ; 7EBA-7EFF (7EB9 ends "PARITY ERROR ????"; no checksum here)
   125                              <1> 
   126                              <1> ; ---------------------------------------------------------------------
   127                              <1> ; skip_go -- on to C:, as AMI's INT 19h does when A: holds no boot disk
   128                              <1> ; ---------------------------------------------------------------------
   129                              <1> skip_go:
   130 00000000 FA                  <1>     cli
   131 00000001 31C0                <1>     xor  ax, ax
   132 00000003 8EC0                <1>     mov  es, ax
   133 00000005 26C7067800C7EF      <1>     mov  word [es:0x1E * 4], DPT_ROM       ; INT 1Eh, as 8F84 sets it
   134 0000000C 268C0E7A00          <1>     mov  [es:0x1E * 4 + 2], cs
   135 00000011 B83000              <1>     mov  ax, 0x30                          ; the stack POST boots with
   136 00000014 8ED0                <1>     mov  ss, ax
   137 00000016 BC0001              <1>     mov  sp, 0x100
   138 00000019 FB                  <1>     sti
   139 0000001A 31D2                <1>     xor  dx, dx                            ; (9005 reads with head DH)
   140 0000001C BB007C              <1>     mov  bx, 0x7C00
   141 0000001F BEB37D              <1>     mov  si, S_BADDISK
   142 00000022 E9(B18F)            <1>     jmp  BOOT_C
   143                              <1> 
   144                              <1> ; ---------------------------------------------------------------------
   145                              <1> ; skip_mode -- a text mode the message can be read in, as in Step 2.
   146                              <1> ; Out: BH = page, BL = 07h. DS = 0.
   147                              <1> ; ---------------------------------------------------------------------
   148                              <1> skip_mode:
   149 00000025 B40F                <1>     mov  ah, 0x0F
   150 00000027 CD10                <1>     int  0x10
   151 00000029 3C03                <1>     cmp  al, 3
   152 0000002B 7616                <1>     jbe  .text
   153 0000002D 3C07                <1>     cmp  al, 7
   154 0000002F 7412                <1>     je   .text
   155 00000031 A01004              <1>     mov  al, [0x410]                       ; equipment: initial video mode bits 5:4
   156 00000034 2430                <1>     and  al, 0x30
   157 00000036 3C30                <1>     cmp  al, 0x30
   158 00000038 B80300              <1>     mov  ax, 0x0003
   159 0000003B 7502                <1>     jne  .set
   160 0000003D B007                <1>     mov  al, 0x07
   161                              <1> .set:
   162 0000003F CD10                <1>     int  0x10
   163 00000041 30FF                <1>     xor  bh, bh
   164                              <1> .text:
   165 00000043 B307                <1>     mov  bl, 0x07
   166 00000045 C3                  <1>     ret
   167                              <1> 
   168                              <1> section boot4 start=0x7FD4 vstart=0x7FD4   ; 7FD4-7FFF, after Step 3's code
   169                              <1> 
   170 00000000 0D0A20447269766520- <1> msg_skip db 13, 10, ' Drive A: skipped. Booting from C: ...', 13, 10, 0
   170 00000009 413A20736B69707065- <1>
   170 00000012 642E20426F6F74696E- <1>
   170 0000001B 672066726F6D20433A- <1>
   170 00000024 202E2E2E0D0A00      <1>
   171                              <1> 
   172                              <1> section boot3 start=0xDFBB vstart=0xDFBB   ; DFBB-DFFF (DFBA ends "Dec")
   173                              <1> 
   174                              <1> ; ---------------------------------------------------------------------
   175                              <1> ; skip_where -- after "Invalid opcode at CS:IP": " (boot sector)" if
   176                              <1> ; it is in 0000:7C00-7DFF, and the bytes there. DX:DI = CS:IP.
   177                              <1> ; ---------------------------------------------------------------------
   178                              <1> skip_where:
   179 00000000 89D0                <1>     mov  ax, dx                            ; linear address in 0000:7C00-7DFF?
   180 00000002 C1E004              <1>     shl  ax, 4
   181 00000005 89D1                <1>     mov  cx, dx
   182 00000007 C1E90C              <1>     shr  cx, 12
   183 0000000A 01F8                <1>     add  ax, di
   184 0000000C 83D100              <1>     adc  cx, 0
   185 0000000F 2D007C              <1>     sub  ax, 0x7C00
   186 00000012 83D900              <1>     sbb  cx, 0
   187 00000015 750B                <1>     jnz  .bytes
   188 00000017 3D0002              <1>     cmp  ax, 0x200
   189 0000001A 7306                <1>     jae  .bytes
   190 0000001C BE[5C02]            <1>     mov  si, msg_boot
   191 0000001F E8(1802)            <1>     call int6_halt.puts
   192                              <1> .bytes:
   193 00000022 BE[6B02]            <1>     mov  si, msg_bytes
   194 00000025 E8(1802)            <1>     call int6_halt.puts
   195 00000028 8EC2                <1>     mov  es, dx
   196 0000002A B90600              <1>     mov  cx, 6
   197                              <1> .bl:
   198 0000002D 268A05              <1>     mov  al, [es:di]
   199 00000030 E8(2C02)            <1>     call int6_halt.hex8
   200 00000033 B020                <1>     mov  al, ' '
   201 00000035 E8(3E02)            <1>     call int6_halt.putc
   202 00000038 47                  <1>     inc  di
   203 00000039 E2F2                <1>     loop .bl
   204 0000003B C3                  <1>     ret
    23                                  %include "post.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  Round 5b: the POST screen of BUBios/286
     3                              <1> ;
     4                              <1> ;  A full-screen POST display in the style of BUBios (the SOYO's
     5                              <1> ;  BUBios/asm/post.asm), rewritten for the 286 and this AMI BIOS. AMI's
     6                              <1> ;  POST still does all the work in the same order; this code replaces
     7                              <1> ;  what POST prints, through same-length CALL / JMP hooks that
     8                              <1> ;  py/build.py applies and asserts (docs/DEVELOPMENT_LOG.md, round 5b):
     9                              <1> ;
    10                              <1> ;    92C1  CALL F042 (copyright line, cp 22h)   -> CALL bu_init
    11                              <1> ;    76D0  copyright + BIOS ID (cp 24h/42h/7Ch) -> JMP bu_idline
    12                              <1> ;    766E  screen tamper check                  -> RET
    13                              <1> ;    ACDB  memory count print (cp 3Ah-3Ch)      -> CALL bu_mem, JMP AD01
    14                              <1> ;    AD05  "Press <ESC> to bypass MEMORY test"  -> CALL bu_escmsg, JMP AD1E
    15                              <1> ;    AB60  clear the message row (cp 43h, 7Fh)  -> JMP bu_clrmsg
    16                              <1> ;    93F6  "Press <DEL> ... SETUP or DIAGS"     -> CALL bu_delmsg, NOPs
    17                              <1> ;    96E7  MOV SI,7AB2 (error list, cp 85h)     -> CALL bu_errors
    18                              <1> ;    9791  mode set before the configuration box -> CALL bu_refresh, NOPs
    19                              <1> ;    0008  JMP 7000 (configuration box)         -> JMP bu_final
    20                              <1> ;
    21                              <1> ;  State between the hooks lives in the BDA's intra-application area
    22                              <1> ;  40:F0-FF: POST clears 0:0500-7BFF at checkpoint 7Fh. bu_final clears
    23                              <1> ;  the area again before INT 19h (Step 4 uses 40:F0 from INT 19h on).
    24                              <1> ;
    25                              <1> ;  Everything here runs with CS = F000; DS = 0040h inside the routines,
    26                              <1> ;  ES = the text buffer (B800h, or B000h in mode 7). 286 code only.
    27                              <1> ; =====================================================================
    28                              <1> 
    29                              <1> ; ---- AMI routines ------------------------------------------------------
    30                              <1> A_CMOSRD   equ 0xEE9F     ; AL = index -> AL (other registers kept)
    31                              <1> A_PUTENC   equ 0x75BB     ; print the encoded string CS:SI at the cursor, attribute BL
    32                              <1> A_PUTC     equ 0x7618     ; AL at the cursor, attribute BL, cursor advanced
    33                              <1> A_VIDEO    equ 0x75F5     ; INT 10h through the vector
    34                              <1> A_KBCCMD   equ 0x8E7A     ; KBC command AL (ZF = 1: sent)
    35                              <1> A_KBCOBF   equ 0x8E58     ; wait for the KBC output buffer
    36                              <1> A_KBCEND   equ 0x8EB3     ; KBC back to normal (as 76D0 ends)
    37                              <1> A_LPTTEST  equ 0x97FC     ; AMI's LPT probe: DX = port, DI = index, DS = 40h
    38                              <1> A_COMTEST  equ 0x9808     ; AMI's COM probe: DX = port, DI = index, DS = 40h
    39                              <1> S_BIOSID   equ 0x9818     ; encoded "          DH12-1112-061390-K" (then the KBC version)
    40                              <1> DRV_TABLE  equ 0xE401     ; drive types 1-46, 16 bytes each (as an FDPT)
    41                              <1> ERR_TABLE  equ 0x7AB2     ; AMI's error message table (96E7: MOV SI,7AB2)
    42                              <1> 
    43                              <1> ; ---- state, BDA 40:F0-FF ------------------------------------------------
    44                              <1> ST_FLAG    equ 0xF0       ; FLAG_UP while our screen is up (this POST)
    45                              <1> FLAG_UP    equ 0xB2
    46                              <1> ST_SCH     equ 0xF1       ; attribute table: 0 = teal ... 6 = monochrome
    47                              <1> ST_UNITS   equ 0xF2       ; word: 64 KB blocks AMI has counted
    48                              <1> ST_TOTAL   equ 0xF4       ; word: 64 KB blocks expected
    49                              <1> ST_CM12    equ 0xF6       ; CMOS 12h when the screen was first drawn
    50                              <1> ST_DISK    equ 0xF7       ; bits 1-0 C:, 3-2 D: (D_*), bit 4/5: C:/D: is a CF card
    51                              <1> D_NONE     equ 0          ;   nothing answered
    52                              <1> D_OK       equ 1          ;   identified, the model is on the screen
    53                              <1> D_BUSY     equ 2          ;   busy at the first try: ask again at the end
    54                              <1> D_FAIL     equ 3          ;   it answered but IDENTIFY failed (ATAPI, timeout)
    55                              <1> ST_T0      equ 0xF8       ; word: RTC minute * 60 + second at checkpoint 22h
    56                              <1> ST_MHZ     equ 0xFA       ; measured clock in MHz (0: not a standard clock)
    57                              <1> ST_MISC    equ 0xFB       ; bit 0: screen redrawn (setup visited: no POST time)
    58                              <1>                           ; bit 1: errors shown, bit 2: end of POST
    59                              <1> ST_STAT    equ 0xFC       ; word: status line text
    60                              <1> ST_KBCV    equ 0xFE       ; the KBC version character (bu_idline)
    61                              <1> 
    62                              <1> ; ---- attribute indices ----------------------------------------------------
    63                              <1> AT_BG      equ 0
    64                              <1> AT_TITLE   equ 1
    65                              <1> AT_LABEL   equ 2
    66                              <1> AT_VALUE   equ 3
    67                              <1> AT_FILL    equ 4
    68                              <1> AT_EMPTY   equ 5
    69                              <1> AT_ACCENT  equ 6
    70                              <1> AT_ERR     equ 7
    71                              <1> AT_STAT    equ 8
    72                              <1> NATTR      equ 9
    73                              <1> SCH_MONO   equ 6
    74                              <1> 
    75                              <1> ; ---- layout -----------------------------------------------------------------
    76                              <1> R_SYS      equ 2          ; rows 2..5: processor / system
    77                              <1> R_MEM      equ 7
    78                              <1> R_FDD      equ 9
    79                              <1> R_HDC      equ 10         ; rows 10-11: C:, 12-13: D:
    80                              <1> R_PORTS    equ 15
    81                              <1> R_ROMS     equ 16
    82                              <1> R_LINE     equ 17
    83                              <1> R_MSG      equ 18         ; rows 18..23: AMI's messages, then the boot's
    84                              <1> R_STAT     equ 24
    85                              <1> C_LBL      equ 2
    86                              <1> C_VAL      equ 15
    87                              <1> C_RLBL     equ 47
    88                              <1> C_RVAL     equ 60
    89                              <1> C_CF       equ 10         ; " CF " badge on a CF card's model row
    90                              <1> BAR_W      equ 40
    91                              <1> C_TIME     equ 40         ; status bar: text 1-36, | 38, "POST n s" 40, | 48, ID 50-78
    92                              <1> C_ID       equ 50
    93                              <1> 
    94                              <1> %define POS(r,c) (((r) << 8) | (c))
    95                              <1> 
    96                              <1> TLOOP      equ 0x7C00     ; the clock loop is built at 0:7C00 (cleared at cp 7Fh)
    97                              <1> T_PASSES   equ 250        ; passes of 32 x DIV BX + LOOP
    98                              <1> CLOCK_K    equ 2129830    ; 250 x 714 clocks x 1.193182 MHz x 10: MHz x 10 = K / PIT ticks
    99                              <1> T_MS       equ 66         ; port 61h bit 4 toggles per millisecond (15.09 us each)
   100                              <1> 
   101                              <1> section diag start=0x000B vstart=0x000B   ; the old diagnostics module (round 5a)
   102                              <1> 
   103                              <1> ; =====================================================================
   104                              <1> ; bu_init -- 92C1 (checkpoint 22h), in place of AMI's copyright line.
   105                              <1> ; Draws the whole screen. The cursor ends two rows lower, as after
   106                              <1> ; AMI's line and its CR LF CR LF (92C8 reads it).
   107                              <1> ; =====================================================================
   108                              <1> bu_init:
   109 00000000 60                  <1>     pusha
   110 00000001 1E                  <1>     push ds
   111 00000002 06                  <1>     push es
   112 00000003 6A40                <1>     push 0x40
   113 00000005 1F                  <1>     pop  ds
   114 00000006 FC                  <1>     cld
   115 00000007 31C0                <1>     xor  ax, ax                    ; fresh state (also after a warm boot)
   116 00000009 A3F200              <1>     mov  [ST_UNITS], ax
   117 0000000C A2F700              <1>     mov  [ST_DISK], al
   118 0000000F A2FB00              <1>     mov  [ST_MISC], al
   119 00000012 A2FE00              <1>     mov  [ST_KBCV], al
   120 00000015 C706FC00[360D]      <1>     mov  word [ST_STAT], s_st_wait
   121 0000001B B012                <1>     mov  al, 0x12
   122 0000001D E8(9FEE)            <1>     call A_CMOSRD
   123 00000020 A2F600              <1>     mov  [ST_CM12], al
   124 00000023 E82309              <1>     call rtc_now
   125 00000026 A3F800              <1>     mov  [ST_T0], ax
   126 00000029 E81204              <1>     call mem_total
   127 0000002C E83808              <1>     call measure_clock
   128 0000002F E8DA08              <1>     call early_ports
   129 00000032 E84302              <1>     call draw_all
   130 00000035 C606F000B2          <1>     mov  byte [ST_FLAG], FLAG_UP
   131 0000003A E8F706              <1>     call ident_all                 ; models of the drives that are ready
   132 0000003D B403                <1>     mov  ah, 3                     ; cursor: two rows down, column 0
   133 0000003F 30FF                <1>     xor  bh, bh
   134 00000041 CD10                <1>     int  0x10
   135 00000043 80C602              <1>     add  dh, 2
   136 00000046 30D2                <1>     xor  dl, dl
   137 00000048 B402                <1>     mov  ah, 2
   138 0000004A CD10                <1>     int  0x10
   139 0000004C 07                  <1>     pop  es
   140 0000004D 1F                  <1>     pop  ds
   141 0000004E 61                  <1>     popa
   142 0000004F C3                  <1>     ret
   143                              <1> 
   144                              <1> ; =====================================================================
   145                              <1> ; bu_idline -- 76D0 (checkpoints 24h, 42h, 7Ch). AMI printed its
   146                              <1> ; copyright line on row 22 and the BIOS ID with the keyboard
   147                              <1> ; controller's version on row 24: the ID goes into the status bar,
   148                              <1> ; with AMI's own printer and KBC code (76E8-7715). Same frame as 76D0.
   149                              <1> ; =====================================================================
   150                              <1> bu_idline:
   151 00000050 60                  <1>     pusha
   152 00000051 1E                  <1>     push ds
   153 00000052 6A40                <1>     push 0x40
