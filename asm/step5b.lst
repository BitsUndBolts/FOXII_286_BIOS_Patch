   154 00000245 0D0A0A20496E76616C- <1> msg_head  db 13, 10, 10, ' Invalid opcode at ', 0
   154 0000024E 6964206F70636F6465- <1>
   154 00000257 2061742000          <1>
   155 0000025C 2028626F6F74207365- <1> msg_boot  db ' (boot sector)', 0
   155 00000265 63746F722900        <1>
   156 0000026B 0D0A2042797465733A- <1> msg_bytes db 13, 10, ' Bytes: ', 0
   156 00000274 2000                <1>
   157 00000276 0D0A20546865203830- <1> msg_tail  db 13, 10, ' The 80286 cannot run this code. It needs a 386 or newer CPU.'
   157 0000027F 3238362063616E6E6F- <1>
   157 00000288 742072756E20746869- <1>
   157 00000291 7320636F64652E2049- <1>
   157 0000029A 74206E656564732061- <1>
   157 000002A3 20333836206F72206E- <1>
   157 000002AC 65776572204350552E  <1>
   158 000002B5 0D0A2053797374656D- <1>           db 13, 10, ' System halted. Press Ctrl+Alt+Del to restart.', 13, 10, 0
   158 000002BE 2068616C7465642E20- <1>
   158 000002C7 507265737320437472- <1>
