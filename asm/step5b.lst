  1557 00000894 F32EA4              <1>     rep  cs movsb
  1558 00000897 B8F7F3              <1>     mov  ax, 0xF3F7                ; 32 x DIV BX
  1559 0000089A B92000              <1>     mov  cx, 32
  1560 0000089D F3AB                <1>     rep  stosw
  1561 0000089F B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV (-66)
  1562 000008A2 AB                  <1>     stosw
