   191                              <1> ; =====================================================================
   192                              <1> ; bu_mem -- ACDB, after each 64 KB block (AX = blocks counted, 1 first).
   193                              <1> ; Replaces AMI's "nnnnn KB OK" print. Keeps every register.
   194                              <1> ; =====================================================================
   195                              <1> bu_mem:
   196 000000A4 60                  <1>     pusha
   197 000000A5 1E                  <1>     push ds
   198 000000A6 06                  <1>     push es
   199 000000A7 6A40                <1>     push 0x40
   200 000000A9 1F                  <1>     pop  ds
   201 000000AA FC                  <1>     cld
   202 000000AB 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   203 000000B0 7512                <1>     jne  .out
   204 000000B2 A3F200              <1>     mov  [ST_UNITS], ax
   205 000000B5 3B06F400            <1>     cmp  ax, [ST_TOTAL]
   206 000000B9 7603                <1>     jbe  .d
   207 000000BB A3F400              <1>     mov  [ST_TOTAL], ax
   208 000000BE E80B09              <1> .d: call vid_es
   209 000000C1 E82D03              <1>     call draw_memory
   210                              <1> .out:
   211 000000C4 07                  <1>     pop  es
   212 000000C5 1F                  <1>     pop  ds
   213 000000C6 61                  <1>     popa
   214 000000C7 C3                  <1>     ret
   215                              <1> 
   216                              <1> ; =====================================================================
   217                              <1> ; status line hooks: ESC (cp 3Ah), AB60 clears the message row (cp 43h,
   218                              <1> ; 7Fh), DEL (cp 73h). All keep every register.
   219                              <1> ; =====================================================================
