   199                              <1> ; =====================================================================
   200                              <1> ; bu_setup -- C009: AMI's page has filled and normalised its buffer
   201                              <1> ; =====================================================================
   202                              <1> bu_setup:
   203 0000132B FC                  <1>     cld
   204 0000132C E8(CFD0)            <1>     call A_UNHOOK                  ; AMI's calendar clock and video hooks off
   205 0000132F B00B                <1>     mov  al, 0x0B                  ; and the RTC running again (AMI's page
   206 00001331 E8(9FEE)            <1>     call A_CMOSRD                  ; set the SET bit, 0Bh = 82h)
   207 00001334 247F                <1>     and  al, 0x7F
   208 00001336 88C4                <1>     mov  ah, al
   209 00001338 B00B                <1>     mov  al, 0x0B
