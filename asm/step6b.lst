   280 00001399 1F                  <1>     pop  ds
   281 0000139A A06500              <1>     mov  al, [0x65]
   282 0000139D 24F7                <1>     and  al, 0xF7                  ; video off
   283 0000139F 84DB                <1>     test bl, bl
   284 000013A1 7402                <1>     jz   .mc1
