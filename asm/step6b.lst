   354 0000014E 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   355 00000153 753B                <1>     jne  .out
   356 00000155 800EFB0008          <1>     or   byte [ST_MISC], M_DEL
   357 0000015A C706FC00[C510]      <1>     mov  word [ST_STAT], s_st_setup
   358 00000160 EB2E                <1>     jmp  short .out
   359                              <1> .real:
