   280 000011B1 1F                  <1>     pop  ds
   281 000011B2 A06500              <1>     mov  al, [0x65]
   282 000011B5 24F7                <1>     and  al, 0xF7                  ; video off
   283 000011B7 84DB                <1>     test bl, bl
   284 000011B9 7402                <1>     jz   .mc1
