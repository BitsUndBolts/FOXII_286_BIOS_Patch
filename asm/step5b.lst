  1257                              <1> ; =====================================================================
  1258                              <1> ; measurements and probes
  1259                              <1> ; =====================================================================
  1260                              <1> ; measure_clock -> [ST_MHZ]: 250 passes of 32 x DIV BX + LOOP, built at
  1261                              <1> ; 0:7C00 (RAM: the ROM has wait states) and timed by PIT channel 2.
  1262                              <1> ; 80286: DIV r16 22 clocks, LOOP 8 + the queue refill (2 bytes): 714 per
  1263                              <1> ; pass. Shown only within 1/16 of a standard clock.
  1264                              <1> measure_clock:
  1265 00000867 06                  <1>     push es
  1266 00000868 6A00                <1>     push 0
  1267 0000086A 07                  <1>     pop  es
  1268 0000086B BF007C              <1>     mov  di, TLOOP
  1269 0000086E BE[F108]            <1>     mov  si, tl_head
  1270 00000871 B90B00              <1>     mov  cx, tl_head_end - tl_head
  1271 00000874 F32EA4              <1>     rep  cs movsb
  1272 00000877 B8F7F3              <1>     mov  ax, 0xF3F7                ; 32 x DIV BX
  1273 0000087A B92000              <1>     mov  cx, 32
  1274 0000087D F3AB                <1>     rep  stosw
  1275 0000087F B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV (-66)
  1276 00000882 AB                  <1>     stosw
  1277 00000883 B0CB                <1>     mov  al, 0xCB                  ; RETF
  1278 00000885 AA                  <1>     stosb
  1279 00000886 07                  <1>     pop  es
  1280 00000887 9C                  <1>     pushf
  1281 00000888 FA                  <1>     cli
  1282 00000889 E461                <1>     in   al, 0x61
  1283 0000088B 50                  <1>     push ax
  1284 0000088C 24FC                <1>     and  al, 0xFC
  1285 0000088E E661                <1>     out  0x61, al
  1286 00000890 B0B0                <1>     mov  al, 0xB0                  ; channel 2, mode 0, 16 bits
  1287 00000892 E643                <1>     out  0x43, al
  1288 00000894 B0FF                <1>     mov  al, 0xFF
  1289 00000896 E642                <1>     out  0x42, al
  1290 00000898 E642                <1>     out  0x42, al
  1291 0000089A E461                <1>     in   al, 0x61
  1292 0000089C 0C01                <1>     or   al, 1                     ; gate on, speaker off
  1293 0000089E E661                <1>     out  0x61, al
  1294 000008A0 9A007C0000          <1>     call 0:TLOOP
  1295 000008A5 B080                <1>     mov  al, 0x80                  ; latch channel 2
  1296 000008A7 E643                <1>     out  0x43, al
  1297 000008A9 E442                <1>     in   al, 0x42
  1298 000008AB 88C4                <1>     mov  ah, al
  1299 000008AD E442                <1>     in   al, 0x42
  1300 000008AF 86C4                <1>     xchg al, ah
  1301 000008B1 F7D0                <1>     not  ax                        ; elapsed ticks
  1302 000008B3 91                  <1>     xchg ax, cx
  1303 000008B4 58                  <1>     pop  ax
  1304 000008B5 E661                <1>     out  0x61, al
  1305 000008B7 9D                  <1>     popf
