   202                              <1> bu_setup:
   203 00001327 FC                  <1>     cld
   204 00001328 E8(CFD0)            <1>     call A_UNHOOK                  ; AMI's calendar clock and video hooks off
   205 0000132B B00B                <1>     mov  al, 0x0B                  ; and the RTC running again (AMI's page
   206 0000132D E8(9FEE)            <1>     call A_CMOSRD                  ; set the SET bit, 0Bh = 82h)
