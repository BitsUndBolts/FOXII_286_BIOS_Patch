  2309                              <1> post_end:
    20                                  %include "setup.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  Round 6a: the setup of BUBios/286, the boot order and the
     3                              <1> ;  auto-detect switch
     4                              <1> ;
     5                              <1> ;  AMI's setup code still prepares and saves (docs/DEVELOPMENT_LOG.md,
     6                              <1> ;  round 6a): BCA6 builds the stack frame and reads CMOS 10h-3Fh into
     7                              <1> ;  [BP+10h..3Fh]; AMI's page code (BD61-C006) normalises that buffer; at
     8                              <1> ;  C009, where AMI's editing loop began, bu_setup takes over. Every option
     9                              <1> ;  edits AMI's buffer with AMI's encodings. Save: JMP C0A0 (AMI writes
    10                              <1> ;  CMOS 10h-3Fh, the checksum, clears 0Eh/0Fh and restarts). Exit without
    11                              <1> ;  saving: JMP BD4D (AMI's menu exit back to POST).
    12                              <1> ;
    13                              <1> ;  py/build.py patches:
    14                              <1> ;    BCFC  MOV AL,CS:[E058] (the menu)        -> JMP BD61 (the page)
    15                              <1> ;    C009  MOV BX,CA53 / JMP C011             -> JMP bu_setup
    16                              <1> ;    9447  CALL autodet (Step 3)              -> CALL autodet_sw
    17                              <1> ;    8F9B  XOR DX,DX / XOR AX,AX / INT 13h / CALL 9005 (A:) -> CALL boot_seq
    18                              <1> ;
    19                              <1> ;  New settings: CMOS 3Eh, check byte 3Fh = 3Eh XOR A5h (else defaults):
    20                              <1> ;    bits 1-0 boot order (0 A: C:, 1 C: A:, 2 C: only), bit 2 auto-detect
    21                              <1> ;    off, bits 6-4 colour scheme.
    22                              <1> ; =====================================================================
    23                              <1> 
    24                              <1> A_CMOSWR   equ 0xEEAE     ; AL = index, AH = value
    25                              <1> A_SAVE     equ 0xC0A0     ; AMI's save: CMOS from [BP+10h..], checksum, restart
    26                              <1> A_EXIT     equ 0xBD4D     ; AMI's menu exit: cursor, stack frame, RET to POST
    27                              <1> A_UNHOOK   equ 0xD0CF     ; AMI's setup hooks of INT 10h/1Ah/1Ch off (its calendar clock)
    28                              <1> A_READ1    equ 0x9005     ; INT 19h: read sector 1 of DL, head DH, 4 tries (CX = 0: failed)
    29                              <1> A_BOOTGO   equ 0x8FEE     ; INT 19h: jump to 0:7C00
    30                              <1> A_INT19    equ 0x8F80     ; INT 19h from the start
    31                              <1> A_CRLF     equ 0x8D83
    32                              <1> A_PUTS     equ 0x8D75     ; CS:SI teletype
    33                              <1> CM_BUB     equ 0x3E
    34                              <1> CM_CHK     equ 0x3F
    35                              <1> BUB_KEY    equ 0xA5
    36                              <1> 
    37                              <1> ; setup state in AMI's frame (BP; [BP+10h..3Fh] is the CMOS buffer)
    38                              <1> F_TAB      equ 0
    39                              <1> F_FLD      equ 1          ; selected field (index into the table, 0FFh: none)
    40                              <1> F_EDIT     equ 2          ; digits typed so far (0: not typing)
    41                              <1> F_SEC      equ 3          ; RTC second last shown
    42                              <1> F_DIG      equ 4          ; 4..0Dh: the typed digits
    43                              <1> F_MSG      equ 0x0E       ; word: message for the help rows (0: the field's help)
    44                              <1> 
    45                              <1> NTABS      equ 6
    46                              <1> T_CHOICE   equ 1
    47                              <1> T_NUM      equ 2
    48                              <1> T_DATE     equ 3
    49                              <1> T_TIME     equ 4
    50                              <1> T_ACT      equ 5
    51                              <1> T_HDT      equ 6
    52                              <1> T_EMS      equ 7
    53                              <1> F_PARAMC   equ 0x80       ; type flag: a C: type-47 parameter (editable only with type 47)
    54                              <1> F_PARAMD   equ 0x40       ; type flag: a D: type-47 parameter
    55                              <1> F_MIN1     equ 0x20       ; type flag: the number is at least 1
    56                              <1> 
    57                              <1> R_TABS     equ 1
    58                              <1> R_TOP      equ 3
    59                              <1> R_LINE2    equ 21
    60                              <1> R_HELP     equ 22
    61                              <1> R_KEYS     equ 24
    62                              <1> C_SLBL     equ 3
    63                              <1> C_SVAL     equ 28
    64                              <1> 
    65                              <1> ; ---------------------------------------------------------------------
    66                              <1> ; bub_cfg -> AL = the BUBios settings byte (CMOS 3Eh), 0 if its check
    67                              <1> ; byte (3Fh) does not match. Other registers kept.
    68                              <1> ; ---------------------------------------------------------------------
    69                              <1> bub_cfg:
    70 0000127A 53                  <1>     push bx
    71 0000127B B03F                <1>     mov  al, CM_CHK
    72 0000127D E8(9FEE)            <1>     call A_CMOSRD
    73 00001280 88C3                <1>     mov  bl, al
    74 00001282 B03E                <1>     mov  al, CM_BUB
    75 00001284 E8(9FEE)            <1>     call A_CMOSRD
    76 00001287 80F3A5              <1>     xor  bl, BUB_KEY
    77 0000128A 38D8                <1>     cmp  al, bl
    78 0000128C 7402                <1>     je   .ok
    79 0000128E 30C0                <1>     xor  al, al
    80 00001290 5B                  <1> .ok:pop  bx
    81 00001291 C3                  <1>     ret
    82                              <1> 
    83                              <1> ; ---------------------------------------------------------------------
    84                              <1> ; autodet_sw -- 9447 (checkpoint 75h), in place of Step 3's CALL autodet:
    85                              <1> ; "Auto-Detect Disks at Boot" On -> autodet (0.7.3: autodet_all), Off ->
    86                              <1> ; drives12 (no IDENTIFY, but a configured drive that does not answer is
    87                              <1> ; still left out).
    88                              <1> ; Keeps every register except AL, as both of Step 3's entries do.
    89                              <1> ; ---------------------------------------------------------------------
    90                              <1> autodet_sw:
    91 00001292 50                  <1>     push ax
    92 00001293 E8E4FF              <1>     call bub_cfg
    93 00001296 A804                <1>     test al, 4
    94 00001298 58                  <1>     pop  ax
    95 00001299 7506                <1>     jnz  .off
    96                              <1> %ifdef ROUND6B
    97 0000129B E80600              <1>     call autodet_all               ; 0.7.3: every drive, as BUBios (SOYO)
    98                              <1> %else
    99                              <1>     call autodet                   ; AL = CMOS 12h, the only result 944C uses
   100                              <1> %endif
   101 0000129E E954F0              <1>     jmp  adet_drawn                ; the POST screen's disk rows at once
   102                              <1> .off:
   103 000012A1 E9(2800)            <1>     jmp  drives12
   104                              <1> 
   105                              <1> %ifdef ROUND6B
   106                              <1> ; ---------------------------------------------------------------------
   107                              <1> ; autodet_all -- 0.7.3, Auto-Detect On: IDENTIFY DEVICE to C: and D:,
   108                              <1> ; whatever CMOS says (Step 3's autodet asks only drives set to "Not
   109                              <1> ; installed"). A drive that answers with a valid geometry is written as
   110                              <1> ; type 47 with it (Step 3's set47, checksum included), unless CMOS already
   111                              <1> ; holds type 47 with exactly that cylinders/heads/sectors: then nothing
   112                              <1> ; is written. As BUBios's auto_set on the SOYO. A drive that does not
   113                              <1> ; answer, or answers but fails IDENTIFY (ATAPI, a geometry out of range),
   114                              <1> ; keeps its CMOS entry. Then drives12, as autodet: AL = CMOS 12h without
   115                              <1> ; the drives that are gone. Keeps every register except AL.
   116                              <1> ; ---------------------------------------------------------------------
   117                              <1> autodet_all:
   118 000012A4 FB                  <1>     sti                            ; (already on: the tick counter must run)
   119 000012A5 60                  <1>     pusha
   120 000012A6 1E                  <1>     push ds
   121 000012A7 6A40                <1>     push 0x40
   122 000012A9 1F                  <1>     pop  ds
   123 000012AA 31DB                <1>     xor  bx, bx                    ; BL = 0: C:, then 1: D:
   124                              <1> .drive:
   125 000012AC E8(0000)            <1>     call identify                  ; CF = 0: CX/DL/DH (BH changed, BL kept)
   126 000012AF 7208                <1>     jc   .next
   127 000012B1 E81100              <1>     call same47
   128 000012B4 7403                <1>     je   .next                     ; CMOS already says so: no write
   129 000012B6 E8(7300)            <1>     call set47
   130                              <1> .next:
   131 000012B9 FEC3                <1>     inc  bl
   132 000012BB 80FB02              <1>     cmp  bl, 2
   133 000012BE 72EC                <1>     jb   .drive
   134 000012C0 1F                  <1>     pop  ds
   135 000012C1 61                  <1>     popa
   136 000012C2 E9(2800)            <1>     jmp  drives12
   137                              <1> 
   138                              <1> ; same47 -- BL = drive, CX/DL/DH = cylinders/heads/sectors: ZF = 1 if CMOS
   139                              <1> ; holds type 47 for that drive with exactly this geometry. AX changed.
   140                              <1> same47:
   141 000012C5 B012                <1>     mov  al, 0x12
   142 000012C7 E8(9FEE)            <1>     call CMOS_RD
   143 000012CA 08DB                <1>     or   bl, bl
   144 000012CC 7503                <1>     jnz  .lo
   145 000012CE C0E804              <1>     shr  al, 4
   146 000012D1 240F                <1> .lo:and  al, 0x0F
   147 000012D3 3C0F                <1>     cmp  al, 0x0F                  ; the extended type byte is used
   148 000012D5 753B                <1>     jne  .r
   149 000012D7 B019                <1>     mov  al, 0x19
   150 000012D9 00D8                <1>     add  al, bl
   151 000012DB E8(9FEE)            <1>     call CMOS_RD
   152 000012DE 3C2F                <1>     cmp  al, 47
   153 000012E0 7530                <1>     jne  .r
   154 000012E2 B41B                <1>     mov  ah, 0x1B                  ; C: 1Bh-23h, D: 24h-2Ch
   155 000012E4 08DB                <1>     or   bl, bl
   156 000012E6 7402                <1>     jz   .p
   157 000012E8 B424                <1>     mov  ah, 0x24
   158 000012EA 88E0                <1> .p: mov  al, ah
   159 000012EC E8(9FEE)            <1>     call CMOS_RD                   ; +0/+1 cylinders
   160 000012EF 38C8                <1>     cmp  al, cl
   161 000012F1 751F                <1>     jne  .r
   162 000012F3 88E0                <1>     mov  al, ah
   163 000012F5 FEC0                <1>     inc  al
   164 000012F7 E8(9FEE)            <1>     call CMOS_RD
   165 000012FA 38E8                <1>     cmp  al, ch
   166 000012FC 7514                <1>     jne  .r
   167 000012FE 88E0                <1>     mov  al, ah
   168 00001300 0402                <1>     add  al, 2
   169 00001302 E8(9FEE)            <1>     call CMOS_RD                   ; +2 heads
   170 00001305 38D0                <1>     cmp  al, dl
   171 00001307 7509                <1>     jne  .r
   172 00001309 88E0                <1>     mov  al, ah
   173 0000130B 0408                <1>     add  al, 8
   174 0000130D E8(9FEE)            <1>     call CMOS_RD                   ; +8 sectors
   175 00001310 38F0                <1>     cmp  al, dh
   176 00001312 C3                  <1> .r: ret
   177                              <1> %endif
   178                              <1> 
   179                              <1> ; ---------------------------------------------------------------------
   180                              <1> ; boot_seq -- 8F9B (INT 19h, ES = 0, BX = 7C00h), in place of the A:
   181                              <1> ; attempt (XOR DX,DX / XOR AX,AX / INT 13h / CALL 9005). Returns to
   182                              <1> ; 8F9E (NOPs, then 8FA4: AMI's A: result) like the CALL 9005 it ends with.
   183                              <1> ; ---------------------------------------------------------------------
   184                              <1> boot_seq:
   185                              <1> %ifdef ROUND6B
   186 00001313 E85400              <1>     call bk_order                  ; the order, or the boot key's drive
   187                              <1> %else
   188                              <1>     call bub_cfg
   189                              <1>     and  al, 3
   190                              <1> %endif
   191 00001316 7429                <1>     jz   .a                        ; A: then C: (AMI's own order)
   192 00001318 50                  <1>     push ax
   193 00001319 B00E                <1>     mov  al, 0x0E                  ; as AMI's C: path (8FB1): no C: when the
   194 0000131B E8(9FEE)            <1>     call A_CMOSRD                  ; fixed-disk setup failed in POST
   195 0000131E A808                <1>     test al, 8
   196 00001320 751A                <1>     jnz  .cno
   197 00001322 BA8000              <1>     mov  dx, 0x0080                ; C:, head 0
   198 00001325 E8(0590)            <1>     call A_READ1
   199 00001328 E312                <1>     jcxz .cno
   200 0000132A 7210                <1>     jc   .cno
   201 0000132C 2681BFFE0155AA      <1>     cmp  word [es:bx + 0x1FE], 0xAA55
   202 00001333 7507                <1>     jne  .cno
   203 00001335 58                  <1>     pop  ax
   204 00001336 83C402              <1>     add  sp, 2                     ; (our return address)
   205 00001339 E9(EE8F)            <1>     jmp  A_BOOTGO                  ; DL = 80h
   206                              <1> .cno:
   207 0000133C 58                  <1>     pop  ax
   208 0000133D 3C02                <1>     cmp  al, 2
   209 0000133F 7409                <1>     je   .conly
   210 00001341 31D2                <1> .a: xor  dx, dx                    ; A:, as the original
   211 00001343 31C0                <1>     xor  ax, ax
   212 00001345 CD13                <1>     int  0x13
   213 00001347 E9(0590)            <1>     jmp  A_READ1
   214                              <1> .conly:                            ; C: only and C: did not boot: say so,
   215 0000134A 83C402              <1>     add  sp, 2                     ; wait for a key, INT 19h again
   216 0000134D FB                  <1>     sti
   217 0000134E E8(838D)            <1>     call A_CRLF
   218 00001351 BE[BE13]            <1>     mov  si, s_conly
   219 00001354 E8(758D)            <1>     call A_PUTS
   220 00001357 E8(838D)            <1>     call A_CRLF
   221 0000135A BE[F613]            <1>     mov  si, s_anykey
   222 0000135D E8(758D)            <1>     call A_PUTS
   223 00001360 30E4                <1>     xor  ah, ah
   224 00001362 CD16                <1>     int  0x16
   225 00001364 E8(838D)            <1>     call A_CRLF
   226 00001367 E9(808F)            <1>     jmp  A_INT19
   227                              <1> 
   228                              <1> %ifdef ROUND6B
   229                              <1> ; bk_order -> AL = the boot order for this boot (0 A: C:, 1 C: A:, 2 C:
   230                              <1> ; only), ZF = 1 for 0: setup's, or for a boot key A: 0, C: 1. The key is
   231                              <1> ; taken from 40:FF (noted during POST) or the keyboard buffer (typed from
   232                              <1> ; checkpoint 7Fh on; the buffer is emptied then, so DOS does not get it),
   233                              <1> ; and 40:FF cleared. Other registers kept.
   234                              <1> bk_order:
   235 0000136A 56                  <1>     push si
   236 0000136B 1E                  <1>     push ds
   237 0000136C 6A40                <1>     push 0x40
   238 0000136E 1F                  <1>     pop  ds
   239 0000136F A0FF00              <1>     mov  al, [ST_BOOTK]
   240 00001372 C606FF0000          <1>     mov  byte [ST_BOOTK], 0
   241 00001377 8B361A00            <1>     mov  si, [0x1A]
   242 0000137B 3B361C00            <1> .l: cmp  si, [0x1C]
   243 0000137F 7425                <1>     je   .e
   244 00001381 807C011E            <1>     cmp  byte [si + 1], 0x1E
   245 00001385 7412                <1>     je   .f
   246 00001387 807C012E            <1>     cmp  byte [si + 1], 0x2E
   247 0000138B 740C                <1>     je   .f
   248 0000138D 46                  <1>     inc  si
   249 0000138E 46                  <1>     inc  si
   250 0000138F 83FE3E              <1>     cmp  si, 0x3E
   251 00001392 72E7                <1>     jb   .l
   252 00001394 BE1E00              <1>     mov  si, 0x1E
   253 00001397 EBE2                <1>     jmp  short .l
   254 00001399 8A4401              <1> .f: mov  al, [si + 1]
   255 0000139C FA                  <1>     cli
   256 0000139D 8B361C00            <1>     mov  si, [0x1C]                ; the buffer emptied
   257 000013A1 89361A00            <1>     mov  [0x1A], si
   258 000013A5 FB                  <1>     sti
   259 000013A6 1F                  <1> .e: pop  ds
   260 000013A7 5E                  <1>     pop  si
   261 000013A8 3C1E                <1>     cmp  al, 0x1E
   262 000013AA 740A                <1>     je   .a
   263 000013AC 3C2E                <1>     cmp  al, 0x2E
   264 000013AE 7409                <1>     je   .c
   265 000013B0 E8C7FE              <1>     call bub_cfg
   266 000013B3 2403                <1>     and  al, 3
   267 000013B5 C3                  <1>     ret
   268 000013B6 30C0                <1> .a: xor  al, al                    ; (ZF = 1)
   269 000013B8 C3                  <1>     ret
   270 000013B9 B001                <1> .c: mov  al, 1
   271 000013BB 08C0                <1>     or   al, al                    ; (ZF = 0)
   272 000013BD C3                  <1>     ret
   273                              <1> %endif
