  1187 000007C1 B2F7                <1>     mov  dl, 0xF7
  1188 000007C3 EC                  <1>     in   al, dx
  1189 000007C4 BD0000              <1>     mov  bp, D_NONE
  1190 000007C7 3CFF                <1>     cmp  al, 0xFF                  ; nothing on the bus
  1191 000007C9 7503E9B500          <1>     je   .end
  1192 000007CE 3C7F                <1>     cmp  al, 0x7F
  1193 000007D0 7503E9AE00          <1>     je   .end
