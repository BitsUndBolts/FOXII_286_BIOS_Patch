   310 0000014E 800EFB0001          <1>     or   byte [ST_MISC], 1         ; redrawn: the POST time would include setup
   311 00000153 8026FB00FD          <1>     and  byte [ST_MISC], 0xFD      ; (and AMI's messages are gone)
   312 00000158 B40F                <1>     mov  ah, 0x0F
   313 0000015A CD10                <1>     int  0x10
