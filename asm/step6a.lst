   278                              <1> ; =====================================================================
   279                              <1> ; bu_setup -- C009: AMI's page has filled and normalised its buffer
   280                              <1> ; =====================================================================
   281                              <1> bu_setup:
   282 0000113F FC                  <1>     cld
   283 00001140 E8(CFD0)            <1>     call A_UNHOOK                  ; AMI's calendar clock and video hooks off
   284 00001143 B00B                <1>     mov  al, 0x0B                  ; and the RTC running again (AMI's page
   285 00001145 E8(9FEE)            <1>     call A_CMOSRD                  ; set the SET bit, 0Bh = 82h)
   286 00001148 247F                <1>     and  al, 0x7F
   287 0000114A 88C4                <1>     mov  ah, al
   288 0000114C B00B                <1>     mov  al, 0x0B
   289 0000114E E8(AEEE)            <1>     call A_CMOSWR
   290 00001151 FB                  <1>     sti
   291 00001152 6A40                <1>     push 0x40
   292 00001154 1F                  <1>     pop  ds
   293 00001155 31C0                <1>     xor  ax, ax
   294 00001157 884600              <1>     mov  [bp + F_TAB], al          ; Summary first
   295 0000115A 884602              <1>     mov  [bp + F_EDIT], al
   296 0000115D 89460E              <1>     mov  [bp + F_MSG], ax
   297 00001160 C64601FF            <1>     mov  byte [bp + F_FLD], 0xFF
   298 00001164 C64603FF            <1>     mov  byte [bp + F_SEC], 0xFF
   299 00001168 E86408              <1>     call s_redraw
   300 0000116B B001                <1>     mov  al, 1                     ; the display on again (setup_dark), with
   301 0000116D E81D00              <1>     call v_screen                  ; the Summary page already drawn
   302                              <1> .loop:
   303 00001170 E88A04              <1>     call s_tick
   304 00001173 B401                <1>     mov  ah, 1
   305 00001175 CD16                <1>     int  0x16
   306 00001177 74F7                <1>     jz   .loop
   307 00001179 30E4                <1>     xor  ah, ah
   308 0000117B CD16                <1>     int  0x16
   309 0000117D E84F00              <1>     call s_key
   310 00001180 EBEE                <1>     jmp  short .loop
   311                              <1> 
   312                              <1> ; ---------------------------------------------------------------------
   313                              <1> ; setup_dark -- BD69, right after the mode set of AMI's page code (BD61).
   314                              <1> ; AMI's page code draws its whole page before C009 (bu_setup); on the
   315                              <1> ; board it showed for a moment. The display is switched off here and on
   316                              <1> ; again in bu_setup once the Summary page is drawn. Replaces CLI / CLD /
   317                              <1> ; MOV AX,268Ah (AX is AMI's next CMOS write); other registers kept.
   318                              <1> ; ---------------------------------------------------------------------
   319                              <1> setup_dark:
   320 00001182 30C0                <1>     xor  al, al
   321 00001184 E80600              <1>     call v_screen
   322 00001187 FA                  <1>     cli
   323 00001188 FC                  <1>     cld
   324 00001189 B88A26              <1>     mov  ax, 0x268A
   325 0000118C C3                  <1>     ret
   326                              <1> 
   327                              <1> ; ---------------------------------------------------------------------
   328                              <1> ; v_screen -- the display off (AL = 0) or on (AL <> 0); all registers
   329                              <1> ; kept. VGA (INT 10h AX=1A00h answers 1Ah): sequencer register 1 bit 5
   330                              <1> ; (Screen Off; a mode set clears it). MDA / CGA: the mode control
   331                              <1> ; register (3B8h / 3D8h) bit 3 (video enable), from the BIOS's copy of
   332                              <1> ; it at 40:65. An EGA ignores 3D8h, so there the page still shows.
   333                              <1> ; ---------------------------------------------------------------------
   334                              <1> v_screen:
   335 0000118D 50                  <1>     push ax
   336 0000118E 53                  <1>     push bx
   337 0000118F 52                  <1>     push dx
   338 00001190 1E                  <1>     push ds
   339 00001191 50                  <1>     push ax
   340 00001192 B8001A              <1>     mov  ax, 0x1A00
   341 00001195 CD10                <1>     int  0x10
   342 00001197 5B                  <1>     pop  bx                        ; BL = AL on entry
   343 00001198 3C1A                <1>     cmp  al, 0x1A
   344 0000119A 7513                <1>     jne  .mc
   345 0000119C BAC403              <1>     mov  dx, 0x3C4
   346 0000119F B001                <1>     mov  al, 1
   347 000011A1 EE                  <1>     out  dx, al
   348 000011A2 42                  <1>     inc  dx
   349 000011A3 EC                  <1>     in   al, dx
   350 000011A4 0C20                <1>     or   al, 0x20                  ; Screen Off
   351 000011A6 84DB                <1>     test bl, bl
   352 000011A8 7402                <1>     jz   .vga
   353 000011AA 24DF                <1>     and  al, 0xDF                  ; Screen On
   354                              <1> .vga:
   355 000011AC EE                  <1>     out  dx, al
   356 000011AD EB1B                <1>     jmp  short .done
   357                              <1> .mc:
   358 000011AF 6A40                <1>     push 0x40
   359 000011B1 1F                  <1>     pop  ds
   360 000011B2 A06500              <1>     mov  al, [0x65]
   361 000011B5 24F7                <1>     and  al, 0xF7                  ; video off
   362 000011B7 84DB                <1>     test bl, bl
   363 000011B9 7402                <1>     jz   .mc1
   364 000011BB 0C08                <1>     or   al, 0x08                  ; video on
