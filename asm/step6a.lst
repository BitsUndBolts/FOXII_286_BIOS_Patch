   279                              <1> %ifdef ROUND6A
   280                              <1> ; ---------------------------------------------------------------------
   281                              <1> ; DEL feedback. AMI decides on setup at checkpoint 7Fh (9550): it empties
   282                              <1> ; the keyboard buffer and looks for scan code 53h. During the memory test
   283                              <1> ; it reads port 60h itself and throws every key but ESC away (AC2A, AC3A,
   284                              <1> ; AC8E), so a DEL pressed then was lost. Now:
   285                              <1> ;  - memory test: kbd_poll replaces those reads and notes a DEL;
   286                              <1> ;  - checkpoints 73h-7Fh (the keyboard interrupt fills the buffer, the
   287                              <1> ;    timer runs): bu_tick on INT 1Ch looks into the buffer every tick;
   288                              <1> ;  - checkpoint 7Fh (del_7f, before AMI empties the buffer): INT 1Ch back
   289                              <1> ;    to AMI's IRET, and a DEL noted earlier is put into the buffer, so
   290                              <1> ;    AMI enters setup as for a DEL typed in its window.
   291                              <1> ; The status bar says "Entering Setup" from the moment DEL is seen.
   292                              <1> ; ---------------------------------------------------------------------
   293                              <1> INT1C_DEF  equ 0xFF53     ; AMI's INT 1Ch at checkpoint 73h: F000:FF53 (IRET)
   294                              <1> 
   295                              <1> ; kbd_poll -- AL = port 60h, as the IN AL,60h it replaces (AC2A, AC8E;
   296                              <1> ; AC3A through bu_memkey); a DEL (make code 53h, read while the KBC's
   297                              <1> ; output buffer was full) is noted. Other registers kept; flags changed
   298                              <1> ; (no caller uses them after the IN).
   299                              <1> kbd_poll:
   300 0000010F E464                <1>     in   al, 0x64
   301 00000111 A801                <1>     test al, 1
   302 00000113 E460                <1>     in   al, 0x60
   303 00000115 7407                <1>     jz   .r
   304 00000117 3C53                <1>     cmp  al, 0x53
   305 00000119 7503                <1>     jne  .r
   306 0000011B E80700              <1>     call del_seen
   307 0000011E C3                  <1> .r: ret
   308                              <1> 
   309                              <1> bu_memkey:                         ; AC3A: IN AL,60h / CMP AL,1 (ESC?)
   310 0000011F E8EDFF              <1>     call kbd_poll
   311 00000122 3C01                <1>     cmp  al, 1
   312 00000124 C3                  <1>     ret
   313                              <1> 
   314                              <1> ; del_seen -- note DEL and show "Entering Setup" (once). Safe in an
   315                              <1> ; interrupt: no CMOS, no INT 10h. All registers kept. AMI's memory test
   316                              <1> ; runs in protected mode: there selector 18h is the BIOS data area (base
   317                              <1> ; 400h in AMI's GDT at 0:0600) and the screen cannot be reached, so only
   318                              <1> ; the note is made; bu_mem shows it after the CPU is back in real mode.
   319                              <1> del_seen:
   320 00000125 60                  <1>     pusha
   321 00000126 1E                  <1>     push ds
   322 00000127 06                  <1>     push es
   323 00000128 0F01E0              <1>     smsw ax
   324 0000012B A801                <1>     test al, 1
   325 0000012D 7417                <1>     jz   .real
   326 0000012F 6A18                <1>     push 0x18
   327 00000131 1F                  <1>     pop  ds
   328 00000132 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   329 00000137 753B                <1>     jne  .out
   330 00000139 800EFB0008          <1>     or   byte [ST_MISC], M_DEL
   331 0000013E C706FC00[1C0F]      <1>     mov  word [ST_STAT], s_st_setup
   332 00000144 EB2E                <1>     jmp  short .out
   333                              <1> .real:
   334 00000146 6A40                <1>     push 0x40
   335 00000148 1F                  <1>     pop  ds
   336 00000149 FC                  <1>     cld
   337 0000014A 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   338 0000014F 7523                <1>     jne  .out
   339 00000151 F606FB0008          <1>     test byte [ST_MISC], M_DEL
   340 00000156 751C                <1>     jnz  .out
   341 00000158 800EFB0008          <1>     or   byte [ST_MISC], M_DEL
   342 0000015D C706FC00[1C0F]      <1>     mov  word [ST_STAT], s_st_setup
   343 00000163 B800B8              <1>     mov  ax, 0xB800                ; ST_SCH was set when the screen was drawn
   344 00000166 803E490007          <1>     cmp  byte [0x49], 7
   345 0000016B 7502                <1>     jne  .v
   346 0000016D B4B0                <1>     mov  ah, 0xB0
   347 0000016F 8EC0                <1> .v: mov  es, ax
   348 00000171 E87303              <1>     call draw_status
   349                              <1> .out:
   350 00000174 07                  <1>     pop  es
   351 00000175 1F                  <1>     pop  ds
   352 00000176 61                  <1>     popa
   353 00000177 C3                  <1>     ret
