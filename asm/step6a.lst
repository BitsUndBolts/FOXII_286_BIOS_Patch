  1559 00000A4B B92000              <1>     mov  cx, 32
  1560 00000A4E F3AB                <1>     rep  stosw
  1561 00000A50 B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV (-66)
  1562 00000A53 AB                  <1>     stosw
