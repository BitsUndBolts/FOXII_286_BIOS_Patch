    65                              <1> ; ---------------------------------------------------------------------
    66                              <1> ; bub_cfg -> AL = the BUBios settings byte (CMOS 3Eh), 0 if its check
    67                              <1> ; byte (3Fh) does not match. Other registers kept.
    68                              <1> ; ---------------------------------------------------------------------
    69                              <1> bub_cfg:
    70 00001066 53                  <1>     push bx
    71 00001067 B03F                <1>     mov  al, CM_CHK
    72 00001069 E8(9FEE)            <1>     call A_CMOSRD
    73 0000106C 88C3                <1>     mov  bl, al
    74 0000106E B03E                <1>     mov  al, CM_BUB
    75 00001070 E8(9FEE)            <1>     call A_CMOSRD
    76 00001073 80F3A5              <1>     xor  bl, BUB_KEY
    77 00001076 38D8                <1>     cmp  al, bl
    78 00001078 7402                <1>     je   .ok
    79 0000107A 30C0                <1>     xor  al, al
    80 0000107C 5B                  <1> .ok:pop  bx
    81 0000107D C3                  <1>     ret
    82                              <1> 
    83                              <1> ; ---------------------------------------------------------------------
    84                              <1> ; autodet_sw -- 9447 (checkpoint 75h), in place of Step 3's CALL autodet:
    85                              <1> ; "Auto-Detect Disks at Boot" On -> autodet, Off -> drives12 (no IDENTIFY,
    86                              <1> ; but a configured drive that does not answer is still left out).
    87                              <1> ; Keeps every register except AL, as both of Step 3's entries do.
    88                              <1> ; ---------------------------------------------------------------------
    89                              <1> autodet_sw:
    90 0000107E 50                  <1>     push ax
    91 0000107F E8E4FF              <1>     call bub_cfg
    92 00001082 A804                <1>     test al, 4
    93 00001084 58                  <1>     pop  ax
    94 00001085 7506                <1>     jnz  .off
    95 00001087 E8(0000)            <1>     call autodet                   ; AL = CMOS 12h, the only result 944C uses
    96 0000108A E9B2F1              <1>     jmp  adet_drawn                ; the POST screen's disk rows at once
    97                              <1> .off:
    98 0000108D E9(2800)            <1>     jmp  drives12
    99                              <1> 
   100                              <1> ; ---------------------------------------------------------------------
   101                              <1> ; boot_seq -- 8F9B (INT 19h, ES = 0, BX = 7C00h), in place of the A:
   102                              <1> ; attempt (XOR DX,DX / XOR AX,AX / INT 13h / CALL 9005). Returns to
   103                              <1> ; 8F9E (NOPs, then 8FA4: AMI's A: result) like the CALL 9005 it ends with.
   104                              <1> ; ---------------------------------------------------------------------
   105                              <1> boot_seq:
   106                              <1> %ifdef ROUND6B
   107                              <1>     call bk_order                  ; the order, or the boot key's drive
   108                              <1> %else
   109 00001090 E8D3FF              <1>     call bub_cfg
   110 00001093 2403                <1>     and  al, 3
   111                              <1> %endif
   112 00001095 7429                <1>     jz   .a                        ; A: then C: (AMI's own order)
   113 00001097 50                  <1>     push ax
   114 00001098 B00E                <1>     mov  al, 0x0E                  ; as AMI's C: path (8FB1): no C: when the
   115 0000109A E8(9FEE)            <1>     call A_CMOSRD                  ; fixed-disk setup failed in POST
   116 0000109D A808                <1>     test al, 8
   117 0000109F 751A                <1>     jnz  .cno
   118 000010A1 BA8000              <1>     mov  dx, 0x0080                ; C:, head 0
   119 000010A4 E8(0590)            <1>     call A_READ1
   120 000010A7 E312                <1>     jcxz .cno
   121 000010A9 7210                <1>     jc   .cno
   122 000010AB 2681BFFE0155AA      <1>     cmp  word [es:bx + 0x1FE], 0xAA55
   123 000010B2 7507                <1>     jne  .cno
   124 000010B4 58                  <1>     pop  ax
   125 000010B5 83C402              <1>     add  sp, 2                     ; (our return address)
   126 000010B8 E9(EE8F)            <1>     jmp  A_BOOTGO                  ; DL = 80h
   127                              <1> .cno:
   128 000010BB 58                  <1>     pop  ax
   129 000010BC 3C02                <1>     cmp  al, 2
   130 000010BE 7409                <1>     je   .conly
   131 000010C0 31D2                <1> .a: xor  dx, dx                    ; A:, as the original
   132 000010C2 31C0                <1>     xor  ax, ax
   133 000010C4 CD13                <1>     int  0x13
   134 000010C6 E9(0590)            <1>     jmp  A_READ1
   135                              <1> .conly:                            ; C: only and C: did not boot: say so,
   136 000010C9 83C402              <1>     add  sp, 2                     ; wait for a key, INT 19h again
   137 000010CC FB                  <1>     sti
   138 000010CD E8(838D)            <1>     call A_CRLF
   139 000010D0 BE[E910]            <1>     mov  si, s_conly
   140 000010D3 E8(758D)            <1>     call A_PUTS
   141 000010D6 E8(838D)            <1>     call A_CRLF
   142 000010D9 BE[2111]            <1>     mov  si, s_anykey
   143 000010DC E8(758D)            <1>     call A_PUTS
   144 000010DF 30E4                <1>     xor  ah, ah
   145 000010E1 CD16                <1>     int  0x16
   146 000010E3 E8(838D)            <1>     call A_CRLF
   147 000010E6 E9(808F)            <1>     jmp  A_INT19
   148                              <1> 
   149                              <1> %ifdef ROUND6B
   150                              <1> ; bk_order -> AL = the boot order for this boot (0 A: C:, 1 C: A:, 2 C:
   151                              <1> ; only), ZF = 1 for 0: setup's, or for a boot key A: 0, C: 1. The key is
   152                              <1> ; taken from 40:FF (noted during POST) or the keyboard buffer (typed from
   153                              <1> ; checkpoint 7Fh on; the buffer is emptied then, so DOS does not get it),
   154                              <1> ; and 40:FF cleared. Other registers kept.
   155                              <1> bk_order:
   156                              <1>     push si
   157                              <1>     push ds
   158                              <1>     push 0x40
   159                              <1>     pop  ds
   160                              <1>     mov  al, [ST_BOOTK]
   161                              <1>     mov  byte [ST_BOOTK], 0
   162                              <1>     mov  si, [0x1A]
   163                              <1> .l: cmp  si, [0x1C]
   164                              <1>     je   .e
   165                              <1>     cmp  byte [si + 1], 0x1E
   166                              <1>     je   .f
   167                              <1>     cmp  byte [si + 1], 0x2E
   168                              <1>     je   .f
   169                              <1>     inc  si
   170                              <1>     inc  si
   171                              <1>     cmp  si, 0x3E
   172                              <1>     jb   .l
   173                              <1>     mov  si, 0x1E
   174                              <1>     jmp  short .l
   175                              <1> .f: mov  al, [si + 1]
   176                              <1>     cli
   177                              <1>     mov  si, [0x1C]                ; the buffer emptied
   178                              <1>     mov  [0x1A], si
   179                              <1>     sti
   180                              <1> .e: pop  ds
   181                              <1>     pop  si
   182                              <1>     cmp  al, 0x1E
   183                              <1>     je   .a
   184                              <1>     cmp  al, 0x2E
   185                              <1>     je   .c
   186                              <1>     call bub_cfg
   187                              <1>     and  al, 3
   188                              <1>     ret
   189                              <1> .a: xor  al, al                    ; (ZF = 1)
   190                              <1>     ret
   191                              <1> .c: mov  al, 1
   192                              <1>     or   al, al                    ; (ZF = 0)
   193                              <1>     ret
   194                              <1> %endif
   195                              <1> 
