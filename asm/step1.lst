     1                                  ; Step 1 ROM: ECHS translation only (confirmed on the board 2026-11-19)
     2                                  BITS 16
     3                                  CPU 286             ; the FOX II is an 80286: any 386 instruction is an assembler error
     4                                  ORG 0xF537          ; free-space block F537-F83D in segment F000 (F83E: checksum word)
     5                                  
     6                                  %include "echs.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  ECHS (CHS translation) for the AMI 286 BIOS 06/13/90, Octek FOX II
     3                              <1> ;
     4                              <1> ;  A 286 port of the SOYO SY-019L1 patch (asm/xlate.asm there, v5,
     5                              <1> ;  confirmed on hardware). The algorithm, the five patch sites and their
     6                              <1> ;  contracts are the same; only the 32-bit arithmetic of xlate_headcyl
     7                              <1> ;  is redone in 16-bit pieces, because the 286 has no EAX/MOVZX/PUSHAD.
     8                              <1> ;
     9                              <1> ;  Drives up to 1024 x 255 x 63 x 512 = 8.42 GB (7.84 GiB) through
    10                              <1> ;  classic INT 13h CHS, instead of 1024 x 16 x 63 = 504 MB.
    11                              <1> ;
    12                              <1> ;  Reached from five patch sites (applied and asserted by py/build.py):
    13                              <1> ;    A357-A383   AH=08h reporting body -> CALL xlate_getparams / JMP A384
    14                              <1> ;    A65A        AND DH,0Fh            -> CALL xlate_headcyl
    15                              <1> ;    A30C, A4DF, A832  cylinder-high builders before OUT 1F5h
    16                              <1> ;                -> MOV AL,[BP+6] + NOP fill (the byte xlate_headcyl stores)
    17                              <1> ;  POST checkpoint 02 checksums 8000-FFFF: py/build.py balances it with
    18                              <1> ;  the word at F83E, the end of this block (docs/ROM_ANALYSIS.md 2b).
    19                              <1> ; =====================================================================
    20                              <1> 
    21                              <1> ; ---------------------------------------------------------------
    22                              <1> ; calc_factor
    23                              <1> ;   In:  AX = RealCyl, CX = RealHeads
    24                              <1> ;   Out: AX = TranslatedHeads: RealHeads * 2^n until the cylinders fit
    25                              <1> ;        in 1024, never more than 255 (16, 32, 64, 128, then 255).
    26                              <1> ;        256 heads breaks DOS (SOYO pitfall 9.6).
    27                              <1> ;   Preserves everything else.
    28                              <1> ; ---------------------------------------------------------------
    29                              <1> calc_factor:
    30 00000000 53                  <1>     push bx
    31 00000001 89C3                <1>     mov  bx, ax            ; bx = working cylinder count
    32 00000003 89C8                <1>     mov  ax, cx            ; ax = candidate head count
    33                              <1> .loop:
    34 00000005 81FB0004            <1>     cmp  bx, 1024
    35 00000009 760E                <1>     jbe  .done
    36 0000000B 83F87F              <1>     cmp  ax, 127
    37 0000000E 7706                <1>     ja   .max
    38 00000010 D1E0                <1>     shl  ax, 1
    39 00000012 D1EB                <1>     shr  bx, 1
    40 00000014 EBEF                <1>     jmp  .loop
    41                              <1> .max:
    42 00000016 B8FF00              <1>     mov  ax, 255
    43                              <1> .done:
    44 00000019 5B                  <1>     pop  bx
    45 0000001A C3                  <1>     ret
    46                              <1> 
    47                              <1> ; ---------------------------------------------------------------
    48                              <1> ; div32: DX:AX / CX  (CX != 0)
    49                              <1> ;   Out: DX:AX = quotient (32 bit), BX = remainder
    50                              <1> ;   A 286 DIV only takes a 16-bit quotient, so divide the high word
    51                              <1> ;   first and carry its remainder into the low word.
    52                              <1> ; ---------------------------------------------------------------
    53                              <1> div32:
    54 0000001B 50                  <1>     push ax
    55 0000001C 89D0                <1>     mov  ax, dx
    56 0000001E 31D2                <1>     xor  dx, dx
    57 00000020 F7F1                <1>     div  cx                ; ax = high quotient, dx = remainder
    58 00000022 89C3                <1>     mov  bx, ax
    59 00000024 58                  <1>     pop  ax
    60 00000025 F7F1                <1>     div  cx                ; ax = low quotient, dx = remainder
    61 00000027 87DA                <1>     xchg bx, dx            ; dx = high quotient, bx = remainder
    62 00000029 C3                  <1>     ret
    63                              <1> 
    64                              <1> ; ---------------------------------------------------------------
    65                              <1> ; xlate_getparams  (replaces the AH=08h reporting body A357-A383,
    66                              <1> ;                   which is byte-identical to the SOYO's A659-A685)
    67                              <1> ;   In:  ES:BX -> FDPT (+0 cylinders, +2 heads, +0Eh sectors)
    68                              <1> ;   Out: CH/CL/DH = translated geometry, AL = sectors per track.
    69                              <1> ;        The original tail at A384 sets DL = number of drives and AH = 0.
    70                              <1> ; ---------------------------------------------------------------
    71                              <1> xlate_getparams:
    72 0000002A 53                  <1>     push bx
    73 0000002B 56                  <1>     push si
    74 0000002C 57                  <1>     push di
    75 0000002D 268B17              <1>     mov  dx, word [es:bx]         ; RealCyl
    76 00000030 30ED                <1>     xor  ch, ch
    77 00000032 268A4F02            <1>     mov  cl, byte [es:bx+2]       ; RealHeads
    78 00000036 268A470E            <1>     mov  al, byte [es:bx+0x0e]    ; RealSectors
    79 0000003A 30E4                <1>     xor  ah, ah
    80 0000003C 50                  <1>     push ax                       ; RealSectors
    81 0000003D 51                  <1>     push cx                       ; RealHeads
    82 0000003E 52                  <1>     push dx                       ; RealCyl
    83 0000003F 89D0                <1>     mov  ax, dx
    84 00000041 E8BCFF              <1>     call calc_factor
    85 00000044 89C7                <1>     mov  di, ax                   ; TranslatedHeads
    86                              <1> 
    87 00000046 58                  <1>     pop  ax                       ; RealCyl
    88 00000047 59                  <1>     pop  cx                       ; RealHeads
    89 00000048 F7E1                <1>     mul  cx                       ; dx:ax = RealCyl * RealHeads
    90 0000004A F7F7                <1>     div  di                       ; ax = logical cylinders (<= RealCyl, fits)
    91                              <1> 
    92 0000004C 83E802              <1>     sub  ax, 2                    ; original "-2" convention
    93 0000004F 3DFF03              <1>     cmp  ax, 0x3ff
    94 00000052 7603                <1>     jbe  .cylok
    95 00000054 B8FF03              <1>     mov  ax, 0x3ff
    96                              <1> .cylok:
    97 00000057 88C5                <1>     mov  ch, al
    98 00000059 88E3                <1>     mov  bl, ah
    99 0000005B C0E306              <1>     shl  bl, 6
   100 0000005E 88D9                <1>     mov  cl, bl
   101 00000060 58                  <1>     pop  ax                       ; RealSectors
   102 00000061 08C1                <1>     or   cl, al
   103                              <1> 
   104 00000063 50                  <1>     push ax
   105 00000064 89F8                <1>     mov  ax, di
   106 00000066 48                  <1>     dec  ax
   107 00000067 88C6                <1>     mov  dh, al                   ; max head index
   108 00000069 58                  <1>     pop  ax                       ; AL = sectors, AH = 0
   109                              <1> 
   110 0000006A 5F                  <1>     pop  di
   111 0000006B 5E                  <1>     pop  si
   112 0000006C 5B                  <1>     pop  bx
   113 0000006D C3                  <1>     ret
   114                              <1> 
   115                              <1> ; ---------------------------------------------------------------
   116                              <1> ; xlate_headcyl  (replaces "AND DH,0Fh" at A65A in drive-select A619)
   117                              <1> ;
   118                              <1> ;   Entry, exactly as at the original instruction:
   119                              <1> ;     DH    = caller's (logical) head
   120                              <1> ;     DI    = INT 13h function * 2
   121                              <1> ;     ES:BX = FDPT of the drive
   122                              <1> ;     Stack: [ret][orig CX][orig DX][BX][ES] (pushed at A631)
   123                              <1> ;     BP    = INT 13h frame
   124                              <1> ;   Exit:
   125                              <1> ;     DH         = physical head
   126                              <1> ;     saved CX   = physical cylinder low / bits 9:8 / sector
   127                              <1> ;     frame [bp+6] = physical cylinder high byte (port 1F5h value)
   128                              <1> ;   The caller's DH in the frame ([bp+15h]) is only read, never written.
   129                              <1> ;
   130                              <1> ;   Only AH=02,03,04,05,0A,0B,0C (DI=04,06,08,0A,14,16,18) carry an
   131                              <1> ;   address. Everything else gets the original behaviour.
   132                              <1> ; ---------------------------------------------------------------
   133                              <1> xlate_headcyl:
   134 0000006E 55                  <1>     push bp
   135 0000006F 89E5                <1>     mov  bp, sp                   ; [bp+0] frame bp, [bp+4] orig CX, [bp+6] orig DX
   136 00000071 83FF04              <1>     cmp  di, 0x04
   137 00000074 7440                <1>     je   .xl
   138 00000076 83FF06              <1>     cmp  di, 0x06
   139 00000079 743B                <1>     je   .xl
   140 0000007B 83FF08              <1>     cmp  di, 0x08
   141 0000007E 7436                <1>     je   .xl
   142 00000080 83FF0A              <1>     cmp  di, 0x0a
   143 00000083 7431                <1>     je   .xl
   144 00000085 83FF14              <1>     cmp  di, 0x14
   145 00000088 742C                <1>     je   .xl
   146 0000008A 83FF16              <1>     cmp  di, 0x16
   147 0000008D 7427                <1>     je   .xl
   148 0000008F 83FF18              <1>     cmp  di, 0x18
   149 00000092 7422                <1>     je   .xl
   150                              <1> 
   151                              <1>     ; ---- not translated: the original ROM's arithmetic ----
   152 00000094 50                  <1>     push ax
   153 00000095 53                  <1>     push bx
   154 00000096 8B5E00              <1>     mov  bx, [bp+0]
   155 00000099 8A4604              <1>     mov  al, [bp+4]               ; orig CL
   156 0000009C C0E806              <1>     shr  al, 6
   157 0000009F 368A6715            <1>     mov  ah, [ss:bx+0x15]         ; frame DH: AMI cylinder bits 11:10 in bits 7:6
   158 000000A3 C0EC04              <1>     shr  ah, 4
   159 000000A6 80E40C              <1>     and  ah, 0x0c
   160 000000A9 08E0                <1>     or   al, ah
   161 000000AB 36884706            <1>     mov  [ss:bx+6], al
   162 000000AF 5B                  <1>     pop  bx
   163 000000B0 58                  <1>     pop  ax
   164 000000B1 80E60F              <1>     and  dh, 0x0f
   165 000000B4 5D                  <1>     pop  bp
   166 000000B5 C3                  <1>     ret
   167                              <1> 
   168                              <1> .xl:
   169 000000B6 83EC0C              <1>     sub  sp, 12                   ; -2 logC -4 logH -6 logS -8 realH -10 realS -12 transH
   170 000000B9 50                  <1>     push ax                       ; only what this path changes (not PUSHA:
   171 000000BA 53                  <1>     push bx                       ;  every byte counts on the POST stack)
   172 000000BB 51                  <1>     push cx
   173 000000BC 52                  <1>     push dx
   174 000000BD 56                  <1>     push si
   175                              <1> 
   176 000000BE 268B37              <1>     mov  si, word [es:bx]         ; RealCyl
   177 000000C1 268A4F02            <1>     mov  cl, byte [es:bx+2]
   178 000000C5 30ED                <1>     xor  ch, ch
   179 000000C7 894EF8              <1>     mov  [bp-8], cx               ; RealHeads
   180 000000CA 268A570E            <1>     mov  dl, byte [es:bx+0x0e]
   181 000000CE 30F6                <1>     xor  dh, dh
   182 000000D0 8956F6              <1>     mov  [bp-10], dx              ; RealSectors
   183 000000D3 89F0                <1>     mov  ax, si
   184 000000D5 E828FF              <1>     call calc_factor
   185 000000D8 8946F4              <1>     mov  [bp-12], ax              ; TranslatedHeads
   186                              <1> 
   187 000000DB 8B4604              <1>     mov  ax, [bp+4]               ; orig CX
   188 000000DE 88C3                <1>     mov  bl, al
   189 000000E0 80E33F              <1>     and  bl, 0x3f
   190 000000E3 30FF                <1>     xor  bh, bh
   191 000000E5 895EFA              <1>     mov  [bp-6], bx               ; logical sector
   192 000000E8 88C3                <1>     mov  bl, al
   193 000000EA 80E3C0              <1>     and  bl, 0xc0
   194 000000ED C0EB06              <1>     shr  bl, 6
   195 000000F0 30FF                <1>     xor  bh, bh
   196 000000F2 88E2                <1>     mov  dl, ah
   197 000000F4 30F6                <1>     xor  dh, dh
   198 000000F6 C1E308              <1>     shl  bx, 8
   199 000000F9 09D3                <1>     or   bx, dx
   200 000000FB 895EFE              <1>     mov  [bp-2], bx               ; logical cylinder (10 bit)
   201 000000FE 8A4607              <1>     mov  al, [bp+7]               ; orig DH
   202 00000101 30E4                <1>     xor  ah, ah
   203 00000103 8946FC              <1>     mov  [bp-4], ax               ; logical head
   204                              <1> 
   205                              <1>     ; LBA = (logC * transH + logH) * S + logS - 1   (< 2^24, 32-bit in DX:AX)
   206 00000106 8B46FE              <1>     mov  ax, [bp-2]
   207 00000109 F766F4              <1>     mul  word [bp-12]             ; dx:ax = logC * transH (<= 1023*255)
   208 0000010C 0346FC              <1>     add  ax, [bp-4]
   209 0000010F 83D200              <1>     adc  dx, 0
   210 00000112 89C3                <1>     mov  bx, ax                   ; bx = low word
   211 00000114 89D0                <1>     mov  ax, dx
   212 00000116 F766F6              <1>     mul  word [bp-10]             ; high word * S (fits: result < 2^24)
   213 00000119 89C1                <1>     mov  cx, ax                   ; cx = high part
   214 0000011B 89D8                <1>     mov  ax, bx
   215 0000011D F766F6              <1>     mul  word [bp-10]             ; dx:ax = low word * S
   216 00000120 01CA                <1>     add  dx, cx
   217 00000122 8B4EFA              <1>     mov  cx, [bp-6]
   218 00000125 49                  <1>     dec  cx
   219 00000126 01C8                <1>     add  ax, cx
   220 00000128 83D200              <1>     adc  dx, 0                    ; dx:ax = LBA
   221                              <1> 
   222                              <1>     ; sector = LBA mod S + 1,  rest = LBA / S
   223 0000012B 8B4EF6              <1>     mov  cx, [bp-10]
   224 0000012E E8EAFE              <1>     call div32                    ; dx:ax = LBA / S, bx = LBA mod S
   225 00000131 43                  <1>     inc  bx
   226 00000132 895EFA              <1>     mov  [bp-6], bx               ; physical sector
   227                              <1>     ; head = rest mod realH, cylinder = rest / realH
   228 00000135 8B4EF8              <1>     mov  cx, [bp-8]
   229 00000138 E8E0FE              <1>     call div32                    ; ax = physical cylinder, bx = physical head
   230 0000013B 895EFC              <1>     mov  [bp-4], bx
   231 0000013E 8946FE              <1>     mov  [bp-2], ax
   232                              <1> 
   233 00000141 8B5E00              <1>     mov  bx, [bp+0]
   234 00000144 36886706            <1>     mov  [ss:bx+6], ah            ; cylinder high byte -> frame [bp+6]
   235                              <1> 
   236 00000148 8B46FE              <1>     mov  ax, [bp-2]
   237 0000014B 88C7                <1>     mov  bh, al                   ; CH = cylinder low
   238 0000014D 88E3                <1>     mov  bl, ah
   239 0000014F C0E306              <1>     shl  bl, 6                    ; CL 7:6 = cylinder bits 9:8
   240 00000152 8B4EFA              <1>     mov  cx, [bp-6]
   241 00000155 08CB                <1>     or   bl, cl                   ; CL 5:0 = sector
   242 00000157 895E04              <1>     mov  [bp+4], bx               ; saved CX := physical CX
   243                              <1> 
   244 0000015A 5E                  <1>     pop  si
   245 0000015B 5A                  <1>     pop  dx
   246 0000015C 59                  <1>     pop  cx
   247 0000015D 5B                  <1>     pop  bx
   248 0000015E 58                  <1>     pop  ax
   249 0000015F 8A76FC              <1>     mov  dh, byte [bp-4]          ; physical head
   250 00000162 83C40C              <1>     add  sp, 12
   251 00000165 5D                  <1>     pop  bp
   252 00000166 C3                  <1>     ret
