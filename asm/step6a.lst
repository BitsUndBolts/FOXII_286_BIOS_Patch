  1176 000007B0 B2F7                <1>     mov  dl, 0xF7
  1177 000007B2 EC                  <1>     in   al, dx
  1178 000007B3 BD0000              <1>     mov  bp, D_NONE
  1179 000007B6 3CFF                <1>     cmp  al, 0xFF                  ; nothing on the bus
  1180 000007B8 7503E9B500          <1>     je   .end
  1181 000007BD 3C7F                <1>     cmp  al, 0x7F
  1182 000007BF 7503E9AE00          <1>     je   .end
