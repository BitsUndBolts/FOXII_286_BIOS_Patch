   203 000000B0 7512                <1>     jne  .out
   204 000000B2 A3F200              <1>     mov  [ST_UNITS], ax
   205 000000B5 3B06F400            <1>     cmp  ax, [ST_TOTAL]
   206 000000B9 7603                <1>     jbe  .d
   207 000000BB A3F400              <1>     mov  [ST_TOTAL], ax
   208 000000BE E8D908              <1> .d: call vid_es
   209 000000C1 E80D03              <1>     call draw_memory
   210                              <1> .out:
   211 000000C4 07                  <1>     pop  es
   212 000000C5 1F                  <1>     pop  ds
   213 000000C6 61                  <1>     popa
   214 000000C7 C3                  <1>     ret
