  1573 000008B2 E643                <1>     out  0x43, al
  1574 000008B4 B0FF                <1>     mov  al, 0xFF
  1575 000008B6 E642                <1>     out  0x42, al
  1576 000008B8 E642                <1>     out  0x42, al
