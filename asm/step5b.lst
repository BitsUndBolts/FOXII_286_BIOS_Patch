  1252                              <1> ; measurements and probes
  1253                              <1> ; =====================================================================
  1254                              <1> ; measure_clock -> [ST_MHZ]: 250 passes of 32 x DIV BX + LOOP, built at
  1255                              <1> ; 0:7C00 (RAM: the ROM has wait states) and timed by PIT channel 2.
  1256                              <1> ; 80286: DIV r16 22 clocks, LOOP 8 + the queue refill (2 bytes): 714 per
  1257                              <1> ; pass. Shown only within 1/16 of a standard clock.
  1258                              <1> measure_clock:
  1259 00000857 06                  <1>     push es
  1260 00000858 6A00                <1>     push 0
  1261 0000085A 07                  <1>     pop  es
  1262 0000085B BF007C              <1>     mov  di, TLOOP
  1263 0000085E BE[E108]            <1>     mov  si, tl_head
  1264 00000861 B90B00              <1>     mov  cx, tl_head_end - tl_head
  1265 00000864 F32EA4              <1>     rep  cs movsb
  1266 00000867 B8F7F3              <1>     mov  ax, 0xF3F7                ; 32 x DIV BX
  1267 0000086A B92000              <1>     mov  cx, 32
  1268 0000086D F3AB                <1>     rep  stosw
  1269 0000086F B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV (-66)
  1270 00000872 AB                  <1>     stosw
  1271 00000873 B0CB                <1>     mov  al, 0xCB                  ; RETF
  1272 00000875 AA                  <1>     stosb
  1273 00000876 07                  <1>     pop  es
  1274 00000877 9C                  <1>     pushf
  1275 00000878 FA                  <1>     cli
  1276 00000879 E461                <1>     in   al, 0x61
  1277 0000087B 50                  <1>     push ax
  1278 0000087C 24FC                <1>     and  al, 0xFC
  1279 0000087E E661                <1>     out  0x61, al
  1280 00000880 B0B0                <1>     mov  al, 0xB0                  ; channel 2, mode 0, 16 bits
  1281 00000882 E643                <1>     out  0x43, al
  1282 00000884 B0FF                <1>     mov  al, 0xFF
  1283 00000886 E642                <1>     out  0x42, al
  1284 00000888 E642                <1>     out  0x42, al
  1285 0000088A E461                <1>     in   al, 0x61
  1286 0000088C 0C01                <1>     or   al, 1                     ; gate on, speaker off
  1287 0000088E E661                <1>     out  0x61, al
  1288 00000890 9A007C0000          <1>     call 0:TLOOP
  1289 00000895 B080                <1>     mov  al, 0x80                  ; latch channel 2
  1290 00000897 E643                <1>     out  0x43, al
  1291 00000899 E442                <1>     in   al, 0x42
  1292 0000089B 88C4                <1>     mov  ah, al
  1293 0000089D E442                <1>     in   al, 0x42
  1294 0000089F 86C4                <1>     xchg al, ah
  1295 000008A1 F7D0                <1>     not  ax                        ; elapsed ticks
  1296 000008A3 91                  <1>     xchg ax, cx
  1297 000008A4 58                  <1>     pop  ax
  1298 000008A5 E661                <1>     out  0x61, al
  1299 000008A7 9D                  <1>     popf
  1300 000008A8 C606FA0000          <1>     mov  byte [ST_MHZ], 0
  1301 000008AD E331                <1>     jcxz .r
  1302 000008AF B8A67F              <1>     mov  ax, CLOCK_K & 0xFFFF
  1303 000008B2 BA2000              <1>     mov  dx, CLOCK_K >> 16
  1304 000008B5 E8(1B00)            <1>     call div32                     ; DX:AX = MHz x 10
  1305 000008B8 09D2                <1>     or   dx, dx
  1306 000008BA 7524                <1>     jnz  .r
