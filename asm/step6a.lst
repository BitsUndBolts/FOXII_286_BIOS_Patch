   880                              <1> ; type-47 parameters: [1Bh + 9 x drive]: cylinders, heads, write precomp,
   881                              <1> ; control (08h with more than 8 heads), landing zone, sectors. For types
   882                              <1> ; 1-46 the value comes from AMI's table (E401) and cannot be changed.
   883                              <1> %macro PARAM 4                     ; name, CMOS offset, table offset, 1 = byte
   884                              <1> p_%1_c: mov bl, 0
   885                              <1>         jmp short p_%1
   886                              <1> p_%1_d: mov bl, 1
