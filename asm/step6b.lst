   479                              <1> %ifdef ROUND6B
   480                              <1> ; ---------------------------------------------------------------------
   481                              <1> ; The one-time boot key: A or C during POST boots that drive first, this
   482                              <1> ; time only; CMOS is not changed. Seen like DEL: in the memory test
   483                              <1> ; (kbd_poll, port 60h), from checkpoint 73h in the keyboard buffer
   484                              <1> ; (bu_tick, and del_7f before AMI empties it at 7Fh), and from 7Fh to
   485                              <1> ; INT 19h by boot_seq (setup.asm, bk_order). A key: "Booting: A: (this
   486                              <1> ; time)" on the status bar. 40:FF holds it until INT 19h takes it.
   487                              <1> ; ---------------------------------------------------------------------
   488                              <1> ; bk_seen: AL = scan code (1Eh A, 2Eh C, else nothing). All registers
   489                              <1> ; kept. As del_seen: in protected mode (AMI's memory test) only the note.
   490                              <1> bk_seen:
   491 00000250 3C1E                <1>     cmp  al, 0x1E
