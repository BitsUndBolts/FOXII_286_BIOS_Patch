  1834 00000BDB B8F7F3              <1>     mov  ax, 0xF3F7                ; 32 x DIV BX
  1835 00000BDE B92000              <1>     mov  cx, 32
  1836 00000BE1 F3AB                <1>     rep  stosw
  1837 00000BE3 B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV (-66)
  1838 00000BE6 AB                  <1>     stosw
  1839 00000BE7 B0CB                <1>     mov  al, 0xCB                  ; RETF
  1840 00000BE9 AA                  <1>     stosb
  1841 00000BEA 07                  <1>     pop  es
