   542                              <1> 
   543                              <1> ; bk_scan: the keyboard buffer (40:1A to 40:1C) -> bk_seen for each key.
   544                              <1> ; DS = 40h. All registers kept.
   545                              <1> bk_scan:
   546                              <1>     push ax
   547                              <1>     push si
   548                              <1>     mov  si, [0x1A]
   549                              <1> .l: cmp  si, [0x1C]
   550                              <1>     je   .r
   551                              <1>     mov  al, [si + 1]
   552                              <1>     call bk_seen
   553                              <1>     inc  si
   554                              <1>     inc  si
   555                              <1>     cmp  si, 0x3E
   556                              <1>     jb   .l
   557                              <1>     mov  si, 0x1E
   558                              <1>     jmp  short .l
   559                              <1> .r: pop  si
   560                              <1>     pop  ax
   561                              <1>     ret
   562                              <1> 
   563                              <1> ; bk_stat: SI = a status text -> the boot key's text instead, if there
