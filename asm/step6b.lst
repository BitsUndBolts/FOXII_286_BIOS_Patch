   280 0000139D 1F                  <1>     pop  ds
   281 0000139E A06500              <1>     mov  al, [0x65]
   282 000013A1 24F7                <1>     and  al, 0xF7                  ; video off
   283 000013A3 84DB                <1>     test bl, bl
   284 000013A5 7402                <1>     jz   .mc1
