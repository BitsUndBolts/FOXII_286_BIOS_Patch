  1146 00000785 50                  <1>     push ax
  1147 00000786 0C40                <1>     or   al, 0x40
  1148 00000788 E6A1                <1>     out  0xA1, al
  1149 0000078A BAF603              <1>     mov  dx, 0x3F6
  1150 0000078D B002                <1>     mov  al, 0x02                  ; nIEN
  1151 0000078F EE                  <1>     out  dx, al
  1152 00000790 BAF601              <1>     mov  dx, 0x1F6
