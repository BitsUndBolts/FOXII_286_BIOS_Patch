   290                              <1> %ifdef ROUND6A
   291                              <1> ; ---------------------------------------------------------------------
   292                              <1> ; DEL feedback. AMI decides on setup at checkpoint 7Fh (9550): it empties
   293                              <1> ; the keyboard buffer and looks for scan code 53h. During the memory test
   294                              <1> ; it reads port 60h itself and throws every key but ESC away (AC2A, AC3A,
   295                              <1> ; AC8E), so a DEL pressed then was lost. Now:
   296                              <1> ;  - memory test: kbd_poll replaces those reads and notes a DEL;
   297                              <1> ;  - checkpoints 73h-7Fh (the keyboard interrupt fills the buffer, the
   298                              <1> ;    timer runs): bu_tick on INT 1Ch looks into the buffer every tick;
   299                              <1> ;  - checkpoint 7Fh (del_7f, before AMI empties the buffer): INT 1Ch back
   300                              <1> ;    to AMI's IRET, and a DEL noted earlier is put into the buffer, so
   301                              <1> ;    AMI enters setup as for a DEL typed in its window.
   302                              <1> ; The status bar says "Entering Setup" from the moment DEL is seen.
   303                              <1> ; ---------------------------------------------------------------------
   304                              <1> INT1C_DEF  equ 0xFF53     ; AMI's INT 1Ch at checkpoint 73h: F000:FF53 (IRET)
   305                              <1> 
   306                              <1> ; kbd_poll -- AL = port 60h, as the IN AL,60h it replaces (AC2A, AC8E;
   307                              <1> ; AC3A through bu_memkey); a DEL (make code 53h, read while the KBC's
   308                              <1> ; output buffer was full) is noted. Other registers kept; flags changed
   309                              <1> ; (no caller uses them after the IN).
   310                              <1> kbd_poll:
   311 00000117 E464                <1>     in   al, 0x64
   312 00000119 A801                <1>     test al, 1
   313 0000011B E460                <1>     in   al, 0x60
   314 0000011D 740A                <1>     jz   .r
   315 0000011F 3C53                <1>     cmp  al, 0x53
   316                              <1> %ifdef ROUND6B
   317 00000121 7503                <1>     jne  .k
   318 00000123 E80A00              <1>     call del_seen
   319 00000126 E82701              <1> .k: call bk_seen                   ; A or C: the boot drive for this boot
   320                              <1> %else
   321                              <1>     jne  .r
   322                              <1>     call del_seen
   323                              <1> %endif
   324 00000129 C3                  <1> .r: ret
   325                              <1> 
   326                              <1> bu_memkey:                         ; AC3A: IN AL,60h / CMP AL,1 (ESC?)
   327 0000012A E8EAFF              <1>     call kbd_poll
   328 0000012D 3C01                <1>     cmp  al, 1
   329 0000012F C3                  <1>     ret
   330                              <1> 
   331                              <1> ; del_seen -- note DEL and show "Entering Setup" (once). Safe in an
   332                              <1> ; interrupt: no CMOS, no INT 10h. All registers kept. AMI's memory test
   333                              <1> ; runs in protected mode: there selector 18h is the BIOS data area (base
   334                              <1> ; 400h in AMI's GDT at 0:0600) and the screen cannot be reached, so only
   335                              <1> ; the note is made; bu_mem shows it after the CPU is back in real mode.
   336                              <1> del_seen:
   337 00000130 60                  <1>     pusha
   338 00000131 1E                  <1>     push ds
   339 00000132 06                  <1>     push es
   340 00000133 0F01E0              <1>     smsw ax
   341 00000136 A801                <1>     test al, 1
   342 00000138 7417                <1>     jz   .real
   343 0000013A 6A18                <1>     push 0x18
   344 0000013C 1F                  <1>     pop  ds
   345 0000013D 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   346 00000142 753B                <1>     jne  .out
   347 00000144 800EFB0008          <1>     or   byte [ST_MISC], M_DEL
   348 00000149 C706FC00[7710]      <1>     mov  word [ST_STAT], s_st_setup
   349 0000014F EB2E                <1>     jmp  short .out
   350                              <1> .real:
   351 00000151 6A40                <1>     push 0x40
   352 00000153 1F                  <1>     pop  ds
   353 00000154 FC                  <1>     cld
   354 00000155 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   355 0000015A 7523                <1>     jne  .out
   356 0000015C F606FB0008          <1>     test byte [ST_MISC], M_DEL
   357 00000161 751C                <1>     jnz  .out
   358 00000163 800EFB0008          <1>     or   byte [ST_MISC], M_DEL
   359 00000168 C706FC00[7710]      <1>     mov  word [ST_STAT], s_st_setup
   360 0000016E B800B8              <1>     mov  ax, 0xB800                ; ST_SCH was set when the screen was drawn
   361 00000171 803E490007          <1>     cmp  byte [0x49], 7
   362 00000176 7502                <1>     jne  .v
   363 00000178 B4B0                <1>     mov  ah, 0xB0
   364 0000017A 8EC0                <1> .v: mov  es, ax
   365 0000017C E82104              <1>     call draw_status
   366                              <1> .out:
