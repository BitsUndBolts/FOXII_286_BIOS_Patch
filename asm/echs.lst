     1                                  BITS 16
     2                                  CPU 286             ; the FOX II is an 80286: any 386 instruction is an assembler error
     3                                  ORG 0xF537          ; free-space block F537-F840 in segment F000
     4                                  
     5                                  ; =====================================================================
     6                                  ;  ECHS (CHS translation) for the AMI 286 BIOS 06/13/90, Octek FOX II
     7                                  ;
     8                                  ;  A 286 port of the SOYO SY-019L1 patch (asm/xlate.asm there, v5,
     9                                  ;  confirmed on hardware). The algorithm, the five patch sites and their
    10                                  ;  contracts are the same; only the 32-bit arithmetic of xlate_headcyl
    11                                  ;  is redone in 16-bit pieces, because the 286 has no EAX/MOVZX/PUSHAD.
    12                                  ;
    13                                  ;  Drives up to 1024 x 255 x 63 x 512 = 8.42 GB (7.84 GiB) through
    14                                  ;  classic INT 13h CHS, instead of 1024 x 16 x 63 = 504 MB.
    15                                  ;
    16                                  ;  Reached from five patch sites (applied and asserted by py/build.py):
    17                                  ;    A357-A383   AH=08h reporting body -> CALL xlate_getparams / JMP A384
    18                                  ;    A65A        AND DH,0Fh            -> CALL xlate_headcyl
    19                                  ;    A30C, A4DF, A832  cylinder-high builders before OUT 1F5h
    20                                  ;                -> MOV AL,[BP+6] + NOP fill (the byte xlate_headcyl stores)
    21                                  ;  This BIOS has no checksum over this area (see docs/ROM_ANALYSIS.md 2).
    22                                  ; =====================================================================
    23                                  
    24                                  ; ---------------------------------------------------------------
    25                                  ; calc_factor
    26                                  ;   In:  AX = RealCyl, CX = RealHeads
    27                                  ;   Out: AX = TranslatedHeads: RealHeads * 2^n until the cylinders fit
    28                                  ;        in 1024, never more than 255 (16, 32, 64, 128, then 255).
    29                                  ;        256 heads breaks DOS (SOYO pitfall 9.6).
    30                                  ;   Preserves everything else.
    31                                  ; ---------------------------------------------------------------
    32                                  calc_factor:
    33 00000000 53                          push bx
    34 00000001 89C3                        mov  bx, ax            ; bx = working cylinder count
    35 00000003 89C8                        mov  ax, cx            ; ax = candidate head count
    36                                  .loop:
    37 00000005 81FB0004                    cmp  bx, 1024
    38 00000009 760E                        jbe  .done
    39 0000000B 83F87F                      cmp  ax, 127
    40 0000000E 7706                        ja   .max
    41 00000010 D1E0                        shl  ax, 1
    42 00000012 D1EB                        shr  bx, 1
    43 00000014 EBEF                        jmp  .loop
    44                                  .max:
    45 00000016 B8FF00                      mov  ax, 255
    46                                  .done:
    47 00000019 5B                          pop  bx
    48 0000001A C3                          ret
    49                                  
    50                                  ; ---------------------------------------------------------------
    51                                  ; div32: DX:AX / CX  (CX != 0)
    52                                  ;   Out: DX:AX = quotient (32 bit), BX = remainder
    53                                  ;   A 286 DIV only takes a 16-bit quotient, so divide the high word
    54                                  ;   first and carry its remainder into the low word.
    55                                  ; ---------------------------------------------------------------
    56                                  div32:
    57 0000001B 50                          push ax
    58 0000001C 89D0                        mov  ax, dx
    59 0000001E 31D2                        xor  dx, dx
    60 00000020 F7F1                        div  cx                ; ax = high quotient, dx = remainder
    61 00000022 89C3                        mov  bx, ax
    62 00000024 58                          pop  ax
    63 00000025 F7F1                        div  cx                ; ax = low quotient, dx = remainder
    64 00000027 87DA                        xchg bx, dx            ; dx = high quotient, bx = remainder
    65 00000029 C3                          ret
    66                                  
    67                                  ; ---------------------------------------------------------------
    68                                  ; xlate_getparams  (replaces the AH=08h reporting body A357-A383,
    69                                  ;                   which is byte-identical to the SOYO's A659-A685)
    70                                  ;   In:  ES:BX -> FDPT (+0 cylinders, +2 heads, +0Eh sectors)
    71                                  ;   Out: CH/CL/DH = translated geometry, AL = sectors per track.
    72                                  ;        The original tail at A384 sets DL = number of drives and AH = 0.
    73                                  ; ---------------------------------------------------------------
    74                                  xlate_getparams:
    75 0000002A 53                          push bx
    76 0000002B 56                          push si
    77 0000002C 57                          push di
    78 0000002D 268B17                      mov  dx, word [es:bx]         ; RealCyl
    79 00000030 30ED                        xor  ch, ch
    80 00000032 268A4F02                    mov  cl, byte [es:bx+2]       ; RealHeads
    81 00000036 268A470E                    mov  al, byte [es:bx+0x0e]    ; RealSectors
    82 0000003A 30E4                        xor  ah, ah
    83 0000003C 50                          push ax                       ; RealSectors
    84 0000003D 51                          push cx                       ; RealHeads
    85 0000003E 52                          push dx                       ; RealCyl
    86 0000003F 89D0                        mov  ax, dx
    87 00000041 E8BCFF                      call calc_factor
    88 00000044 89C7                        mov  di, ax                   ; TranslatedHeads
    89                                  
    90 00000046 58                          pop  ax                       ; RealCyl
    91 00000047 59                          pop  cx                       ; RealHeads
    92 00000048 F7E1                        mul  cx                       ; dx:ax = RealCyl * RealHeads
    93 0000004A F7F7                        div  di                       ; ax = logical cylinders (<= RealCyl, fits)
    94                                  
    95 0000004C 83E802                      sub  ax, 2                    ; original "-2" convention
    96 0000004F 3DFF03                      cmp  ax, 0x3ff
    97 00000052 7603                        jbe  .cylok
    98 00000054 B8FF03                      mov  ax, 0x3ff
    99                                  .cylok:
   100 00000057 88C5                        mov  ch, al
   101 00000059 88E3                        mov  bl, ah
   102 0000005B C0E306                      shl  bl, 6
   103 0000005E 88D9                        mov  cl, bl
   104 00000060 58                          pop  ax                       ; RealSectors
   105 00000061 08C1                        or   cl, al
   106                                  
   107 00000063 50                          push ax
   108 00000064 89F8                        mov  ax, di
   109 00000066 48                          dec  ax
   110 00000067 88C6                        mov  dh, al                   ; max head index
   111 00000069 58                          pop  ax                       ; AL = sectors, AH = 0
   112                                  
   113 0000006A 5F                          pop  di
   114 0000006B 5E                          pop  si
   115 0000006C 5B                          pop  bx
   116 0000006D C3                          ret
   117                                  
   118                                  ; ---------------------------------------------------------------
   119                                  ; xlate_headcyl  (replaces "AND DH,0Fh" at A65A in drive-select A619)
   120                                  ;
   121                                  ;   Entry, exactly as at the original instruction:
   122                                  ;     DH    = caller's (logical) head
   123                                  ;     DI    = INT 13h function * 2
   124                                  ;     ES:BX = FDPT of the drive
   125                                  ;     Stack: [ret][orig CX][orig DX][BX][ES] (pushed at A631)
   126                                  ;     BP    = INT 13h frame
   127                                  ;   Exit:
   128                                  ;     DH         = physical head
   129                                  ;     saved CX   = physical cylinder low / bits 9:8 / sector
   130                                  ;     frame [bp+6] = physical cylinder high byte (port 1F5h value)
   131                                  ;   The caller's DH in the frame ([bp+15h]) is only read, never written.
   132                                  ;
   133                                  ;   Only AH=02,03,04,05,0A,0B,0C (DI=04,06,08,0A,14,16,18) carry an
   134                                  ;   address. Everything else gets the original behaviour.
   135                                  ; ---------------------------------------------------------------
   136                                  xlate_headcyl:
   137 0000006E 55                          push bp
   138 0000006F 89E5                        mov  bp, sp                   ; [bp+0] frame bp, [bp+4] orig CX, [bp+6] orig DX
   139 00000071 83FF04                      cmp  di, 0x04
   140 00000074 7440                        je   .xl
   141 00000076 83FF06                      cmp  di, 0x06
   142 00000079 743B                        je   .xl
   143 0000007B 83FF08                      cmp  di, 0x08
   144 0000007E 7436                        je   .xl
   145 00000080 83FF0A                      cmp  di, 0x0a
   146 00000083 7431                        je   .xl
   147 00000085 83FF14                      cmp  di, 0x14
   148 00000088 742C                        je   .xl
   149 0000008A 83FF16                      cmp  di, 0x16
   150 0000008D 7427                        je   .xl
   151 0000008F 83FF18                      cmp  di, 0x18
   152 00000092 7422                        je   .xl
   153                                  
   154                                      ; ---- not translated: the original ROM's arithmetic ----
   155 00000094 50                          push ax
   156 00000095 53                          push bx
   157 00000096 8B5E00                      mov  bx, [bp+0]
   158 00000099 8A4604                      mov  al, [bp+4]               ; orig CL
   159 0000009C C0E806                      shr  al, 6
   160 0000009F 368A6715                    mov  ah, [ss:bx+0x15]         ; frame DH: AMI cylinder bits 11:10 in bits 7:6
   161 000000A3 C0EC04                      shr  ah, 4
   162 000000A6 80E40C                      and  ah, 0x0c
   163 000000A9 08E0                        or   al, ah
   164 000000AB 36884706                    mov  [ss:bx+6], al
   165 000000AF 5B                          pop  bx
   166 000000B0 58                          pop  ax
   167 000000B1 80E60F                      and  dh, 0x0f
   168 000000B4 5D                          pop  bp
   169 000000B5 C3                          ret
   170                                  
   171                                  .xl:
   172 000000B6 83EC0C                      sub  sp, 12                   ; -2 logC -4 logH -6 logS -8 realH -10 realS -12 transH
   173 000000B9 50                          push ax                       ; only what this path changes (not PUSHA:
   174 000000BA 53                          push bx                       ;  every byte counts on the POST stack)
   175 000000BB 51                          push cx
   176 000000BC 52                          push dx
   177 000000BD 56                          push si
   178                                  
   179 000000BE 268B37                      mov  si, word [es:bx]         ; RealCyl
   180 000000C1 268A4F02                    mov  cl, byte [es:bx+2]
   181 000000C5 30ED                        xor  ch, ch
   182 000000C7 894EF8                      mov  [bp-8], cx               ; RealHeads
   183 000000CA 268A570E                    mov  dl, byte [es:bx+0x0e]
   184 000000CE 30F6                        xor  dh, dh
   185 000000D0 8956F6                      mov  [bp-10], dx              ; RealSectors
   186 000000D3 89F0                        mov  ax, si
   187 000000D5 E828FF                      call calc_factor
   188 000000D8 8946F4                      mov  [bp-12], ax              ; TranslatedHeads
   189                                  
   190 000000DB 8B4604                      mov  ax, [bp+4]               ; orig CX
   191 000000DE 88C3                        mov  bl, al
   192 000000E0 80E33F                      and  bl, 0x3f
   193 000000E3 30FF                        xor  bh, bh
   194 000000E5 895EFA                      mov  [bp-6], bx               ; logical sector
   195 000000E8 88C3                        mov  bl, al
   196 000000EA 80E3C0                      and  bl, 0xc0
   197 000000ED C0EB06                      shr  bl, 6
   198 000000F0 30FF                        xor  bh, bh
   199 000000F2 88E2                        mov  dl, ah
   200 000000F4 30F6                        xor  dh, dh
   201 000000F6 C1E308                      shl  bx, 8
   202 000000F9 09D3                        or   bx, dx
   203 000000FB 895EFE                      mov  [bp-2], bx               ; logical cylinder (10 bit)
   204 000000FE 8A4607                      mov  al, [bp+7]               ; orig DH
   205 00000101 30E4                        xor  ah, ah
   206 00000103 8946FC                      mov  [bp-4], ax               ; logical head
   207                                  
   208                                      ; LBA = (logC * transH + logH) * S + logS - 1   (< 2^24, 32-bit in DX:AX)
   209 00000106 8B46FE                      mov  ax, [bp-2]
   210 00000109 F766F4                      mul  word [bp-12]             ; dx:ax = logC * transH (<= 1023*255)
   211 0000010C 0346FC                      add  ax, [bp-4]
   212 0000010F 83D200                      adc  dx, 0
   213 00000112 89C3                        mov  bx, ax                   ; bx = low word
   214 00000114 89D0                        mov  ax, dx
   215 00000116 F766F6                      mul  word [bp-10]             ; high word * S (fits: result < 2^24)
   216 00000119 89C1                        mov  cx, ax                   ; cx = high part
   217 0000011B 89D8                        mov  ax, bx
   218 0000011D F766F6                      mul  word [bp-10]             ; dx:ax = low word * S
   219 00000120 01CA                        add  dx, cx
   220 00000122 8B4EFA                      mov  cx, [bp-6]
   221 00000125 49                          dec  cx
   222 00000126 01C8                        add  ax, cx
   223 00000128 83D200                      adc  dx, 0                    ; dx:ax = LBA
   224                                  
   225                                      ; sector = LBA mod S + 1,  rest = LBA / S
   226 0000012B 8B4EF6                      mov  cx, [bp-10]
   227 0000012E E8EAFE                      call div32                    ; dx:ax = LBA / S, bx = LBA mod S
   228 00000131 43                          inc  bx
   229 00000132 895EFA                      mov  [bp-6], bx               ; physical sector
   230                                      ; head = rest mod realH, cylinder = rest / realH
   231 00000135 8B4EF8                      mov  cx, [bp-8]
   232 00000138 E8E0FE                      call div32                    ; ax = physical cylinder, bx = physical head
   233 0000013B 895EFC                      mov  [bp-4], bx
   234 0000013E 8946FE                      mov  [bp-2], ax
   235                                  
   236 00000141 8B5E00                      mov  bx, [bp+0]
   237 00000144 36886706                    mov  [ss:bx+6], ah            ; cylinder high byte -> frame [bp+6]
   238                                  
   239 00000148 8B46FE                      mov  ax, [bp-2]
   240 0000014B 88C7                        mov  bh, al                   ; CH = cylinder low
   241 0000014D 88E3                        mov  bl, ah
   242 0000014F C0E306                      shl  bl, 6                    ; CL 7:6 = cylinder bits 9:8
   243 00000152 8B4EFA                      mov  cx, [bp-6]
   244 00000155 08CB                        or   bl, cl                   ; CL 5:0 = sector
   245 00000157 895E04                      mov  [bp+4], bx               ; saved CX := physical CX
   246                                  
   247 0000015A 5E                          pop  si
   248 0000015B 5A                          pop  dx
   249 0000015C 59                          pop  cx
   250 0000015D 5B                          pop  bx
   251 0000015E 58                          pop  ax
   252 0000015F 8A76FC                      mov  dh, byte [bp-4]          ; physical head
   253 00000162 83C40C                      add  sp, 12
   254 00000165 5D                          pop  bp
   255 00000166 C3                          ret
