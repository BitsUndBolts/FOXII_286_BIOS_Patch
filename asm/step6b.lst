   357 00000161 751C                <1>     jnz  .out
   358 00000163 800EFB0008          <1>     or   byte [ST_MISC], M_DEL
   359 00000168 C706FC00[7B10]      <1>     mov  word [ST_STAT], s_st_setup
   360 0000016E B800B8              <1>     mov  ax, 0xB800                ; ST_SCH was set when the screen was drawn
   361 00000171 803E490007          <1>     cmp  byte [0x49], 7
   362 00000176 7502                <1>     jne  .v
   363 00000178 B4B0                <1>     mov  ah, 0xB0
