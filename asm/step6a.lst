  1822                              <1> ; measure_clock -> [ST_MHZ]: 250 passes of 32 x DIV BX + LOOP, built at
  1823                              <1> ; 0:7C00 (RAM: the ROM has wait states) and timed by PIT channel 2.
  1824                              <1> ; 80286: DIV r16 22 clocks, LOOP 8 + the queue refill (2 bytes): 714 per
  1825                              <1> ; pass. Shown only within 1/16 of a standard clock.
  1826                              <1> measure_clock:
  1827 00000A38 06                  <1>     push es
  1828 00000A39 6A00                <1>     push 0
  1829 00000A3B 07                  <1>     pop  es
  1830 00000A3C BF007C              <1>     mov  di, TLOOP
  1831 00000A3F BE[D40A]            <1>     mov  si, tl_head
  1832 00000A42 B90B00              <1>     mov  cx, tl_head_end - tl_head
  1833 00000A45 F32EA4              <1>     rep  cs movsb
  1834 00000A48 B8F7F3              <1>     mov  ax, 0xF3F7                ; 32 x DIV BX
  1835 00000A4B B92000              <1>     mov  cx, 32
  1836 00000A4E F3AB                <1>     rep  stosw
  1837 00000A50 B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV (-66)
  1838 00000A53 AB                  <1>     stosw
  1839 00000A54 B0CB                <1>     mov  al, 0xCB                  ; RETF
  1840 00000A56 AA                  <1>     stosb
  1841 00000A57 07                  <1>     pop  es
  1842 00000A58 9C                  <1>     pushf
  1843 00000A59 FA                  <1>     cli
  1844 00000A5A E461                <1>     in   al, 0x61
  1845 00000A5C 50                  <1>     push ax
  1846 00000A5D 24FC                <1>     and  al, 0xFC
  1847 00000A5F E661                <1>     out  0x61, al
  1848 00000A61 B0B0                <1>     mov  al, 0xB0                  ; channel 2, mode 0, 16 bits
  1849 00000A63 E643                <1>     out  0x43, al
  1850 00000A65 B0FF                <1>     mov  al, 0xFF
  1851 00000A67 E642                <1>     out  0x42, al
  1852 00000A69 E642                <1>     out  0x42, al
  1853 00000A6B E461                <1>     in   al, 0x61
