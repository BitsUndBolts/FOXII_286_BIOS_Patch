  1762                              <1> ; measure_clock -> [ST_MHZ]: 250 passes of 32 x DIV BX + LOOP, built at
  1763                              <1> ; 0:7C00 (RAM: the ROM has wait states) and timed by PIT channel 2.
  1764                              <1> ; 80286: DIV r16 22 clocks, LOOP 8 + the queue refill (2 bytes): 714 per
  1765                              <1> ; pass. Shown only within 1/16 of a standard clock.
  1766                              <1> measure_clock:
  1767 00000A38 06                  <1>     push es
  1768 00000A39 6A00                <1>     push 0
  1769 00000A3B 07                  <1>     pop  es
  1770 00000A3C BF007C              <1>     mov  di, TLOOP
  1771 00000A3F BE[D40A]            <1>     mov  si, tl_head
  1772 00000A42 B90B00              <1>     mov  cx, tl_head_end - tl_head
  1773 00000A45 F32EA4              <1>     rep  cs movsb
  1774 00000A48 B8F7F3              <1>     mov  ax, 0xF3F7                ; 32 x DIV BX
  1775 00000A4B B92000              <1>     mov  cx, 32
  1776 00000A4E F3AB                <1>     rep  stosw
  1777 00000A50 B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV (-66)
  1778 00000A53 AB                  <1>     stosw
  1779 00000A54 B0CB                <1>     mov  al, 0xCB                  ; RETF
  1780 00000A56 AA                  <1>     stosb
  1781 00000A57 07                  <1>     pop  es
  1782 00000A58 9C                  <1>     pushf
  1783 00000A59 FA                  <1>     cli
  1784 00000A5A E461                <1>     in   al, 0x61
  1785 00000A5C 50                  <1>     push ax
  1786 00000A5D 24FC                <1>     and  al, 0xFC
  1787 00000A5F E661                <1>     out  0x61, al
  1788 00000A61 B0B0                <1>     mov  al, 0xB0                  ; channel 2, mode 0, 16 bits
  1789 00000A63 E643                <1>     out  0x43, al
  1790 00000A65 B0FF                <1>     mov  al, 0xFF
  1791 00000A67 E642                <1>     out  0x42, al
  1792 00000A69 E642                <1>     out  0x42, al
  1793 00000A6B E461                <1>     in   al, 0x61
  1794 00000A6D 0C01                <1>     or   al, 1                     ; gate on, speaker off
  1795 00000A6F E661                <1>     out  0x61, al
  1796 00000A71 9A007C0000          <1>     call 0:TLOOP
  1797 00000A76 B080                <1>     mov  al, 0x80                  ; latch channel 2
  1798 00000A78 E643                <1>     out  0x43, al
  1799 00000A7A E442                <1>     in   al, 0x42
  1800 00000A7C 88C4                <1>     mov  ah, al
  1801 00000A7E E442                <1>     in   al, 0x42
  1802 00000A80 86C4                <1>     xchg al, ah
  1803 00000A82 F7D0                <1>     not  ax                        ; elapsed ticks
  1804 00000A84 91                  <1>     xchg ax, cx
  1805 00000A85 58                  <1>     pop  ax
  1806 00000A86 E661                <1>     out  0x61, al
  1807 00000A88 9D                  <1>     popf
  1808 00000A89 C606FA0000          <1>     mov  byte [ST_MHZ], 0
  1809 00000A8E E336                <1>     jcxz .r
  1810 00000A90 B8A67F              <1>     mov  ax, CLOCK_K & 0xFFFF
  1811 00000A93 BA2000              <1>     mov  dx, CLOCK_K >> 16
