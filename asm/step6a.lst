   356 00000139 800EFB0008          <1>     or   byte [ST_MISC], M_DEL
   357 0000013E C706FC00[1C0F]      <1>     mov  word [ST_STAT], s_st_setup
   358 00000144 EB2E                <1>     jmp  short .out
