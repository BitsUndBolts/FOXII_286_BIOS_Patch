   154 00000245 0D0A0A20496E76616C- <1> msg_head  db 13, 10, 10, ' Invalid opcode at ', 0
   154 0000024E 6964206F70636F6465- <1>
   154 00000257 2061742000          <1>
   155 0000025C 2028626F6F74207365- <1> msg_boot  db ' (boot sector)', 0
   155 00000265 63746F722900        <1>
