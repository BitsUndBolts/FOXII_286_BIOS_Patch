  1273                              <1> ; =====================================================================
  1274                              <1> ; measurements and probes
  1275                              <1> ; =====================================================================
  1276                              <1> ; measure_clock -> [ST_MHZ]: 250 passes of 32 x DIV BX + LOOP, built at
  1277                              <1> ; 0:7C00 (RAM: the ROM has wait states) and timed by PIT channel 2.
  1278                              <1> ; 80286: DIV r16 22 clocks, LOOP 8 + the queue refill (2 bytes): 714 per
  1279                              <1> ; pass. Shown only within 1/16 of a standard clock.
  1280                              <1> measure_clock:
  1281 00000887 06                  <1>     push es
  1282 00000888 6A00                <1>     push 0
  1283 0000088A 07                  <1>     pop  es
  1284 0000088B BF007C              <1>     mov  di, TLOOP
  1285 0000088E BE[2309]            <1>     mov  si, tl_head
  1286 00000891 B90B00              <1>     mov  cx, tl_head_end - tl_head
  1287 00000894 F32EA4              <1>     rep  cs movsb
  1288 00000897 B8F7F3              <1>     mov  ax, 0xF3F7                ; 32 x DIV BX
  1289 0000089A B92000              <1>     mov  cx, 32
  1290 0000089D F3AB                <1>     rep  stosw
  1291 0000089F B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV (-66)
  1292 000008A2 AB                  <1>     stosw
  1293 000008A3 B0CB                <1>     mov  al, 0xCB                  ; RETF
  1294 000008A5 AA                  <1>     stosb
  1295 000008A6 07                  <1>     pop  es
  1296 000008A7 9C                  <1>     pushf
  1297 000008A8 FA                  <1>     cli
  1298 000008A9 E461                <1>     in   al, 0x61
  1299 000008AB 50                  <1>     push ax
  1300 000008AC 24FC                <1>     and  al, 0xFC
  1301 000008AE E661                <1>     out  0x61, al
  1302 000008B0 B0B0                <1>     mov  al, 0xB0                  ; channel 2, mode 0, 16 bits
  1303 000008B2 E643                <1>     out  0x43, al
  1304 000008B4 B0FF                <1>     mov  al, 0xFF
  1305 000008B6 E642                <1>     out  0x42, al
  1306 000008B8 E642                <1>     out  0x42, al
