   211 000000B5 3B06F400            <1>     cmp  ax, [ST_TOTAL]
   212 000000B9 7603                <1>     jbe  .d
   213 000000BB A3F400              <1>     mov  [ST_TOTAL], ax
   214 000000BE E82E09              <1> .d: call vid_es
