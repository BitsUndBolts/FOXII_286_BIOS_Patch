   271 00001390 0C20                <1>     or   al, 0x20                  ; Screen Off
   272 00001392 84DB                <1>     test bl, bl
   273 00001394 7402                <1>     jz   .vga
   274 00001396 24DF                <1>     and  al, 0xDF                  ; Screen On
