    23                                  ; HT12UMB.SYS (BitsUndBolts/HT12UMB) in a fixed slot: a 16-byte tag at
    24                                  ; F000:5FF0, the driver at F000:6000, zeros up to 67FF. The DEBUG recipe
    25                                  ; (README) copies F000:6000 L800 to a file; it never changes.
    26                                  section umb start=0x5FF0 vstart=0x5FF0
    27 00000000 425542554D42            umb_tag:    db "BUBUMB"            ; +0 signature
    28 00000006 312E3000                            db "1.0", 0            ; +6 driver version (text)
    29 0000000A 1507                                dw umb_end - umb_drv   ; +10 driver length
    30 0000000C 0000                    umb_sum:    dw 0                   ; +12 word sum of the 2 KB slot (build.py), 0 = unchecked
    31 0000000E 0000                                dw 0                   ; +14
    32 00000010 <bin 715h>              umb_drv:    incbin "../extra/HT12UMB.SYS"
    33                                  umb_end:
    34 00000725 00<rep EBh>                         times 0x800 - (umb_end - umb_drv) db 0
