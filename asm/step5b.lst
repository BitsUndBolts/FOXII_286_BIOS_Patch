   272 0000011B BA0012              <1>     mov  dx, POS(R_MSG, 0)
   273 0000011E E80209              <1>     call fill_at
   274 00000121 BA0011              <1>     mov  dx, POS(R_MSG - 1, 0)
   275 00000124 B402                <1>     mov  ah, 2
   276 00000126 30FF                <1>     xor  bh, bh
   277 00000128 CD10                <1>     int  0x10
   278                              <1> .out:
   279 0000012A 07                  <1>     pop  es
   280 0000012B 1F                  <1>     pop  ds
   281 0000012C 61                  <1>     popa
   282 0000012D BEB27A              <1>     mov  si, ERR_TABLE
   283 00000130 C3                  <1>     ret
