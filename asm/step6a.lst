   299                              <1> %ifdef ROUND6A
   300                              <1> ; ---------------------------------------------------------------------
   301                              <1> ; DEL feedback. AMI decides on setup at checkpoint 7Fh (9550): it empties
   302                              <1> ; the keyboard buffer and looks for scan code 53h. During the memory test
   303                              <1> ; it reads port 60h itself and throws every key but ESC away (AC2A, AC3A,
   304                              <1> ; AC8E), so a DEL pressed then was lost. Now:
   305                              <1> ;  - memory test: kbd_poll replaces those reads and notes a DEL;
   306                              <1> ;  - checkpoints 73h-7Fh (the keyboard interrupt fills the buffer, the
   307                              <1> ;    timer runs): bu_tick on INT 1Ch looks into the buffer every tick;
   308                              <1> ;  - checkpoint 7Fh (del_7f, before AMI empties the buffer): INT 1Ch back
   309                              <1> ;    to AMI's IRET, and a DEL noted earlier is put into the buffer, so
   310                              <1> ;    AMI enters setup as for a DEL typed in its window.
   311                              <1> ; The status bar says "Entering Setup" from the moment DEL is seen.
   312                              <1> ; ---------------------------------------------------------------------
   313                              <1> INT1C_DEF  equ 0xFF53     ; AMI's INT 1Ch at checkpoint 73h: F000:FF53 (IRET)
   314                              <1> 
   315                              <1> ; kbd_poll -- AL = port 60h, as the IN AL,60h it replaces (AC2A, AC8E;
   316                              <1> ; AC3A through bu_memkey); a DEL (make code 53h, read while the KBC's
   317                              <1> ; output buffer was full) is noted. Other registers kept; flags changed
   318                              <1> ; (no caller uses them after the IN).
   319                              <1> kbd_poll:
   320 0000010F E464                <1>     in   al, 0x64
   321 00000111 A801                <1>     test al, 1
   322 00000113 E460                <1>     in   al, 0x60
   323 00000115 7407                <1>     jz   .r
   324 00000117 3C53                <1>     cmp  al, 0x53
   325                              <1> %ifdef ROUND6B
   326                              <1>     jne  .k
   327                              <1>     call del_seen
   328                              <1> .k: call bk_seen                   ; A or C: the boot drive for this boot
   329                              <1> %else
   330 00000119 7503                <1>     jne  .r
   331 0000011B E80700              <1>     call del_seen
   332                              <1> %endif
   333 0000011E C3                  <1> .r: ret
   334                              <1> 
   335                              <1> bu_memkey:                         ; AC3A: IN AL,60h / CMP AL,1 (ESC?)
   336 0000011F E8EDFF              <1>     call kbd_poll
   337 00000122 3C01                <1>     cmp  al, 1
   338 00000124 C3                  <1>     ret
   339                              <1> 
   340                              <1> ; del_seen -- note DEL and show "Entering Setup" (once). Safe in an
   341                              <1> ; interrupt: no CMOS, no INT 10h. All registers kept. AMI's memory test
   342                              <1> ; runs in protected mode: there selector 18h is the BIOS data area (base
   343                              <1> ; 400h in AMI's GDT at 0:0600) and the screen cannot be reached, so only
   344                              <1> ; the note is made; bu_mem shows it after the CPU is back in real mode.
   345                              <1> del_seen:
