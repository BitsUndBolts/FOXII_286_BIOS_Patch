  1849 00000BF6 E643                <1>     out  0x43, al
  1850 00000BF8 B0FF                <1>     mov  al, 0xFF
  1851 00000BFA E642                <1>     out  0x42, al
  1852 00000BFC E642                <1>     out  0x42, al
