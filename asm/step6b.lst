  1760                              <1> ; measurements and probes
  1761                              <1> ; =====================================================================
  1762                              <1> ; measure_clock -> [ST_MHZ]: 250 passes of 32 x DIV BX + LOOP, built at
  1763                              <1> ; 0:7C00 (RAM: the ROM has wait states) and timed by PIT channel 2.
  1764                              <1> ; 80286: DIV r16 22 clocks, LOOP 8 + the queue refill (2 bytes): 714 per
  1765                              <1> ; pass. Shown only within 1/16 of a standard clock.
  1766                              <1> measure_clock:
  1767 00000B81 06                  <1>     push es
  1768 00000B82 6A00                <1>     push 0
  1769 00000B84 07                  <1>     pop  es
  1770 00000B85 BF007C              <1>     mov  di, TLOOP
  1771 00000B88 BE[1D0C]            <1>     mov  si, tl_head
  1772 00000B8B B90B00              <1>     mov  cx, tl_head_end - tl_head
  1773 00000B8E F32EA4              <1>     rep  cs movsb
  1774 00000B91 B8F7F3              <1>     mov  ax, 0xF3F7                ; 32 x DIV BX
  1775 00000B94 B92000              <1>     mov  cx, 32
  1776 00000B97 F3AB                <1>     rep  stosw
  1777 00000B99 B8E2BE              <1>     mov  ax, 0xBEE2                ; LOOP back to the first DIV (-66)
  1778 00000B9C AB                  <1>     stosw
  1779 00000B9D B0CB                <1>     mov  al, 0xCB                  ; RETF
  1780 00000B9F AA                  <1>     stosb
  1781 00000BA0 07                  <1>     pop  es
  1782 00000BA1 9C                  <1>     pushf
  1783 00000BA2 FA                  <1>     cli
  1784 00000BA3 E461                <1>     in   al, 0x61
  1785 00000BA5 50                  <1>     push ax
  1786 00000BA6 24FC                <1>     and  al, 0xFC
  1787 00000BA8 E661                <1>     out  0x61, al
  1788 00000BAA B0B0                <1>     mov  al, 0xB0                  ; channel 2, mode 0, 16 bits
  1789 00000BAC E643                <1>     out  0x43, al
  1790 00000BAE B0FF                <1>     mov  al, 0xFF
  1791 00000BB0 E642                <1>     out  0x42, al
  1792 00000BB2 E642                <1>     out  0x42, al
  1793 00000BB4 E461                <1>     in   al, 0x61
  1794 00000BB6 0C01                <1>     or   al, 1                     ; gate on, speaker off
  1795 00000BB8 E661                <1>     out  0x61, al
  1796 00000BBA 9A007C0000          <1>     call 0:TLOOP
  1797 00000BBF B080                <1>     mov  al, 0x80                  ; latch channel 2
  1798 00000BC1 E643                <1>     out  0x43, al
  1799 00000BC3 E442                <1>     in   al, 0x42
  1800 00000BC5 88C4                <1>     mov  ah, al
  1801 00000BC7 E442                <1>     in   al, 0x42
  1802 00000BC9 86C4                <1>     xchg al, ah
  1803 00000BCB F7D0                <1>     not  ax                        ; elapsed ticks
  1804 00000BCD 91                  <1>     xchg ax, cx
  1805 00000BCE 58                  <1>     pop  ax
  1806 00000BCF E661                <1>     out  0x61, al
  1807 00000BD1 9D                  <1>     popf
  1808 00000BD2 C606FA0000          <1>     mov  byte [ST_MHZ], 0
  1809 00000BD7 E336                <1>     jcxz .r
  1810 00000BD9 B8A67F              <1>     mov  ax, CLOCK_K & 0xFFFF
  1811 00000BDC BA2000              <1>     mov  dx, CLOCK_K >> 16
  1812 00000BDF E8(1B00)            <1>     call div32                     ; DX:AX = MHz x 10
  1813 00000BE2 09D2                <1>     or   dx, dx
  1814 00000BE4 7529                <1>     jnz  .r
  1815 00000BE6 3DE803              <1>     cmp  ax, 1000                  ; (more than 100 MHz: not a reading)
  1816 00000BE9 7324                <1>     jae  .r
  1817 00000BEB BE[280C]            <1>     mov  si, clock_std             ; snap to a standard clock within 1/16
  1818 00000BEE 2E8B0C              <1> .sn:mov  cx, [cs:si]
  1819 00000BF1 E31D                <1>     jcxz .raw
  1820 00000BF3 46                  <1>     inc  si
  1821 00000BF4 46                  <1>     inc  si
  1822 00000BF5 89C2                <1>     mov  dx, ax
  1823 00000BF7 29CA                <1>     sub  dx, cx
