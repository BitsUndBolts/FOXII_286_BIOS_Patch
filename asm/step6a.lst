    18                                  %include "setup.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  Round 6a: the setup of BUBios/286, the boot order and the
     3                              <1> ;  auto-detect switch
     4                              <1> ;
     5                              <1> ;  AMI's setup code still prepares and saves (docs/DEVELOPMENT_LOG.md,
     6                              <1> ;  round 6a): BCA6 builds the stack frame and reads CMOS 10h-3Fh into
     7                              <1> ;  [BP+10h..3Fh]; AMI's page code (BD61-C006) normalises that buffer; at
     8                              <1> ;  C009, where AMI's editing loop began, bu_setup takes over. Every option
     9                              <1> ;  edits AMI's buffer with AMI's encodings. Save: JMP C0A0 (AMI writes
    10                              <1> ;  CMOS 10h-3Fh, the checksum, clears 0Eh/0Fh and restarts). Exit without
    11                              <1> ;  saving: JMP BD4D (AMI's menu exit back to POST).
    12                              <1> ;
    13                              <1> ;  py/build.py patches:
    14                              <1> ;    BCFC  MOV AL,CS:[E058] (the menu)        -> JMP BD61 (the page)
    15                              <1> ;    C009  MOV BX,CA53 / JMP C011             -> JMP bu_setup
    16                              <1> ;    9447  CALL autodet (Step 3)              -> CALL autodet_sw
    17                              <1> ;    8F9B  XOR DX,DX / XOR AX,AX / INT 13h / CALL 9005 (A:) -> CALL boot_seq
    18                              <1> ;
    19                              <1> ;  New settings: CMOS 3Eh, check byte 3Fh = 3Eh XOR A5h (else defaults):
    20                              <1> ;    bits 1-0 boot order (0 A: C:, 1 C: A:, 2 C: only), bit 2 auto-detect
    21                              <1> ;    off, bits 6-4 colour scheme.
    22                              <1> ; =====================================================================
    23                              <1> 
    24                              <1> A_CMOSWR   equ 0xEEAE     ; AL = index, AH = value
    25                              <1> A_SAVE     equ 0xC0A0     ; AMI's save: CMOS from [BP+10h..], checksum, restart
    26                              <1> A_EXIT     equ 0xBD4D     ; AMI's menu exit: cursor, stack frame, RET to POST
    27                              <1> A_UNHOOK   equ 0xD0CF     ; AMI's setup hooks of INT 10h/1Ah/1Ch off (its calendar clock)
    28                              <1> A_READ1    equ 0x9005     ; INT 19h: read sector 1 of DL, head DH, 4 tries (CX = 0: failed)
    29                              <1> A_BOOTGO   equ 0x8FEE     ; INT 19h: jump to 0:7C00
    30                              <1> A_INT19    equ 0x8F80     ; INT 19h from the start
    31                              <1> A_CRLF     equ 0x8D83
    32                              <1> A_PUTS     equ 0x8D75     ; CS:SI teletype
    33                              <1> CM_BUB     equ 0x3E
    34                              <1> CM_CHK     equ 0x3F
    35                              <1> BUB_KEY    equ 0xA5
    36                              <1> 
    37                              <1> ; setup state in AMI's frame (BP; [BP+10h..3Fh] is the CMOS buffer)
    38                              <1> F_TAB      equ 0
    39                              <1> F_FLD      equ 1          ; selected field (index into the table, 0FFh: none)
    40                              <1> F_EDIT     equ 2          ; digits typed so far (0: not typing)
    41                              <1> F_SEC      equ 3          ; RTC second last shown
    42                              <1> F_DIG      equ 4          ; 4..0Dh: the typed digits
    43                              <1> F_MSG      equ 0x0E       ; word: message for the help rows (0: the field's help)
    44                              <1> 
    45                              <1> NTABS      equ 6
    46                              <1> T_CHOICE   equ 1
    47                              <1> T_NUM      equ 2
    48                              <1> T_DATE     equ 3
    49                              <1> T_TIME     equ 4
    50                              <1> T_ACT      equ 5
    51                              <1> T_HDT      equ 6
    52                              <1> T_EMS      equ 7
    53                              <1> F_PARAMC   equ 0x80       ; type flag: a C: type-47 parameter (editable only with type 47)
    54                              <1> F_PARAMD   equ 0x40       ; type flag: a D: type-47 parameter
    55                              <1> F_MIN1     equ 0x20       ; type flag: the number is at least 1
    56                              <1> 
    57                              <1> R_TABS     equ 1
    58                              <1> R_TOP      equ 3
    59                              <1> R_LINE2    equ 21
    60                              <1> R_HELP     equ 22
    61                              <1> R_KEYS     equ 24
    62                              <1> C_SLBL     equ 3
    63                              <1> C_SVAL     equ 28
