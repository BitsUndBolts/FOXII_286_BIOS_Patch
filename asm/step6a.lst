   488                              <1> %ifdef ROUND6B
   489                              <1> ; ---------------------------------------------------------------------
   490                              <1> ; The one-time boot key: A or C during POST boots that drive first, this
   491                              <1> ; time only; CMOS is not changed. Seen like DEL: in the memory test
   492                              <1> ; (kbd_poll, port 60h), from checkpoint 73h in the keyboard buffer
   493                              <1> ; (bu_tick, and del_7f before AMI empties it at 7Fh), and from 7Fh to
   494                              <1> ; INT 19h by boot_seq (setup.asm, bk_order). A key: "Booting: A: (this
   495                              <1> ; time)" on the status bar. 40:FF holds it until INT 19h takes it.
   496                              <1> ; ---------------------------------------------------------------------
   497                              <1> ; bk_seen: AL = scan code (1Eh A, 2Eh C, else nothing). All registers
   498                              <1> ; kept. As del_seen: in protected mode (AMI's memory test) only the note.
   499                              <1> bk_seen:
   500                              <1>     cmp  al, 0x1E
   501                              <1>     je   .k
   502                              <1>     cmp  al, 0x2E
   503                              <1>     je   .k
   504                              <1>     ret
   505                              <1> .k: pusha
   506                              <1>     push ds
   507                              <1>     push es
   508                              <1>     smsw bx
   509                              <1>     test bl, 1
   510                              <1>     jz   .real
   511                              <1>     push 0x18                      ; AMI's selector of the BDA
   512                              <1>     pop  ds
   513                              <1>     cmp  byte [ST_FLAG], FLAG_UP
   514                              <1>     jne  .out
   515                              <1>     mov  [ST_BOOTK], al
   516                              <1>     jmp  short .out
   517                              <1> .real:
   518                              <1>     push 0x40
   519                              <1>     pop  ds
   520                              <1>     cld
   521                              <1>     cmp  byte [ST_FLAG], FLAG_UP
   522                              <1>     jne  .out
   523                              <1>     cmp  [ST_BOOTK], al
   524                              <1>     je   .out
   525                              <1>     mov  [ST_BOOTK], al
   526                              <1>     test byte [ST_MISC], M_DEL     ; DEL wins: the status stays "Entering Setup"
   527                              <1>     jnz  .out
   528                              <1>     mov  si, [ST_STAT]
   529                              <1>     call bk_stat
   530                              <1>     mov  [ST_STAT], si
   531                              <1>     mov  ax, 0xB800
   532                              <1>     cmp  byte [0x49], 7
   533                              <1>     jne  .v
   534                              <1>     mov  ah, 0xB0
   535                              <1> .v: mov  es, ax
   536                              <1>     call draw_status
   537                              <1> .out:
   538                              <1>     pop  es
   539                              <1>     pop  ds
   540                              <1>     popa
