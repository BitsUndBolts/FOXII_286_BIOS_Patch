   374 0000019C BE1E00              <1>     mov  si, 0x1E
   375 0000019F EBE8                <1>     jmp  short .l
   376                              <1> .del:
   377 000001A1 E881FF              <1>     call del_seen
   378 000001A4 1F                  <1> .r: pop  ds
   379 000001A5 5E                  <1>     pop  si
   380 000001A6 58                  <1>     pop  ax
   381 000001A7 CF                  <1>     iret
