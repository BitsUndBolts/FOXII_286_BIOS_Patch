   634                              <1> ; =====================================================================
   635                              <1> ; bu_f1wait -- 9754 (checkpoint 85h), in place of AMI's wait for F1 after
   636                              <1> ; "Press <F1> to RESUME" (MOV AH,0 / INT 16h / CMP AH,3Bh / JNE 9754).
   637                              <1> ; 0.7.3:
   638                              <1> ;  - DEL seen during POST: AMI's DEL check at checkpoint 7Fh (956F, 9606)
   639                              <1> ;    put 5555h into 40:69 = setup at 978B. No wait: setup follows at once.
   640                              <1> ;  - else ", <DEL> to run SETUP" after AMI's line (its teletype, the row
   641                              <1> ;    keeps the error colour), status "F1: Continue   DEL: Setup", and the
   642                              <1> ;    wait takes F1 (POST goes on, as AMI) or DEL (40:69 OR 5555h, as AMI's
   643                              <1> ;    DEL check, "Entering Setup ...", POST goes on into setup).
   644                              <1> ; AMI's errors that say "RUN SETUP UTILITY" OR AAAAh into 40:69 (970F):
   645                              <1> ; F1 then enters setup as before. DS = 40h. AX changed, as AMI's loop.
   646                              <1> ; =====================================================================
   647                              <1> bu_f1wait:
   648 00000355 F70669005555        <1>     test word [0x69], 0x5555       ; DEL already seen: setup without F1
   649 0000035B 7537                <1>     jnz  .r
   650 0000035D 56                  <1>     push si
   651 0000035E BE[B011]            <1>     mov  si, s_f1del
   652 00000361 E8(758D)            <1>     call A_PUTS
   653 00000364 5E                  <1>     pop  si
   654 00000365 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   655 0000036A 7511                <1>     jne  .k
   656 0000036C 60                  <1>     pusha
   657 0000036D 06                  <1>     push es
   658 0000036E FC                  <1>     cld
   659 0000036F C706FC00[9611]      <1>     mov  word [ST_STAT], s_st_f1
