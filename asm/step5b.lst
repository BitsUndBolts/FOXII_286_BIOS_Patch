   285                              <1> ; =====================================================================
   286                              <1> ; bu_refresh -- 9791 (checkpoint 85h): AMI set the video mode again (=
   287                              <1> ; cleared the screen) before its configuration box. Redraw only if the
   288                              <1> ; screen is no longer ours: after setup, or when errors scrolled it.
   289                              <1> ; =====================================================================
   290                              <1> bu_refresh:
   291 00000131 60                  <1>     pusha
   292 00000132 1E                  <1>     push ds
   293 00000133 06                  <1>     push es
   294 00000134 6A40                <1>     push 0x40
   295 00000136 1F                  <1>     pop  ds
   296 00000137 FC                  <1>     cld
   297 00000138 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   298 0000013D 7503                <1>     jne  .out
   299 0000013F E80400              <1>     call redraw_if_gone
