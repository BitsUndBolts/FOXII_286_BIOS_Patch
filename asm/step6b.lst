   667 00000384 740E                <1>     je   .r
   668 00000386 80FC53              <1>     cmp  ah, 0x53                  ; DEL
   669 00000389 75F2                <1>     jne  .k
   670 0000038B 810E69005555        <1>     or   word [0x69], 0x5555
   671 00000391 E8ADFD              <1>     call del_seen                  ; "Entering Setup ..." (real mode)
   672 00000394 C3                  <1> .r: ret
   673                              <1> %endif
