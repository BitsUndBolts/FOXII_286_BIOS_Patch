  2309                              <1> post_end:
    18                                  %include "setup.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  Round 6a: the setup of BUBios/286, the boot order and the
     3                              <1> ;  auto-detect switch
     4                              <1> ;
     5                              <1> ;  AMI's setup code still prepares and saves (docs/DEVELOPMENT_LOG.md,
     6                              <1> ;  round 6a): BCA6 builds the stack frame and reads CMOS 10h-3Fh into
     7                              <1> ;  [BP+10h..3Fh]; AMI's page code (BD61-C006) normalises that buffer; at
     8                              <1> ;  C009, where AMI's editing loop began, bu_setup takes over. Every option
     9                              <1> ;  edits AMI's buffer with AMI's encodings. Save: JMP C0A0 (AMI writes
    10                              <1> ;  CMOS 10h-3Fh, the checksum, clears 0Eh/0Fh and restarts). Exit without
    11                              <1> ;  saving: JMP BD4D (AMI's menu exit back to POST).
    12                              <1> ;
    13                              <1> ;  py/build.py patches:
    14                              <1> ;    BCFC  MOV AL,CS:[E058] (the menu)        -> JMP BD61 (the page)
    15                              <1> ;    C009  MOV BX,CA53 / JMP C011             -> JMP bu_setup
    16                              <1> ;    9447  CALL autodet (Step 3)              -> CALL autodet_sw
    17                              <1> ;    8F9B  XOR DX,DX / XOR AX,AX / INT 13h / CALL 9005 (A:) -> CALL boot_seq
    18                              <1> ;
    19                              <1> ;  New settings: CMOS 3Eh, check byte 3Fh = 3Eh XOR A5h (else defaults):
    20                              <1> ;    bits 1-0 boot order (0 A: C:, 1 C: A:, 2 C: only), bit 2 auto-detect
    21                              <1> ;    off, bits 6-4 colour scheme.
    22                              <1> ; =====================================================================
    23                              <1> 
    24                              <1> A_CMOSWR   equ 0xEEAE     ; AL = index, AH = value
    25                              <1> A_SAVE     equ 0xC0A0     ; AMI's save: CMOS from [BP+10h..], checksum, restart
    26                              <1> A_EXIT     equ 0xBD4D     ; AMI's menu exit: cursor, stack frame, RET to POST
    27                              <1> A_UNHOOK   equ 0xD0CF     ; AMI's setup hooks of INT 10h/1Ah/1Ch off (its calendar clock)
    28                              <1> A_READ1    equ 0x9005     ; INT 19h: read sector 1 of DL, head DH, 4 tries (CX = 0: failed)
    29                              <1> A_BOOTGO   equ 0x8FEE     ; INT 19h: jump to 0:7C00
    30                              <1> A_INT19    equ 0x8F80     ; INT 19h from the start
    31                              <1> A_CRLF     equ 0x8D83
    32                              <1> A_PUTS     equ 0x8D75     ; CS:SI teletype
    33                              <1> CM_BUB     equ 0x3E
    34                              <1> CM_CHK     equ 0x3F
    35                              <1> BUB_KEY    equ 0xA5
    36                              <1> 
    37                              <1> ; setup state in AMI's frame (BP; [BP+10h..3Fh] is the CMOS buffer)
    38                              <1> F_TAB      equ 0
    39                              <1> F_FLD      equ 1          ; selected field (index into the table, 0FFh: none)
    40                              <1> F_EDIT     equ 2          ; digits typed so far (0: not typing)
    41                              <1> F_SEC      equ 3          ; RTC second last shown
    42                              <1> F_DIG      equ 4          ; 4..0Dh: the typed digits
    43                              <1> F_MSG      equ 0x0E       ; word: message for the help rows (0: the field's help)
    44                              <1> 
    45                              <1> NTABS      equ 6
    46                              <1> T_CHOICE   equ 1
    47                              <1> T_NUM      equ 2
    48                              <1> T_DATE     equ 3
    49                              <1> T_TIME     equ 4
    50                              <1> T_ACT      equ 5
    51                              <1> T_HDT      equ 6
    52                              <1> T_EMS      equ 7
    53                              <1> F_PARAMC   equ 0x80       ; type flag: a C: type-47 parameter (editable only with type 47)
    54                              <1> F_PARAMD   equ 0x40       ; type flag: a D: type-47 parameter
    55                              <1> F_MIN1     equ 0x20       ; type flag: the number is at least 1
    56                              <1> 
    57                              <1> R_TABS     equ 1
    58                              <1> R_TOP      equ 3
    59                              <1> R_LINE2    equ 21
    60                              <1> R_HELP     equ 22
    61                              <1> R_KEYS     equ 24
    62                              <1> C_SLBL     equ 3
    63                              <1> C_SVAL     equ 28
    64                              <1> 
    65                              <1> ; ---------------------------------------------------------------------
    66                              <1> ; bub_cfg -> AL = the BUBios settings byte (CMOS 3Eh), 0 if its check
    67                              <1> ; byte (3Fh) does not match. Other registers kept.
    68                              <1> ; ---------------------------------------------------------------------
    69                              <1> bub_cfg:
    70 00001066 53                  <1>     push bx
    71 00001067 B03F                <1>     mov  al, CM_CHK
    72 00001069 E8(9FEE)            <1>     call A_CMOSRD
    73 0000106C 88C3                <1>     mov  bl, al
    74 0000106E B03E                <1>     mov  al, CM_BUB
    75 00001070 E8(9FEE)            <1>     call A_CMOSRD
    76 00001073 80F3A5              <1>     xor  bl, BUB_KEY
    77 00001076 38D8                <1>     cmp  al, bl
    78 00001078 7402                <1>     je   .ok
    79 0000107A 30C0                <1>     xor  al, al
    80 0000107C 5B                  <1> .ok:pop  bx
    81 0000107D C3                  <1>     ret
    82                              <1> 
    83                              <1> ; ---------------------------------------------------------------------
    84                              <1> ; autodet_sw -- 9447 (checkpoint 75h), in place of Step 3's CALL autodet:
    85                              <1> ; "Auto-Detect Disks at Boot" On -> autodet (0.7.3: autodet_all), Off ->
    86                              <1> ; drives12 (no IDENTIFY, but a configured drive that does not answer is
    87                              <1> ; still left out).
    88                              <1> ; Keeps every register except AL, as both of Step 3's entries do.
    89                              <1> ; ---------------------------------------------------------------------
    90                              <1> autodet_sw:
    91 0000107E 50                  <1>     push ax
    92 0000107F E8E4FF              <1>     call bub_cfg
    93 00001082 A804                <1>     test al, 4
    94 00001084 58                  <1>     pop  ax
    95 00001085 7506                <1>     jnz  .off
    96                              <1> %ifdef ROUND6B
    97                              <1>     call autodet_all               ; 0.7.3: every drive, as BUBios (SOYO)
    98                              <1> %else
    99 00001087 E8(0000)            <1>     call autodet                   ; AL = CMOS 12h, the only result 944C uses
   100                              <1> %endif
   101 0000108A E9B2F1              <1>     jmp  adet_drawn                ; the POST screen's disk rows at once
   102                              <1> .off:
   103 0000108D E9(2800)            <1>     jmp  drives12
   104                              <1> 
   105                              <1> %ifdef ROUND6B
   106                              <1> ; ---------------------------------------------------------------------
   107                              <1> ; autodet_all -- 0.7.3, Auto-Detect On: IDENTIFY DEVICE to C: and D:,
   108                              <1> ; whatever CMOS says (Step 3's autodet asks only drives set to "Not
   109                              <1> ; installed"). A drive that answers with a valid geometry is written as
   110                              <1> ; type 47 with it (Step 3's set47, checksum included), unless CMOS already
   111                              <1> ; holds type 47 with exactly that cylinders/heads/sectors: then nothing
   112                              <1> ; is written. As BUBios's auto_set on the SOYO. A drive that does not
   113                              <1> ; answer, or answers but fails IDENTIFY (ATAPI, a geometry out of range),
   114                              <1> ; keeps its CMOS entry. Then drives12, as autodet: AL = CMOS 12h without
   115                              <1> ; the drives that are gone. Keeps every register except AL.
   116                              <1> ; ---------------------------------------------------------------------
   117                              <1> autodet_all:
   118                              <1>     sti                            ; (already on: the tick counter must run)
   119                              <1>     pusha
   120                              <1>     push ds
   121                              <1>     push 0x40
   122                              <1>     pop  ds
   123                              <1>     xor  bx, bx                    ; BL = 0: C:, then 1: D:
   124                              <1> .drive:
   125                              <1>     call identify                  ; CF = 0: CX/DL/DH (BH changed, BL kept)
   126                              <1>     jc   .next
   127                              <1>     call same47
   128                              <1>     je   .next                     ; CMOS already says so: no write
   129                              <1>     call set47
   130                              <1> .next:
   131                              <1>     inc  bl
   132                              <1>     cmp  bl, 2
   133                              <1>     jb   .drive
   134                              <1>     pop  ds
   135                              <1>     popa
   136                              <1>     jmp  drives12
   137                              <1> 
   138                              <1> ; same47 -- BL = drive, CX/DL/DH = cylinders/heads/sectors: ZF = 1 if CMOS
   139                              <1> ; holds type 47 for that drive with exactly this geometry. AX changed.
   140                              <1> same47:
   141                              <1>     mov  al, 0x12
   142                              <1>     call CMOS_RD
   143                              <1>     or   bl, bl
   144                              <1>     jnz  .lo
   145                              <1>     shr  al, 4
   146                              <1> .lo:and  al, 0x0F
   147                              <1>     cmp  al, 0x0F                  ; the extended type byte is used
   148                              <1>     jne  .r
   149                              <1>     mov  al, 0x19
   150                              <1>     add  al, bl
   151                              <1>     call CMOS_RD
   152                              <1>     cmp  al, 47
   153                              <1>     jne  .r
   154                              <1>     mov  ah, 0x1B                  ; C: 1Bh-23h, D: 24h-2Ch
   155                              <1>     or   bl, bl
   156                              <1>     jz   .p
   157                              <1>     mov  ah, 0x24
   158                              <1> .p: mov  al, ah
   159                              <1>     call CMOS_RD                   ; +0/+1 cylinders
   160                              <1>     cmp  al, cl
   161                              <1>     jne  .r
   162                              <1>     mov  al, ah
   163                              <1>     inc  al
   164                              <1>     call CMOS_RD
   165                              <1>     cmp  al, ch
   166                              <1>     jne  .r
   167                              <1>     mov  al, ah
   168                              <1>     add  al, 2
   169                              <1>     call CMOS_RD                   ; +2 heads
   170                              <1>     cmp  al, dl
   171                              <1>     jne  .r
   172                              <1>     mov  al, ah
   173                              <1>     add  al, 8
   174                              <1>     call CMOS_RD                   ; +8 sectors
   175                              <1>     cmp  al, dh
   176                              <1> .r: ret
   177                              <1> %endif
   178                              <1> 
   179                              <1> ; ---------------------------------------------------------------------
   180                              <1> ; boot_seq -- 8F9B (INT 19h, ES = 0, BX = 7C00h), in place of the A:
   181                              <1> ; attempt (XOR DX,DX / XOR AX,AX / INT 13h / CALL 9005). Returns to
   182                              <1> ; 8F9E (NOPs, then 8FA4: AMI's A: result) like the CALL 9005 it ends with.
   183                              <1> ; ---------------------------------------------------------------------
   184                              <1> boot_seq:
   185                              <1> %ifdef ROUND6B
   186                              <1>     call bk_order                  ; the order, or the boot key's drive
   187                              <1> %else
   188 00001090 E8D3FF              <1>     call bub_cfg
   189 00001093 2403                <1>     and  al, 3
   190                              <1> %endif
   191 00001095 7429                <1>     jz   .a                        ; A: then C: (AMI's own order)
   192 00001097 50                  <1>     push ax
   193 00001098 B00E                <1>     mov  al, 0x0E                  ; as AMI's C: path (8FB1): no C: when the
   194 0000109A E8(9FEE)            <1>     call A_CMOSRD                  ; fixed-disk setup failed in POST
   195 0000109D A808                <1>     test al, 8
   196 0000109F 751A                <1>     jnz  .cno
   197 000010A1 BA8000              <1>     mov  dx, 0x0080                ; C:, head 0
   198 000010A4 E8(0590)            <1>     call A_READ1
   199 000010A7 E312                <1>     jcxz .cno
   200 000010A9 7210                <1>     jc   .cno
   201 000010AB 2681BFFE0155AA      <1>     cmp  word [es:bx + 0x1FE], 0xAA55
   202 000010B2 7507                <1>     jne  .cno
   203 000010B4 58                  <1>     pop  ax
   204 000010B5 83C402              <1>     add  sp, 2                     ; (our return address)
   205 000010B8 E9(EE8F)            <1>     jmp  A_BOOTGO                  ; DL = 80h
   206                              <1> .cno:
   207 000010BB 58                  <1>     pop  ax
   208 000010BC 3C02                <1>     cmp  al, 2
   209 000010BE 7409                <1>     je   .conly
   210 000010C0 31D2                <1> .a: xor  dx, dx                    ; A:, as the original
   211 000010C2 31C0                <1>     xor  ax, ax
   212 000010C4 CD13                <1>     int  0x13
   213 000010C6 E9(0590)            <1>     jmp  A_READ1
   214                              <1> .conly:                            ; C: only and C: did not boot: say so,
   215 000010C9 83C402              <1>     add  sp, 2                     ; wait for a key, INT 19h again
   216 000010CC FB                  <1>     sti
   217 000010CD E8(838D)            <1>     call A_CRLF
   218 000010D0 BE[E910]            <1>     mov  si, s_conly
   219 000010D3 E8(758D)            <1>     call A_PUTS
   220 000010D6 E8(838D)            <1>     call A_CRLF
   221 000010D9 BE[2111]            <1>     mov  si, s_anykey
   222 000010DC E8(758D)            <1>     call A_PUTS
   223 000010DF 30E4                <1>     xor  ah, ah
   224 000010E1 CD16                <1>     int  0x16
   225 000010E3 E8(838D)            <1>     call A_CRLF
   226 000010E6 E9(808F)            <1>     jmp  A_INT19
   227                              <1> 
   228                              <1> %ifdef ROUND6B
   229                              <1> ; bk_order -> AL = the boot order for this boot (0 A: C:, 1 C: A:, 2 C:
   230                              <1> ; only), ZF = 1 for 0: setup's, or for a boot key A: 0, C: 1. The key is
   231                              <1> ; taken from 40:FF (noted during POST) or the keyboard buffer (typed from
   232                              <1> ; checkpoint 7Fh on; the buffer is emptied then, so DOS does not get it),
   233                              <1> ; and 40:FF cleared. Other registers kept.
   234                              <1> bk_order:
   235                              <1>     push si
   236                              <1>     push ds
   237                              <1>     push 0x40
   238                              <1>     pop  ds
   239                              <1>     mov  al, [ST_BOOTK]
   240                              <1>     mov  byte [ST_BOOTK], 0
   241                              <1>     mov  si, [0x1A]
   242                              <1> .l: cmp  si, [0x1C]
   243                              <1>     je   .e
   244                              <1>     cmp  byte [si + 1], 0x1E
   245                              <1>     je   .f
   246                              <1>     cmp  byte [si + 1], 0x2E
   247                              <1>     je   .f
   248                              <1>     inc  si
   249                              <1>     inc  si
   250                              <1>     cmp  si, 0x3E
   251                              <1>     jb   .l
   252                              <1>     mov  si, 0x1E
   253                              <1>     jmp  short .l
   254                              <1> .f: mov  al, [si + 1]
   255                              <1>     cli
   256                              <1>     mov  si, [0x1C]                ; the buffer emptied
   257                              <1>     mov  [0x1A], si
   258                              <1>     sti
   259                              <1> .e: pop  ds
   260                              <1>     pop  si
   261                              <1>     cmp  al, 0x1E
   262                              <1>     je   .a
   263                              <1>     cmp  al, 0x2E
   264                              <1>     je   .c
   265                              <1>     call bub_cfg
   266                              <1>     and  al, 3
   267                              <1>     ret
   268                              <1> .a: xor  al, al                    ; (ZF = 1)
   269                              <1>     ret
   270                              <1> .c: mov  al, 1
   271                              <1>     or   al, al                    ; (ZF = 0)
   272                              <1>     ret
   273                              <1> %endif
   274                              <1> 
   275 000010E9 20204E6F20626F6F74- <1> s_conly:    db "  No boot sector on C: (boot order: C: only, see Setup)", 0
   275 000010F2 20736563746F72206F- <1>
   275 000010FB 6E20433A2028626F6F- <1>
   275 00001104 74206F726465723A20- <1>
   275 0000110D 433A206F6E6C792C20- <1>
   275 00001116 736565205365747570- <1>
   275 0000111F 2900                <1>
   276 00001121 202050726573732061- <1> s_anykey:   db "  Press any key to try again ", 0
