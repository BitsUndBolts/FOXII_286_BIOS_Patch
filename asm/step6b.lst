  2243                              <1> post_end:
    20                                  %include "setup.asm"
     1                              <1> ; =====================================================================
     2                              <1> ;  Round 6a: the setup of BUBios/286, the boot order and the
     3                              <1> ;  auto-detect switch
     4                              <1> ;
     5                              <1> ;  AMI's setup code still prepares and saves (docs/DEVELOPMENT_LOG.md,
     6                              <1> ;  round 6a): BCA6 builds the stack frame and reads CMOS 10h-3Fh into
     7                              <1> ;  [BP+10h..3Fh]; AMI's page code (BD61-C006) normalises that buffer; at
     8                              <1> ;  C009, where AMI's editing loop began, bu_setup takes over. Every option
     9                              <1> ;  edits AMI's buffer with AMI's encodings. Save: JMP C0A0 (AMI writes
    10                              <1> ;  CMOS 10h-3Fh, the checksum, clears 0Eh/0Fh and restarts). Exit without
    11                              <1> ;  saving: JMP BD4D (AMI's menu exit back to POST).
    12                              <1> ;
    13                              <1> ;  py/build.py patches:
    14                              <1> ;    BCFC  MOV AL,CS:[E058] (the menu)        -> JMP BD61 (the page)
    15                              <1> ;    C009  MOV BX,CA53 / JMP C011             -> JMP bu_setup
    16                              <1> ;    9447  CALL autodet (Step 3)              -> CALL autodet_sw
    17                              <1> ;    8F9B  XOR DX,DX / XOR AX,AX / INT 13h / CALL 9005 (A:) -> CALL boot_seq
    18                              <1> ;
    19                              <1> ;  New settings: CMOS 3Eh, check byte 3Fh = 3Eh XOR A5h (else defaults):
    20                              <1> ;    bits 1-0 boot order (0 A: C:, 1 C: A:, 2 C: only), bit 2 auto-detect
    21                              <1> ;    off, bits 6-4 colour scheme.
    22                              <1> ; =====================================================================
    23                              <1> 
    24                              <1> A_CMOSWR   equ 0xEEAE     ; AL = index, AH = value
    25                              <1> A_SAVE     equ 0xC0A0     ; AMI's save: CMOS from [BP+10h..], checksum, restart
    26                              <1> A_EXIT     equ 0xBD4D     ; AMI's menu exit: cursor, stack frame, RET to POST
    27                              <1> A_UNHOOK   equ 0xD0CF     ; AMI's setup hooks of INT 10h/1Ah/1Ch off (its calendar clock)
    28                              <1> A_READ1    equ 0x9005     ; INT 19h: read sector 1 of DL, head DH, 4 tries (CX = 0: failed)
    29                              <1> A_BOOTGO   equ 0x8FEE     ; INT 19h: jump to 0:7C00
    30                              <1> A_INT19    equ 0x8F80     ; INT 19h from the start
    31                              <1> A_CRLF     equ 0x8D83
    32                              <1> A_PUTS     equ 0x8D75     ; CS:SI teletype
    33                              <1> CM_BUB     equ 0x3E
    34                              <1> CM_CHK     equ 0x3F
    35                              <1> BUB_KEY    equ 0xA5
    36                              <1> 
    37                              <1> ; setup state in AMI's frame (BP; [BP+10h..3Fh] is the CMOS buffer)
    38                              <1> F_TAB      equ 0
    39                              <1> F_FLD      equ 1          ; selected field (index into the table, 0FFh: none)
    40                              <1> F_EDIT     equ 2          ; digits typed so far (0: not typing)
    41                              <1> F_SEC      equ 3          ; RTC second last shown
    42                              <1> F_DIG      equ 4          ; 4..0Dh: the typed digits
    43                              <1> F_MSG      equ 0x0E       ; word: message for the help rows (0: the field's help)
    44                              <1> 
    45                              <1> NTABS      equ 6
    46                              <1> T_CHOICE   equ 1
    47                              <1> T_NUM      equ 2
    48                              <1> T_DATE     equ 3
    49                              <1> T_TIME     equ 4
    50                              <1> T_ACT      equ 5
    51                              <1> T_HDT      equ 6
    52                              <1> T_EMS      equ 7
    53                              <1> F_PARAMC   equ 0x80       ; type flag: a C: type-47 parameter (editable only with type 47)
    54                              <1> F_PARAMD   equ 0x40       ; type flag: a D: type-47 parameter
    55                              <1> F_MIN1     equ 0x20       ; type flag: the number is at least 1
    56                              <1> 
    57                              <1> R_TABS     equ 1
    58                              <1> R_TOP      equ 3
    59                              <1> R_LINE2    equ 21
    60                              <1> R_HELP     equ 22
    61                              <1> R_KEYS     equ 24
    62                              <1> C_SLBL     equ 3
    63                              <1> C_SVAL     equ 28
    64                              <1> 
    65                              <1> ; ---------------------------------------------------------------------
    66                              <1> ; bub_cfg -> AL = the BUBios settings byte (CMOS 3Eh), 0 if its check
    67                              <1> ; byte (3Fh) does not match. Other registers kept.
    68                              <1> ; ---------------------------------------------------------------------
    69                              <1> bub_cfg:
    70 00001200 53                  <1>     push bx
    71 00001201 B03F                <1>     mov  al, CM_CHK
    72 00001203 E8(9FEE)            <1>     call A_CMOSRD
    73 00001206 88C3                <1>     mov  bl, al
    74 00001208 B03E                <1>     mov  al, CM_BUB
    75 0000120A E8(9FEE)            <1>     call A_CMOSRD
    76 0000120D 80F3A5              <1>     xor  bl, BUB_KEY
    77 00001210 38D8                <1>     cmp  al, bl
    78 00001212 7402                <1>     je   .ok
    79 00001214 30C0                <1>     xor  al, al
    80 00001216 5B                  <1> .ok:pop  bx
    81 00001217 C3                  <1>     ret
    82                              <1> 
    83                              <1> ; ---------------------------------------------------------------------
    84                              <1> ; autodet_sw -- 9447 (checkpoint 75h), in place of Step 3's CALL autodet:
    85                              <1> ; "Auto-Detect Disks at Boot" On -> autodet, Off -> drives12 (no IDENTIFY,
    86                              <1> ; but a configured drive that does not answer is still left out).
    87                              <1> ; Keeps every register except AL, as both of Step 3's entries do.
    88                              <1> ; ---------------------------------------------------------------------
    89                              <1> autodet_sw:
    90 00001218 50                  <1>     push ax
    91 00001219 E8E4FF              <1>     call bub_cfg
    92 0000121C A804                <1>     test al, 4
    93 0000121E 58                  <1>     pop  ax
    94 0000121F 7506                <1>     jnz  .off
    95 00001221 E8(0000)            <1>     call autodet                   ; AL = CMOS 12h, the only result 944C uses
    96 00001224 E9BDF0              <1>     jmp  adet_drawn                ; the POST screen's disk rows at once
    97                              <1> .off:
    98 00001227 E9(2800)            <1>     jmp  drives12
    99                              <1> 
   100                              <1> ; ---------------------------------------------------------------------
   101                              <1> ; boot_seq -- 8F9B (INT 19h, ES = 0, BX = 7C00h), in place of the A:
   102                              <1> ; attempt (XOR DX,DX / XOR AX,AX / INT 13h / CALL 9005). Returns to
   103                              <1> ; 8F9E (NOPs, then 8FA4: AMI's A: result) like the CALL 9005 it ends with.
   104                              <1> ; ---------------------------------------------------------------------
   105                              <1> boot_seq:
   106                              <1> %ifdef ROUND6B
   107 0000122A E85400              <1>     call bk_order                  ; the order, or the boot key's drive
   108                              <1> %else
   109                              <1>     call bub_cfg
   110                              <1>     and  al, 3
   111                              <1> %endif
   112 0000122D 7429                <1>     jz   .a                        ; A: then C: (AMI's own order)
   113 0000122F 50                  <1>     push ax
   114 00001230 B00E                <1>     mov  al, 0x0E                  ; as AMI's C: path (8FB1): no C: when the
   115 00001232 E8(9FEE)            <1>     call A_CMOSRD                  ; fixed-disk setup failed in POST
   116 00001235 A808                <1>     test al, 8
   117 00001237 751A                <1>     jnz  .cno
   118 00001239 BA8000              <1>     mov  dx, 0x0080                ; C:, head 0
   119 0000123C E8(0590)            <1>     call A_READ1
   120 0000123F E312                <1>     jcxz .cno
   121 00001241 7210                <1>     jc   .cno
   122 00001243 2681BFFE0155AA      <1>     cmp  word [es:bx + 0x1FE], 0xAA55
   123 0000124A 7507                <1>     jne  .cno
   124 0000124C 58                  <1>     pop  ax
   125 0000124D 83C402              <1>     add  sp, 2                     ; (our return address)
   126 00001250 E9(EE8F)            <1>     jmp  A_BOOTGO                  ; DL = 80h
   127                              <1> .cno:
   128 00001253 58                  <1>     pop  ax
   129 00001254 3C02                <1>     cmp  al, 2
   130 00001256 7409                <1>     je   .conly
   131 00001258 31D2                <1> .a: xor  dx, dx                    ; A:, as the original
   132 0000125A 31C0                <1>     xor  ax, ax
   133 0000125C CD13                <1>     int  0x13
   134 0000125E E9(0590)            <1>     jmp  A_READ1
   135                              <1> .conly:                            ; C: only and C: did not boot: say so,
   136 00001261 83C402              <1>     add  sp, 2                     ; wait for a key, INT 19h again
   137 00001264 FB                  <1>     sti
   138 00001265 E8(838D)            <1>     call A_CRLF
   139 00001268 BE[D512]            <1>     mov  si, s_conly
   140 0000126B E8(758D)            <1>     call A_PUTS
   141 0000126E E8(838D)            <1>     call A_CRLF
   142 00001271 BE[0D13]            <1>     mov  si, s_anykey
   143 00001274 E8(758D)            <1>     call A_PUTS
   144 00001277 30E4                <1>     xor  ah, ah
   145 00001279 CD16                <1>     int  0x16
   146 0000127B E8(838D)            <1>     call A_CRLF
   147 0000127E E9(808F)            <1>     jmp  A_INT19
   148                              <1> 
   149                              <1> %ifdef ROUND6B
   150                              <1> ; bk_order -> AL = the boot order for this boot (0 A: C:, 1 C: A:, 2 C:
   151                              <1> ; only), ZF = 1 for 0: setup's, or for a boot key A: 0, C: 1. The key is
   152                              <1> ; taken from 40:FF (noted during POST) or the keyboard buffer (typed from
   153                              <1> ; checkpoint 7Fh on; the buffer is emptied then, so DOS does not get it),
   154                              <1> ; and 40:FF cleared. Other registers kept.
   155                              <1> bk_order:
   156 00001281 56                  <1>     push si
   157 00001282 1E                  <1>     push ds
   158 00001283 6A40                <1>     push 0x40
   159 00001285 1F                  <1>     pop  ds
   160 00001286 A0FF00              <1>     mov  al, [ST_BOOTK]
   161 00001289 C606FF0000          <1>     mov  byte [ST_BOOTK], 0
   162 0000128E 8B361A00            <1>     mov  si, [0x1A]
   163 00001292 3B361C00            <1> .l: cmp  si, [0x1C]
   164 00001296 7425                <1>     je   .e
   165 00001298 807C011E            <1>     cmp  byte [si + 1], 0x1E
   166 0000129C 7412                <1>     je   .f
   167 0000129E 807C012E            <1>     cmp  byte [si + 1], 0x2E
   168 000012A2 740C                <1>     je   .f
   169 000012A4 46                  <1>     inc  si
   170 000012A5 46                  <1>     inc  si
   171 000012A6 83FE3E              <1>     cmp  si, 0x3E
   172 000012A9 72E7                <1>     jb   .l
   173 000012AB BE1E00              <1>     mov  si, 0x1E
   174 000012AE EBE2                <1>     jmp  short .l
   175 000012B0 8A4401              <1> .f: mov  al, [si + 1]
   176 000012B3 FA                  <1>     cli
   177 000012B4 8B361C00            <1>     mov  si, [0x1C]                ; the buffer emptied
   178 000012B8 89361A00            <1>     mov  [0x1A], si
   179 000012BC FB                  <1>     sti
   180 000012BD 1F                  <1> .e: pop  ds
   181 000012BE 5E                  <1>     pop  si
   182 000012BF 3C1E                <1>     cmp  al, 0x1E
   183 000012C1 740A                <1>     je   .a
   184 000012C3 3C2E                <1>     cmp  al, 0x2E
   185 000012C5 7409                <1>     je   .c
   186 000012C7 E836FF              <1>     call bub_cfg
   187 000012CA 2403                <1>     and  al, 3
   188 000012CC C3                  <1>     ret
   189 000012CD 30C0                <1> .a: xor  al, al                    ; (ZF = 1)
   190 000012CF C3                  <1>     ret
   191 000012D0 B001                <1> .c: mov  al, 1
   192 000012D2 08C0                <1>     or   al, al                    ; (ZF = 0)
   193 000012D4 C3                  <1>     ret
   194                              <1> %endif
