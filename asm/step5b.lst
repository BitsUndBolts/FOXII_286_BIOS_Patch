  1142 0000077E B2F7                <1>     mov  dl, 0xF7
  1143 00000780 EC                  <1>     in   al, dx
  1144 00000781 BD0000              <1>     mov  bp, D_NONE
  1145 00000784 3CFF                <1>     cmp  al, 0xFF                  ; nothing on the bus
  1146 00000786 7503E9B500          <1>     je   .end
  1147 0000078B 3C7F                <1>     cmp  al, 0x7F
  1148 0000078D 7503E9AE00          <1>     je   .end
  1149 00000792 08C0                <1>     or   al, al                    ; a master answering for a missing slave
  1150 00000794 7503E9A700          <1>     jz   .end
