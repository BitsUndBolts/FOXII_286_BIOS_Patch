   505 0000026C 753C                <1>     jne  .out
   506 0000026E A2FF00              <1>     mov  [ST_BOOTK], al
   507 00000271 EB37                <1>     jmp  short .out
   508                              <1> .real:
   509 00000273 6A40                <1>     push 0x40
   510 00000275 1F                  <1>     pop  ds
   511 00000276 FC                  <1>     cld
   512 00000277 803EF000B2          <1>     cmp  byte [ST_FLAG], FLAG_UP
   513 0000027C 752C                <1>     jne  .out
   514 0000027E 3806FF00            <1>     cmp  [ST_BOOTK], al
   515 00000282 7426                <1>     je   .out
   516 00000284 A2FF00              <1>     mov  [ST_BOOTK], al
