   264 00001384 3C1A                <1>     cmp  al, 0x1A
   265 00001386 7513                <1>     jne  .mc
   266 00001388 BAC403              <1>     mov  dx, 0x3C4
   267 0000138B B001                <1>     mov  al, 1
